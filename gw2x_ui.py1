    def auto_connect_ui(self):
        if self.logic.connect():
            self.toggle_btn.config(fg="#00ff00")
            
            # --- UPDATE POINTER DINAMIS ---
            self.logic.pm = core.pm
            if hasattr(self, 'movement') and self.movement:
                self.movement.pm = core.pm
            if hasattr(self, 'fishing') and self.fishing:
                self.fishing.pm = core.pm
                
        else:
            self.toggle_btn.config(fg="#ff0000")
        self.root.after(2000, self.auto_connect_ui)

    def update_live_ui(self):
        pos = self.logic.read_live_coords()
        if pos:
            self.live_x.set(f"{pos[0]:.2f}")
            self.live_y.set(f"{pos[1]:.2f}")
            self.live_z.set(f"{pos[2]:.2f}")
        self.root.after(200, self.update_live_ui)
        
    def _safe_get_entry(self, e):
        try:
            if e and e.winfo_exists():
                return e.get()
        except Exception:
            pass
        return ""
        
    def _sync_tool_indicator(self, key):
        entry = self.windows.get(key)
        if not entry:
            return

        ind = entry.get("ind")
        win = entry.get("win")

        if ind and ind.winfo_exists():
            is_active = False
            
            # --- OVERRIDE LOGIC: Cek status fitur, bukan status window ---
            if key == "Clarity View":
                is_active = self.saved_inputs.get("vis_fog", 0) == 1
            elif key == "GW2X ESP":
                keys = ["esp_player", "esp_npc", "esp_path", "esp_health"]
                # Aktif (hijau) jika minimal ada 1 opsi ESP yang menyala
                is_active = any(self.saved_inputs.get(k, 0) == 1 for k in keys)
            else:
                # DEFAULT LOGIC: Cek apakah window sedang terbuka
                is_active = win and tk.Toplevel.winfo_exists(win)

            # Eksekusi visual update
            if is_active:
                ind.config(text="▶", fg="#00ff00")
            else:
                ind.config(text="⬜", fg="#444444")
                
    # ==========================================
    #  AUTO-HIDE / FOCUS WATCHDOG (PASTE THIS)
    # ==========================================
    def _set_ui_visibility(self, visible):
        """Hides or Shows UI windows, respecting the Collapsed state."""
        def toggle(win, condition=True):
            """
            win: The window to toggle
            condition: If False, we force hide the window even if 'visible' is True.
            """
            if not win or not win.winfo_exists(): return
            
            # If we want to SHOW (visible=True) AND the specific condition is met
            if visible and condition:
                if not win.winfo_viewable(): 
                    win.deiconify()
                    # Restore window attributes that get lost on hide
                    if self.always_on_top.get(): 
                        win.attributes("-topmost", True)
                    win.attributes("-alpha", self.transparency)
            
            # If we want to HIDE (visible=False) OR the condition fails
            else:
                if win.winfo_viewable(): win.withdraw()

        # 1. Main Window (Always show if game is active)
        toggle(self.root)

        # 2. Categories (This is the FIX)
        # Only show category windows if the menu is currently EXPANDED (self.expanded)
        for cat in self.categories.values():
            toggle(cat.get("win"), condition=self.expanded)

        # 3. Tool Windows (These stay visible regardless of collapse state)
        for entry in self.windows.values():
            toggle(entry.get("win"))

        # 4. Map/TPS Files
        for win in self.map_file_windows.values():
            toggle(win)

    def start_focus_watchdog(self):
        def loop():
            # Get the Process ID of this script to prevent self-hiding
            my_pid = os.getpid()
            last_visible = True
            
            while True:
                time.sleep(0.2) # Check 5 times a second
                
                # If dragging UI, skip logic to prevent glitch
                if getattr(self, "drag_data", {}).get("moved", False):
                    continue

                should_show = False
                
                # 1. Is GW2 Running?
                gw2_hwnd = win32gui.FindWindow(None, "Guild Wars 2")
                
                if gw2_hwnd:
                    # 2. What window is currently active?
                    fg_hwnd = win32gui.GetForegroundWindow()
                    
                    # Case A: Game is active -> SHOW
                    if fg_hwnd == gw2_hwnd:
                        should_show = True
                    
                    # Case B: The Script (UI) is active -> SHOW
                    else:
                        try:
                            _, fg_pid = win32process.GetWindowThreadProcessId(fg_hwnd)
                            if fg_pid == my_pid:
                                should_show = True
                        except:
                            pass
                
                # 3. Apply Visibility (Only if state changed)
                if should_show and not last_visible:
                    self.root.after(0, lambda: self._set_ui_visibility(True))
                    last_visible = True
                    
                elif not should_show and last_visible:
                    self.root.after(0, lambda: self._set_ui_visibility(False))
                    last_visible = False

        threading.Thread(target=loop, daemon=True).start()
    
