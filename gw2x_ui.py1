    def build_teleport_hub_ui(self, win):
        h = tk.Label(win, text="Main Teleporter", bg="#333333", fg="white", font=("Segoe UI", 10, "bold"), pady=6)
        h.pack(fill=tk.X)
        if not self.allow_resize.get():
            self.make_draggable(h, win, "Main Teleporter", is_group_move=False)

        c_btn = tk.Label(h, text="x", bg="#333333", fg="#888", font=("Arial", 12), cursor="hand2")
        c_btn.pack(side=tk.RIGHT, padx=10)
        c_btn.bind("<Button-1>", lambda e: self.close_tool_window(win, "Main Teleporter"))

        notebook = ttk.Notebook(win)
        notebook.pack(fill=tk.BOTH, expand=True, padx=2, pady=2)

        tab_main = tk.Frame(notebook, bg="#121212")
        # tab_custom & tab_maps REMOVED from here
        tab_auto = tk.Frame(notebook, bg="#121212")
        tab_global = tk.Frame(notebook, bg="#121212")

        notebook.add(tab_main, text='Main/Dir')
        # notebook.add(tab_custom, text='Saved') REMOVED
        # notebook.add(tab_maps, text="Maps") REMOVED
        notebook.add(tab_auto, text="Auto Teleport")
        notebook.add(tab_global, text='Global')

        # --- TAB MEMORY RESTORE ---
        last_tab_idx = self.saved_inputs.get("last_hub_tab_idx", 0)
        # Reduced range check since tabs are fewer
        if 0 <= last_tab_idx < 3:
            notebook.select(last_tab_idx)

        # --- TAB MEMORY SAVE ---
        def on_tab_change(event):
            try:
                idx = notebook.index(notebook.select())
                self.saved_inputs["last_hub_tab_idx"] = idx
            except: pass
        
        notebook.bind("<<NotebookTabChanged>>", on_tab_change)

        self._build_tab_main_teleport(tab_main)
        # self._build_tab_custom_teleport(tab_custom) REMOVED
        # self._build_tab_map_teleports(tab_maps) REMOVED
        self._build_tab_global_teleport(tab_global)
        self._build_tab_auto_teleport(tab_auto)
        
    def build_objects_teleport_ui(self, win):
        h = tk.Label(win, text="Object Teleporter", bg="#333333", fg="white", font=("Segoe UI", 10, "bold"), pady=6)
        h.pack(fill=tk.X)
        if not self.allow_resize.get():
            self.make_draggable(h, win, "Object Teleporter", is_group_move=False)

        c_btn = tk.Label(h, text="x", bg="#333333", fg="#888", font=("Arial", 12), cursor="hand2")
        c_btn.pack(side=tk.RIGHT, padx=10)
        c_btn.bind("<Button-1>", lambda e: self.close_tool_window(win, "Object Teleporter"))

        notebook = ttk.Notebook(win)
        notebook.pack(fill=tk.BOTH, expand=True, padx=2, pady=2)

        # Create empty frames
        tab_saved_slots = tk.Frame(notebook, bg="#121212") # NEW TAB
        tab_custom = tk.Frame(notebook, bg="#121212") 
        tab_maps = tk.Frame(notebook, bg="#121212")   
        tab_wp = tk.Frame(notebook, bg="#121212")
        tab_portal = tk.Frame(notebook, bg="#121212")
        tab_npc = tk.Frame(notebook, bg="#121212")
        tab_events = tk.Frame(notebook, bg="#121212")   # ← ADD

        # Add in specific order: Saved Slots -> Saved Tab -> Maps -> Waypoints -> Portals -> NPCs
        notebook.add(tab_saved_slots, text='Saved Slots')
        notebook.add(tab_custom, text='Saved Tab')
        notebook.add(tab_maps, text='Maps')
        notebook.add(tab_wp, text='Waypoints')
        notebook.add(tab_portal, text='Map Portals')
        notebook.add(tab_npc, text='NPCs')
        notebook.add(tab_events, text='Events')          # ← ADD

        # --- OPTIMIZATION: LAZY TAB LOADING ---
        builders = {
            0: (tab_saved_slots, self._build_tab_saved_slots),
            1: (tab_custom, self._build_tab_custom_teleport),
            2: (tab_maps, self._build_tab_map_teleports),
            3: (tab_wp, self._build_tab_waypoints),
            4: (tab_portal, self._build_tab_map_portals),
            5: (tab_npc, self._build_tab_npc),
            6: (tab_events, self._build_tab_events),
        }
        
        # Keep track of what we have already built
        built_tabs = set()

        def on_tab_change(event):
            # Save tab selection
            try:
                current_idx = notebook.index(notebook.select())
                self.saved_inputs["last_obj_tab_idx"] = current_idx
            except: 
                current_idx = 0
            
            # Check if we need to build this tab
            if current_idx in builders and current_idx not in built_tabs:
                frame, builder_func = builders[current_idx]
                builder_func(frame)
                built_tabs.add(current_idx)

        notebook.bind("<<NotebookTabChanged>>", on_tab_change)

        # --- RESTORE LAST TAB ---
        last_tab_idx = self.saved_inputs.get("last_obj_tab_idx", 0)
        if 0 <= last_tab_idx < 7:
            notebook.select(last_tab_idx)
            
        # Manually trigger load for the initial tab
        self.root.after(10, lambda: on_tab_change(None))
        
    def refresh_waypoint_list(self):
        """
        Reload and redraw waypoint list for Object Teleporter
        """
        try:
            # Clear existing tree/list
            self.waypoint_tree.delete(*self.waypoint_tree.get_children())

            # Rebuild from source
            self._build_waypoint_list()

            print("[Waypoints] Waypoint list refreshed")
        except Exception as e:
            print(f"[Waypoints] Refresh failed: {e}")
            
