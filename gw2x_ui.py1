    # ===============================
    # STABILITY FIX: ROBUST START/STOP TOGGLE
    # ===============================
    def toggle_auto_run_all(self):
        # 1. Handle STOP
        if self.auto_run_active.get():
            try:
                self.logic.stop_auto_teleport()
                # self.logic.current_auto_tp_index = 0  <-- DELETE OR COMMENT OUT THIS LINE
                # We want to keep the index where it stopped so 'Next'/'Back' works correctly
            except:
                pass
                
            self.auto_run_active.set(False)
            self.btn_auto_run.config(
                text="▶ START AUTO TELEPORT",
                bg="#330000",
                fg="white"
            )
            return

        # 2. Validation
        if not self.auto_run_source:
            messagebox.showerror("Auto Teleport", "No .tps file selected")
            return

        teleports = self._load_map_file(self.auto_run_source)
        if not teleports:
            messagebox.showerror("Auto Teleport", "Selected file is empty or invalid")
            return

        # 3. Prepare Args
        delay_value = max(0.0, float(self.auto_tp_delay.get()))
        loop_enabled = self.auto_tp_loop.get()

        raw_count = self.auto_tp_loop_count.get().strip()
        loop_count = None
        if loop_enabled and raw_count:
            try:
                loop_count = max(1, int(raw_count))
            except:
                loop_count = None
        
        # 4. Determine Start Index
        start_index = 0
        mode = self.auto_tp_start_mode.get()

        # Update Logic flags
        self.logic.auto_tp_reverse = (mode == "backward")
        self.logic.auto_tp_random = (mode == "random")

        # If "Start from last" is selected OR if we want continuity
        # Note: If you want 'Start from beginning' to actually reset, we handle that here.
        if self.logic.current_auto_tp_index is not None:
            if mode in ("last", "backward", "random"):
                start_index = self.logic.current_auto_tp_index
            else:
                # If mode is "start" (Beginning), force 0
                start_index = 0

        ok, msg = self.logic.start_auto_teleport(
            tp_list=teleports,
            delay=delay_value,
            loop=loop_enabled,
            loop_count=loop_count,
            start_index=start_index
        )
        
        if not ok:
            messagebox.showerror("Auto Teleport", msg)
            self.auto_run_active.set(False) 
            return

        # 5. Success State
        self.auto_run_active.set(True)
        self.btn_auto_run.config(
            text="■  STOP AUTO TELEPORT",
            bg="#006600",
            fg="black"
        )

    # ===============================
    # VISUALS: GW2X ESP
    # ===============================
    def build_esp_ui(self, win):
        h = tk.Label(win, text="GW2X ESP", bg="#333333", fg="white", font=("Segoe UI", 10, "bold"), pady=6)
        h.pack(fill=tk.X)
        if not self.allow_resize.get():
            self.make_draggable(h, win, "GW2X ESP", is_group_move=False)

        c_btn = tk.Label(h, text="x", bg="#333333", fg="#888", font=("Arial", 12), cursor="hand2")
        c_btn.pack(side=tk.RIGHT, padx=10)
        c_btn.bind("<Button-1>", lambda e: self.close_tool_window(win, "GW2X ESP"))

        fixed, frame = self.create_scroll_area(win, scroll=True)

        main_frame = tk.Frame(frame, bg="#121212", padx=10, pady=10)
        main_frame.pack(fill=tk.BOTH, expand=True)

        options = [
            ("Show Players", "esp_player"),
            ("Show NPCs/Obj", "esp_npc"),
            ("Map Radar", "esp_path"),
            ("Health Bars", "esp_health")
        ]

        tk.Label(main_frame, text="Entity ESP", bg="#121212", fg="#e67e22", font=("Segoe UI", 9, "bold")).pack(anchor="w", pady=(0, 5))
        
        for text, key in options:
            var = tk.IntVar(value=self.saved_inputs.get(key, 0))
            
            # FIX: Sync state to logic on UI load
            if self.logic:
                self.logic.toggle_esp(key, var.get())

            def on_change(k=key, v=var, t=text):
                self.saved_inputs[k] = v.get()
                if self.logic: self.logic.toggle_esp(k, v.get())
                self._sync_tool_indicator("GW2X ESP")

            cb = ttk.Checkbutton(main_frame, text=text, variable=var, command=on_change, style="Switch.TCheckbutton")
            cb.pack(anchor="w", pady=2)
            setattr(self, f"var_{key}", var) # Keep reference
        
    def _apply_tps_resize(self):
        win = getattr(self, "active_tps_window", None)
        if not win or not win.winfo_exists():
            return

        allow = self.allow_resize.get()
        win.resizable(allow, allow)
    
    def _build_tab_saved_slots(self, parent):
        fixed, frame = self.create_scroll_area(parent, scroll=True)

        ttk.Label(fixed, text="Live Coords", style="Section.TLabel").pack(fill=tk.X, pady=5)
        lf = ttk.Frame(fixed, padding=5); lf.pack(fill=tk.X)
        for i, (lbl, var) in enumerate(zip(["X","Y","Z"], [self.live_x, self.live_y, self.live_z])):
            ttk.Label(lf, text=lbl).grid(row=0, column=i)
            self.dark_entry(lf, var, 8).grid(row=1, column=i, padx=2)
        ttk.Button(lf, text="Copy", width=5, command=self.copy_live_to_clipboard).grid(row=1, column=3, padx=5)

        ttk.Label(frame, text="Saved Slots", style="Section.TLabel").pack(fill=tk.X, pady=(10,5))
        sf = ttk.Frame(frame, padding=5); sf.pack(fill=tk.X)
        self.slot_entries = []
        self.slot_name_entries = []
        
        for i in range(5):
            r = ttk.Frame(sf); r.pack(fill=tk.X, pady=2)
            ttk.Label(r, text=f"{i+1}", width=2).pack(side=tk.LEFT)
            
            # Renamable Name Entry
            name_e = self.dark_entry(r, width=12)
            name_e.pack(side=tk.LEFT, padx=2)
            self.slot_name_entries.append(name_e)

            # Coordinates Entry
            coord_e = self.dark_entry(r)
            coord_e.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=2)
            self.slot_entries.append(coord_e)

            # Save Button (Left/Right click bindings)
            btn_s = ttk.Button(r, text="S", width=3, command=lambda idx=i, x=coord_e: self.save_slot_ui(idx, x))
            btn_s.pack(side=tk.RIGHT)
            btn_s.bind("<Button-3>", lambda e, idx=i: self.prompt_macro_hotkey(f"SLOT_SAVE_{idx}", f"Save Slot {idx+1}"))
            
            # Load Button (Left/Right click bindings)
            btn_l = ttk.Button(r, text="L", width=3, command=lambda idx=i: self.load_slot_ui(idx))
            btn_l.pack(side=tk.RIGHT)
            btn_l.bind("<Button-3>", lambda e, idx=i: self.prompt_macro_hotkey(f"SLOT_LOAD_{idx}", f"Load Slot {idx+1}"))
            
        self.refresh_slots()
        
        tk.Label(frame, text="Right-click 'S' or 'L' to set hotkeys.", bg="#121212", fg="#888", font=("Segoe UI", 8, "italic")).pack(pady=5)

    def _build_tab_main_teleport(self, parent):
        fixed, frame = self.create_scroll_area(parent, scroll=True)

        # --- MAP TELEPORT ROW (Toggle + Config) ---
        # Container for the row
        row_frame = tk.Frame(frame, bg="#330000") # Dark red background to match OFF state
        row_frame.pack(fill=tk.X, pady=(15, 5), padx=5)

        def toggle_map_tp():
            state = self.map_click_tp_enabled.get()
            color = "#004400" if state else "#330000"
            text_color = "#ccffcc" if state else "#ffcccc"
            
            self.btn_map_tp.config(text="Map TP: ON" if state else "Map TP: OFF", bg=color, fg=text_color)
            row_frame.config(bg=color) # Match container background

        # 1. The Toggle Button (Left, expands)
        self.btn_map_tp = tk.Button(
            row_frame, 
            text="Map TP: OFF", 
            command=lambda: [self.map_click_tp_enabled.set(not self.map_click_tp_enabled.get()), toggle_map_tp()],
            bg="#330000", fg="#ffcccc", relief="flat", font=("Segoe UI", 9, "bold")
        )
        self.btn_map_tp.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # --- Mouse ROW (Toggle + Config) ---
        mouse_row = tk.Frame(frame, bg="#330000")
        mouse_row.pack(fill=tk.X, pady=5, padx=5)

        def toggle_mouse_tp_ui():
            state = self.mouse_tp_active.get()
            color = "#004400" if state else "#330000"
            text_color = "#ccffcc" if state else "#ffcccc"
            
            self.btn_mouse_tp_toggle.config(
                text="Cursor TP: ON" if state else "Cursor TP: OFF", 
                bg=color, 
                fg=text_color
            )     
            mouse_row.config(bg=color)      

        self.btn_mouse_tp_toggle = tk.Button(
            mouse_row, text="Cursor TP: OFF", 
            command=lambda: [self.mouse_tp_active.set(not self.mouse_tp_active.get()), toggle_mouse_tp_ui()],
            bg="#330000", fg="#ffcccc", relief="flat", font=("Segoe UI", 9, "bold")
        )
        self.btn_mouse_tp_toggle.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        # Hotkey button for the mouse teleport
        self.btn_mouse_tp_hk = tk.Button(
            mouse_row, text=self.mouse_tp_hotkey.get("text", "Alt+Q"),
            bg="#333333", fg="#aaaaaa", width=8, relief="solid", bd=1,
            command=self.prompt_mouse_tp_hotkey 
        )
        self.btn_mouse_tp_hk.pack(side=tk.RIGHT, padx=2)
        
        # 3. The Hotkey Config Button (Right, small)
        self.btn_map_hotkey = tk.Button(
            row_frame,
            text=self.map_tp_hotkey.get("text", "Alt+T"),
            command=self.prompt_map_tp_hotkey,
            bg="#222222", fg="#aaaaaa", relief="solid", bd=1, width=8
        )
        self.btn_map_hotkey.pack(side=tk.RIGHT, padx=2, pady=2)
        
        toggle_map_tp() # Initialize Map colors
        toggle_mouse_tp_ui() # Initialize Cursor colors

        # --- Manual Coordinates ---
        ttk.Label(frame, text="Manual Coordinates", style="Section.TLabel").pack(fill=tk.X, pady=(10,5))
        mf = ttk.Frame(frame, padding=5); mf.pack(fill=tk.X)
        self.tp_combined = self.dark_entry(mf, width=25)
        self.tp_combined.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 5))
        ttk.Button(mf, text="GO", width=4, command=self.do_tp_combined).pack(side=tk.RIGHT)                       
        
        # --- Directional ---
        ttk.Label(frame, text="Directional", style="Section.TLabel").pack(fill=tk.X, pady=(15, 5))
        dir_box = tk.Frame(frame, bg="#121212"); dir_box.pack(fill=tk.X, padx=10)
        p_frame = tk.Frame(dir_box, bg="#121212"); p_frame.pack(fill=tk.X, pady=5)
        tk.Label(p_frame, text="Dist:", bg="#121212", fg="#888", width=4).pack(side=tk.LEFT)
        tk.Entry(p_frame, textvariable=self.dir_dist_var, width=5, bg="#202020", fg="#00ff00", relief="flat", validate="key", validatecommand=self.num_vcmd).pack(side=tk.LEFT, padx=5)
        tk.Label(p_frame, text="H:", bg="#121212", fg="#888", width=2).pack(side=tk.LEFT)
        tk.Entry(p_frame, textvariable=self.dir_height_var, width=5, bg="#202020", fg="#0078d7", relief="flat", validate="key", validatecommand=self.num_vcmd).pack(side=tk.LEFT, padx=5)

        btn_container = tk.Frame(dir_box, bg="#121212"); btn_container.pack(fill=tk.X, pady=5)
        grid_frame = tk.Frame(btn_container, bg="#121212"); grid_frame.pack(side=tk.LEFT, padx=(5, 10))
        btn_style = {"bg": "#2a2a2a", "fg": "#0078d7", "relief": "flat", "width": 3, "height": 1, "font": ("Segoe UI", 8, "bold")}
        tk.Button(grid_frame, text="N", command=lambda: self.do_tp_relative("n"), **btn_style).grid(row=0, column=1, pady=1)
        tk.Button(grid_frame, text="W", command=lambda: self.do_tp_relative("w"), **btn_style).grid(row=1, column=0, padx=1)
        tk.Button(grid_frame, text="E", command=lambda: self.do_tp_relative("e"), **btn_style).grid(row=1, column=2, padx=1)
        tk.Button(grid_frame, text="S", command=lambda: self.do_tp_relative("s"), **btn_style).grid(row=2, column=1, pady=1)

        vert_frame = tk.Frame(btn_container, bg="#121212"); vert_frame.pack(side=tk.LEFT)
        tk.Button(vert_frame, text="UP", command=lambda: self.do_tp_vertical(self.dir_height_var.get()), **btn_style).pack(pady=1)
        tk.Button(vert_frame, text="DN", command=lambda: self.do_tp_vertical(f"-{self.dir_height_var.get()}"), **btn_style).pack(pady=1)
        
    def _normalize_map_name(self, s):
        return (
            s.lower()
            .replace(":", "")
            .replace("_", " ")
            .replace("-", " ")
            .strip()
        )
    
    def _is_current_map_file(self, group_name):
        try:
            current = self.logic.get_map_name()
            if not current:
                return False
            return self._normalize_map_name(group_name) == self._normalize_map_name(current)
        except:
            return False

    def _find_map_files(self, map_name):
        base_dir = os.path.join(os.path.dirname(__file__), "teleports", "maps")

        target = self._normalize_map_name(map_name)
        exact = []
        loose = []

        if not os.path.exists(base_dir):
            return []

        for root, _, files in os.walk(base_dir):
            for f in files:
                name, ext = os.path.splitext(f)
                if ext.lower() not in (".tps", ".json"):
                    continue

                norm = self._normalize_map_name(name)

                # STRICT match (preferred)
                if norm.endswith(target):
                    exact.append(os.path.join(root, f))

                # LOOSE match (fallback only)
                elif target in norm:
                    loose.append(os.path.join(root, f))

        # IMPORTANT RULE
        return exact if exact else loose
    
    def _find_map_folders_by_name(self, map_name):
        base_dir = os.path.join(os.path.dirname(__file__), "teleports", "maps")
        target = self._normalize_map_name(map_name)
        matches = []

        if not os.path.exists(base_dir):
            return matches

        for root, dirs, _ in os.walk(base_dir):
            for d in dirs:
                if self._normalize_map_name(d) == target:
                    matches.append(os.path.join(root, d))

        return matches
    
    def _rebuild_tps_window(self, win):
        """Refreshes the list of TP spots in the window."""
        if not win or not win.winfo_exists():
            return

        # Clear existing rows to prevent duplicates
        if hasattr(win, '_tps_rows'):
            for r in win._tps_rows:
                r.destroy()
        win._tps_rows = []

        # Re-create rows from win.points
        for idx, pt in enumerate(win.points):
            # Create row
            row = self._create_tp_row_frame(win.scroll_frame, idx, pt, win)
            win._tps_rows.append(row)
            row.pack(fill=tk.X, pady=1)
            
    def _open_map_file_window(self, group_name, path, force_open=False):
        norm_path = os.path.normpath(os.path.abspath(path))
        win_key = f"map:{norm_path}"
        self._active_tps_build = None

        # Check existing
        existing = self.map_file_windows.get(win_key)
        if existing and existing.winfo_exists():
            existing.lift()
            existing.focus_force()
            return

        # 1. Create Window
        win = tk.Toplevel(self.root)
        self.active_tps_window = win
        win._tps_rows = []
        win.withdraw()
        self.map_file_windows[win_key] = win
        
        # Settings Sync
        self.auto_run_source = path
        if hasattr(self, "auto_tp_file_lbl") and self.auto_tp_file_lbl and self.auto_tp_file_lbl.winfo_exists():
            self.auto_tp_file_lbl.config(text=os.path.basename(path), fg="#00ff00")
        self.saved_inputs["auto_tp_last_file"] = path
        self.saved_inputs["auto_tp_open"] = True
        self.save_settings()
        
        # Window Props
        win.title(f"{group_name}")
        win.configure(bg="#121212")
        win.attributes("-topmost", True)
        win.attributes("-alpha", self.transparency)

        # Close Handler
        def on_close():
            self.saved_inputs["auto_tp_open"] = False
            self.save_settings()
            if hasattr(self, "auto_tp_file_lbl"):
                self.auto_tp_file_lbl.config(text="(None)", fg="white")
            win.destroy()
            if win_key in self.map_file_windows:
                del self.map_file_windows[win_key]
        win.protocol("WM_DELETE_WINDOW", on_close)

        # Load Data
        data_points = self._load_map_file(path)
        win.points = data_points 
        win.filepath = path

        # --- HEADER ---
        h_frame = tk.Frame(win, bg="#333333")
        h_frame.pack(fill=tk.X, side=tk.TOP)
        self.make_draggable(h_frame, win, win_key, is_group_move=False)

        # Title Row
        t_row = tk.Frame(h_frame, bg="#333333")
        t_row.pack(fill=tk.X, pady=(5, 2))
        
        def close_me():
            if win.winfo_viewable():
                self.saved_positions[win_key] = {
                    "x": win.winfo_x(), "y": win.winfo_y(),
                    "w": win.winfo_width(), "h": win.winfo_height()
                }
            if win_key in self.map_file_windows: del self.map_file_windows[win_key]
            if path == self.saved_inputs.get("auto_tp_last_file"): self.saved_inputs["auto_tp_open"] = False
            self.save_settings()
            win.destroy()
            
        btn_close = tk.Button(t_row, text="x", bg="#333333", fg="#aaaaaa", font=("Arial", 12), bd=0, width=3, command=close_me)
        btn_close.pack(side=tk.RIGHT, padx=8)
        
        t_lbl = tk.Label(t_row, text=textwrap.shorten(f"📂 {group_name}", width=40, placeholder="…"), bg="#333333", fg="white", font=("Segoe UI", 11, "bold"), anchor="w")
        t_lbl.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=10)
        win.t_lbl = t_lbl 
        self.make_draggable(t_lbl, win, win_key, is_group_move=False)

        # Info & Add Button
        info_row = tk.Frame(win, bg="#121212")
        info_row.pack(fill=tk.X, padx=5, pady=2)
        count_lbl = tk.Label(info_row, text=f"{len(data_points)} Spots", fg="cyan", bg="#121212")
        count_lbl.pack(side=tk.LEFT)

        # Search & Edit Tools
        c_row = tk.Frame(h_frame, bg="#333333") 
        c_row.pack(fill=tk.X, padx=5, pady=(0, 5)) 

        popup_search = tk.StringVar()
        popup_edit_mode = tk.BooleanVar(value=False)
        win.popup_edit_mode = popup_edit_mode

        tk.Label(c_row, text="🔍", bg="#333333", fg="#888").pack(side=tk.LEFT)
        search_entry = tk.Entry(c_row, textvariable=popup_search, bg="#222", fg="white", relief="flat", width=20)
        search_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=5)

        # --- FOOTER ---
        nav_footer = tk.Frame(win, bg="#333333")
        nav_footer.pack(side=tk.BOTTOM, fill=tk.X)
        nav_btns = tk.Frame(nav_footer, bg="#333333")
        nav_btns.pack(fill=tk.X, padx=5, pady=(5, 2)) 

        # --- BODY ---
        body_frame = tk.Frame(win, bg="#121212")
        body_frame.pack(fill=tk.BOTH, expand=True)

        canvas = tk.Canvas(body_frame, bg="#121212", highlightthickness=0)
        scrollbar = ttk.Scrollbar(body_frame, orient="vertical", command=canvas.yview)
        scroll_frame = tk.Frame(canvas, bg="#121212")

        canvas_win_id = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")

        def on_canvas_configure(event):
            canvas.itemconfig(canvas_win_id, width=event.width)
        canvas.bind("<Configure>", on_canvas_configure)
        scroll_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        win.scroll_frame = scroll_frame
        win._tps_canvas = canvas
        win._tps_row_parent = scroll_frame

        # ==================================================
        # HIGHLIGHT LOGIC
        # ==================================================
        # --- FIX: Attach state to 'win' so it doesn't conflict with global UI ---
        win.highlight_state = {"last_btn": None}
        
        def on_highlight(new_btn, index, suppress_scroll=False):
            # 1. RESET OLD ROW (Dark)
            # Use win.highlight_state instead of self.highlight_state
            if win.highlight_state["last_btn"] and win.highlight_state["last_btn"].winfo_exists():
                old_row = win.highlight_state["last_btn"]
                old_row.config(bg="#1e1e1e")
                for child in old_row.winfo_children():
                    try:
                        # Don't change the color strip (width 4)
                        if child.winfo_width() != 4: 
                            child.config(bg="#1e1e1e")
                    except: pass
            
            # 2. HIGHLIGHT NEW ROW (Blue)
            if new_btn.winfo_exists():
                row = new_btn.master
                row.config(bg="#004488")
                
                for child in row.winfo_children():
                    try:
                        if child.winfo_width() != 4: 
                            child.config(bg="#004488")
                    except: pass

                # Save to window-specific state
                win.highlight_state["last_btn"] = row

            # 3. Auto-Scroll (Only if not suppressed)
            if not suppress_scroll:
                try:
                    content_h = win.scroll_frame.winfo_height()
                    if content_h < 50: content_h = win.scroll_frame.winfo_reqheight()

                    btn_y = new_btn.master.winfo_y()
                    btn_h = new_btn.master.winfo_height()
                    if btn_h < 5: btn_h = 36 
                    
                    if content_h > 0:
                        btn_center_frac = (btn_y + (btn_h / 2)) / content_h
                        view_top, view_bottom = canvas.yview()
                        view_height = view_bottom - view_top
                        
                        if btn_center_frac < view_top or btn_center_frac > view_bottom:
                            target_pos = btn_center_frac - (view_height / 2)
                            target_pos = max(0.0, min(1.0, target_pos))
                            canvas.yview_moveto(target_pos)
                except: pass

        local_row_widgets = {}
        current_teleports_ref = [[]] 

        # Helper: Rebuild List
        def rebuild_tps_window(save_mode=False, suppress_scroll=False):
            if save_mode: self._save_map_file(path, win.points)

            # Store Scroll Position if not suppressed
            saved_scroll_pos = canvas.yview()[0] if suppress_scroll else None

            for w in win._tps_row_parent.winfo_children(): w.destroy()
            local_row_widgets.clear()

            query = popup_search.get().lower().strip()
            filtered = [t for t in win.points if query in t["name"].lower()]
            current_teleports_ref[0] = filtered
            
            count_lbl.config(text=f"{len(filtered)} / {len(win.points)} Spots")
            if hasattr(win, "t_lbl"): 
                 win.t_lbl.config(text=f"📂 {group_name}   [{len(filtered)}/{len(win.points)}]")

            def delete_item_callback(item):
                if self.logic and self.logic.auto_tp_running: return
                if item in win.points:
                    win.points.remove(item)
                    rebuild_tps_window(save_mode=True, suppress_scroll=True) 

            for i, tp in enumerate(filtered):
                # =========================================================
                # FIX: Added edit_override=popup_edit_mode
                # This forces the rows to respect the popup's local edit button
                # =========================================================
                row = self._create_tp_row(
                    parent_frame=win._tps_row_parent,
                    tp=tp,
                    index=i,
                    total=len(filtered),
                    refresh_cb=lambda save_mode=False, s_scroll=True: rebuild_tps_window(save_mode=save_mode, suppress_scroll=s_scroll),
                    dialog_parent=win,
                    delete_cb=lambda t=tp: delete_item_callback(t),
                    highlight_cb=on_highlight, 
                    true_index=None,
                    widget_registry=local_row_widgets,
                    edit_override=popup_edit_mode,
                    source_list=win.points
                )
                win._tps_rows.append(row)

            self.tp_row_widgets = local_row_widgets
            self._current_tps_list = win.points
            
            # --- BIND SCROLL ---
            def _bind_scroll(widget):
                widget.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1*(e.delta/120)), "units"))
                for child in widget.winfo_children(): _bind_scroll(child)
            
            for widget in win._tps_row_parent.winfo_children(): _bind_scroll(widget)

            # Restore Highlight
            idx = self.logic.current_auto_tp_index
            if idx in local_row_widgets:
                btn = local_row_widgets[idx]
                win.after(100, lambda b=btn, i=idx: on_highlight(b, i, suppress_scroll=True))

            # --- FORCE RESTORE SCROLL POSITION ---
            if suppress_scroll and saved_scroll_pos is not None:
                def restore():
                    canvas.yview_moveto(saved_scroll_pos)
                # Slight delay to allow geometry to update
                win.after(10, restore)


        # Helper: Navigation
        def manual_step(direction):
            if threading.current_thread() is not threading.main_thread():
                win.after(0, lambda: manual_step(direction))
                return

            if not current_teleports_ref[0]: return
            self._manual_tp_in_progress = True
            try:
                self.logic.step_tp_manual(direction, current_teleports_ref[0])
            finally:
                self._manual_tp_in_progress = False

            idx = self.logic.current_auto_tp_index
            self.tp_row_widgets = local_row_widgets
            btn = local_row_widgets.get(idx)
            if btn: on_highlight(btn, idx)
            else:
                if local_row_widgets:
                    idx = 0
                    self.logic.set_manual_index(0)
                    btn = local_row_widgets.get(0)
                    if btn: on_highlight(btn, 0)

        self._tps_manual_step_cb = manual_step
        
        def _on_tp_step(idx):
            if idx in local_row_widgets:
                win.after(0, lambda: on_highlight(local_row_widgets[idx], idx))
        self.logic.on_auto_tp_step = _on_tp_step

        # --- BUTTONS ---
        def add_spot():
            if self.logic and self.logic.auto_tp_running: return
            pos = self.logic.read_live_coords()
            if not pos: return

            new_pt = {
                "name": "New Teleport",
                "x": pos[0], "y": pos[1], "z": pos[2],
                "map_id": 0, "allow_cross_map": True
            }

            insert_index = self.logic.current_auto_tp_index
            if insert_index is None or insert_index < 0 or insert_index >= len(win.points):
                win.points.append(new_pt)
                self.logic.current_auto_tp_index = len(win.points) - 1
            else:
                win.points.insert(insert_index + 1, new_pt)
                self.logic.current_auto_tp_index = insert_index + 1

            rebuild_tps_window(save_mode=True, suppress_scroll=True)
            
        def add_spot_popup():
            if self.logic and self.logic.auto_tp_running: return
            pos = self.logic.read_live_coords()
            if not pos: return
            name = simpledialog.askstring("Add Teleport", "Name:", parent=win)
            if not name: return
            new_pt = {"name": name, "x": pos[0], "y": pos[1], "z": pos[2], "map_id": 0, "allow_cross_map": True}
            win.points.append(new_pt)
            rebuild_tps_window(save_mode=True, suppress_scroll=True)

        ttk.Button(info_row, text="+ Add Spot", command=add_spot).pack(side=tk.RIGHT)

        def toggle_edit():
            # 1. Capture current scroll position
            current_scroll = canvas.yview()[0]

            # 2. Toggle State
            state = not popup_edit_mode.get()
            popup_edit_mode.set(state)
            btn_edit.config(text="✔" if state else "✎ ")

            if state:
                btn_add_custom.pack(side=tk.RIGHT, padx=2)
            else:
                btn_add_custom.pack_forget()

            # 3. Rebuild (Passing suppress_scroll=True triggers the internal restore logic)
            # BUT we want to enforce the position captured *here*
            rebuild_tps_window(suppress_scroll=True)
            
            # 4. Enforce restore again (double safety)
            def restore_after_build():
                canvas.yview_moveto(current_scroll)
            win.after(20, restore_after_build)

        btn_edit = ttk.Button(c_row, text="✎ ", width=3, command=toggle_edit); btn_edit.pack(side=tk.RIGHT, padx=2)
        btn_add_custom = ttk.Button(c_row, text="➕", width=3, command=add_spot_popup)
        popup_search.trace_add("write", lambda *_: rebuild_tps_window())

        self.btn_tps_back = tk.Button(nav_btns, text="◀ Back", width=10, bg="#2a2a2a", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), command=lambda: manual_step(-1))
        self.btn_tps_back.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 2))

        self.btn_tps_next = tk.Button(nav_btns, text="Next ▶", width=10, bg="#2a2a2a", fg="white", relief="flat", font=("Segoe UI", 9, "bold"), command=lambda: manual_step(1))
        self.btn_tps_next.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(2, 0))
        
        self.btn_tps_next.bind("<Button-3>", lambda e: self._prompt_tps_nav_hotkey("next"))
        self.btn_tps_back.bind("<Button-3>", lambda e: self._prompt_tps_nav_hotkey("back"))

        # Restore Position
        restored = False
        target_w, target_h = 176, 325
        if win_key in self.saved_positions:
            p = self.saved_positions[win_key]
            if "x" in p and "y" in p and not (p['x'] == 0 and p['y'] == 0):
                win.geometry(f"{target_w}x{target_h}+{p['x']}+{p['y']}")
                restored = True
        
        if not restored:
            mx = self.root.winfo_x(); my = self.root.winfo_y(); mw = self.root.winfo_width()
            win.geometry(f"{target_w}x{target_h}+{mx+mw+10}+{my}")

        win.deiconify()
        win.update_idletasks() 
        self._active_tps_rebuild = rebuild_tps_window
        self.apply_resize_mode(win, self.allow_resize.get())
        rebuild_tps_window()

    def _tps_step_hotkey(self, direction):
        if not getattr(self, "_tps_window_active", False):
            return

        # always use CURRENT TPS state
        tp_list = getattr(self, "_current_tps_list", None)
        if not tp_list:
            return

        self.logic.step_tp_manual(direction, tp_list)
    
    def _tps_manual_step(self, direction):
        if not getattr(self, "active_tps_window", None):
            return

        if not hasattr(self, "_tps_manual_step_cb"):
            return

        # 🔒 unify hotkey + button path
        self._tps_manual_step_cb(direction)


    def _prompt_tps_nav_hotkey(self, action):
        dlg = tk.Toplevel(self.root)
        dlg.title(f"Bind {action.title()} Hotkey")
        dlg.geometry(f"260x90+{self.root.winfo_x()+40}+{self.root.winfo_y()+40}")
        dlg.configure(bg="#121212")
        dlg.attributes("-topmost", True)
        dlg.grab_set()

        lbl = tk.Label(
            dlg,
            text=f"Press keys for {action.upper()}...",
            fg="#00ffcc",
            bg="#121212",
            font=("Segoe UI", 10, "bold")
        )
        lbl.pack(expand=True)

        user32 = ctypes.windll.user32

        def poll():
            if not dlg.winfo_exists(): return
            
            # 1. Capture Modifiers (Check Generic IDs)
            mods = []
            mod_names = []
            if user32.GetAsyncKeyState(0x11) & 0x8000: mods.append(0x11); mod_names.append("Ctrl")
            if user32.GetAsyncKeyState(0x12) & 0x8000: mods.append(0x12); mod_names.append("Alt")
            if user32.GetAsyncKeyState(0x10) & 0x8000: mods.append(0x10); mod_names.append("Shift")

            # 2. Check for Main Key
            for vk in range(8, 255):
                # --- FIX: IGNORE ALL MODIFIER VARIANTS ---
                # 0x10-0x12 (Generic), 0xA0-0xA1 (Shift L/R), 0xA2-0xA3 (Ctrl L/R), 0xA4-0xA5 (Alt L/R)
                if vk in (0x10, 0x11, 0x12, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5): 
                    continue 

                if user32.GetAsyncKeyState(vk) & 0x8000:
                    # Determine Key Name
                    if 0x30 <= vk <= 0x5A: name = chr(vk)
                    elif 0x70 <= vk <= 0x87: name = f"F{vk - 0x6F}"
                    else: name = f"Key_{vk:02X}"

                    # Build Display Text (e.g. "Alt+1")
                    full_text = "+".join(mod_names + [name])
                    
                    # Create Config Object
                    new_cfg = {"mods": mods, "key": vk, "text": full_text}

                    # --- CONFLICT CHECK ---
                    other_action = "back" if action == "next" else "next"
                    other_val = self.tps_nav_hotkeys.get(other_action)
                    
                    collision = False
                    if other_val:
                        if isinstance(other_val, int):
                            if not mods and vk == other_val: collision = True
                        elif isinstance(other_val, dict):
                            if (int(other_val.get("key", 0)) == int(vk) and 
                                set(other_val.get("mods", [])) == set(mods)):
                                collision = True

                    if collision:
                        print(f"[UI] Unbound '{other_action}' due to conflict with {full_text}")
                        self.tps_nav_hotkeys[other_action] = None
                        other_btn = self.btn_tps_back if action == "next" else self.btn_tps_next
                        base_text = "◀ Back" if other_action == "back" else "Next ▶"
                        other_btn.config(text=base_text)

                    # --- SAVE NEW HOTKEY ---
                    self.tps_nav_hotkeys[action] = new_cfg
                    self.saved_inputs["tps_nav_hotkeys"] = self.tps_nav_hotkeys
                    self.save_settings()

                    # Update CURRENT button text
                    btn = self.btn_tps_next if action == "next" else self.btn_tps_back
                    base_text = "Next ▶" if action == "next" else "◀ Back"
                    btn.config(text=f"{base_text} [{full_text}]")

                    dlg.destroy()
                    return

            dlg.after(15, poll)

        dlg.after(100, poll)


    # =========================================================================
    # REPLACEMENT: _build_tab_custom_teleport (Now matches Maps Tab Logic)
    # =========================================================================
    # =========================================================================
    # REPLACEMENT: Saved Tab (Dropdown Folder Selection)
    # =========================================================================
    def _build_tab_custom_teleport(self, parent):
        # --- 1. TOP CONTAINER ---
        top_container = tk.Frame(parent, bg="#1e1e1e", pady=8) # Increased padding
        top_container.pack(fill=tk.X, side=tk.TOP)

        # Left Side: Controls
        ctrl_frame = tk.Frame(top_container, bg="#1e1e1e")
        ctrl_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=8)

        # --- ROW 1: FOLDER DROPDOWN (Searchable & Taller) ---
        row_folder = tk.Frame(ctrl_frame, bg="#1e1e1e")
        row_folder.pack(fill=tk.X, pady=(0, 5)) # More space below folder row
        
        lbl_folder = tk.Label(row_folder, text="📂 Folder", bg="#1e1e1e", fg="#00aaff", font=("Segoe UI", 9, "bold"), width=9, anchor="w")
        lbl_folder.pack(side=tk.LEFT)

        # Custom Style for Taller, Visible Dropdown
        style = ttk.Style()
        style.configure(
            "Saved.TCombobox",
            fieldbackground="#252525", # Dark input area
            background="#444444",      # Arrow button background
            foreground="#ffffff",      # Text color
            arrowcolor="white",
            bordercolor="#555555",
            padding=8,                 # INTERNAL PADDING (Fixes text cropping)
            insertcolor="white"        # Cursor color
        )
        
        # Remove "readonly" map so it looks editable
        style.map("Saved.TCombobox", 
            fieldbackground=[("readonly", "#252525"), ("!readonly", "#252525")],
            foreground=[("readonly", "#ffffff"), ("!readonly", "#ffffff")]
        )

        self.custom_folder_var = tk.StringVar(value="(Root)")
        self.all_folders_cache = ["(Root)"] # Master list for filtering

        self.combo_folders = ttk.Combobox(
            row_folder, 
            textvariable=self.custom_folder_var, 
            state="normal", # ENABLE TYPING (Searchable)
            height=8,
            style="Saved.TCombobox"
        )
        # ipady=4 makes the widget physically taller externally
        self.combo_folders.pack(side=tk.LEFT, fill=tk.X, expand=True, ipady=4)
        
        # --- SEARCH LOGIC ---
        def on_folder_type(event):
            # Filter the list based on what user typed
            typed = self.custom_folder_var.get().lower()
            if not typed:
                self.combo_folders['values'] = self.all_folders_cache
            else:
                filtered = [f for f in self.all_folders_cache if typed in f.lower()]
                self.combo_folders['values'] = filtered
            
            # Keep the dropdown open if possible (optional, Tkinter sometimes closes it)
            # if not self.combo_folders.tk.call('winfo', 'ismapped', self.combo_folders.popdown):
            #    self.combo_folders.event_generate('<Down>')

        def on_folder_select(event):
            # When clicked/selected, trigger refresh
            self.refresh_custom_tp_tab()

        self.combo_folders.bind("<KeyRelease>", on_folder_type)
        self.combo_folders.bind("<<ComboboxSelected>>", on_folder_select)
        
        # --- HELPER: SEARCH ROW ---
        def create_search_row(parent_frame, icon, text_var, placeholder_color):
            row = tk.Frame(parent_frame, bg="#1e1e1e", pady=3)
            row.pack(fill=tk.X)
            lbl = tk.Label(row, text=icon, bg="#1e1e1e", fg="#ffffff", font=("Segoe UI", 9), width=7, anchor="w")
            lbl.pack(side=tk.LEFT)
            ent = tk.Entry(row, textvariable=text_var, bg="#333333", fg=placeholder_color, insertbackground="white", relief="flat", font=("Segoe UI", 9))
            ent.pack(side=tk.LEFT, fill=tk.X, expand=True, ipady=2) # Taller inputs
            
            def clear_search():
                text_var.set("") 
                self.refresh_custom_tp_tab() 
                
            clear_btn = tk.Label(row, text="✖", bg="#1e1e1e", fg="#888", font=("Segoe UI", 9), cursor="hand2", width=2)
            clear_btn.pack(side=tk.RIGHT, padx=(5, 0))
            clear_btn.bind("<Button-1>", lambda e: clear_search())
            
            tk.Frame(row, bg="#555555", height=1).pack(side=tk.BOTTOM, fill=tk.X, pady=(4, 0))

        # --- ROW 2 & 3: FILE/TP SEARCH ---
        self.custom_group_search = tk.StringVar()
        self.custom_tp_search = tk.StringVar()

        create_search_row(ctrl_frame, "⌕ File", self.custom_group_search, "#ffffff")
        create_search_row(ctrl_frame, "⌕ TP",   self.custom_tp_search,    "#00ff00")

        # Bind Search Updates
        self.custom_group_search.trace_add("write", lambda *_: self.refresh_custom_tp_tab())
        self.custom_tp_search.trace_add("write", lambda *_: self.refresh_custom_tp_tab())

        # --- RIGHT SIDE: BUTTONS ---
        btn_frame = tk.Frame(top_container, bg="#1e1e1e")
        btn_frame.pack(side=tk.RIGHT, padx=5, anchor="n")
        
        def clear_all_and_refresh():
            self.custom_group_search.set("")
            self.custom_tp_search.set("")
            # Optional: Reset folder
            # self.custom_folder_var.set("(Root)")
            # self.combo_folders['values'] = self.all_folders_cache
            self.refresh_custom_tp_tab()

        def toggle_edit():
            self.tp_edit_mode.set(not self.tp_edit_mode.get())
            update_btns()
            self.refresh_custom_tp_tab()

        self.btn_custom_edit = tk.Button(btn_frame, image=self.icons["edit"], bg="#1e1e1e", activebackground="#333333", relief="flat", bd=0, padx=2, pady=2, cursor="hand2", command=toggle_edit)
        self.btn_custom_edit.pack(side=tk.TOP, pady=2)
        
        tk.Button(btn_frame, image=self.icons["refresh"], bg="#1e1e1e", activebackground="#333333", relief="flat", bd=0, cursor="hand2", padx=2, pady=2, command=clear_all_and_refresh).pack(side=tk.TOP, pady=2)
        
        self.btn_new_custom_file = tk.Button(btn_frame, image=self.icons["add"], bg="#1e1e1e", activebackground="#FFFFFF", relief="flat", bd=0, padx=2, pady=2, cursor="hand2", command=self.add_custom_tp_file)
        self.btn_new_custom_file.pack(side=tk.TOP, pady=2)

        def update_btns():
            state = tk.NORMAL if self.tp_edit_mode.get() else tk.DISABLED
            self.btn_new_custom_file.config(state=state)
        update_btns()

        # Status Label
        self.custom_tp_status_lbl = tk.Label(parent, text="Custom Teleports", bg="#121212", fg="#00ff00", font=("Segoe UI", 9))
        self.custom_tp_status_lbl.pack(pady=(5, 3))
        
        # --- 2. SCROLLABLE LIST CONTAINER ---
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True)

        self.custom_canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        style.configure("Vertical.TScrollbar", background="#444444", troughcolor="#222222")
        scroll = ttk.Scrollbar(list_container, orient=tk.VERTICAL, command=self.custom_canvas.yview, style="Vertical.TScrollbar")
        
        scroll.pack(side=tk.RIGHT, fill=tk.Y)
        self.custom_canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.custom_canvas.configure(yscrollcommand=scroll.set)
        
        self.custom_tp_frame = tk.Frame(self.custom_canvas, bg="#121212")
        cw = self.custom_canvas.create_window((0, 0), window=self.custom_tp_frame, anchor="nw")
        
        self.custom_canvas.bind("<Configure>", lambda e: self.custom_canvas.itemconfig(cw, width=e.width))
        self.custom_tp_frame.bind("<Configure>", lambda e: self._recalc_custom_scrollregion())
        
        def _on_mousewheel(e):
            try: self.custom_canvas.yview_scroll(int(-1 * (e.delta / 120)), "units")
            except: pass
                      
        self.custom_tp_frame.bind("<Enter>", lambda _: self.custom_canvas.bind_all("<MouseWheel>", _on_mousewheel))
        self.custom_tp_frame.bind("<Leave>", lambda _: self.custom_canvas.unbind_all("<MouseWheel>"))

        self.refresh_custom_tp_tab()

    # --- HELPER 1: Refresh Logic (Searchable + Folder Scanning) ---
    def refresh_custom_tp_tab(self):
        if not hasattr(self, "custom_canvas") or not self.custom_canvas.winfo_exists(): return
        
        # 1. Update Folder List (Master Cache)
        base_dir = data.CUSTOM_TP_DIR
        subdirs = []
        if os.path.exists(base_dir):
            subdirs = [d for d in os.listdir(base_dir) if os.path.isdir(os.path.join(base_dir, d))]
            subdirs.sort()
        
        self.all_folders_cache = ["(Root)"] + subdirs
        
        # Only reset values if the user hasn't typed a filter active, 
        # or if the current list is empty.
        current_typed = self.custom_folder_var.get()
        if not current_typed or current_typed in self.all_folders_cache:
             self.combo_folders['values'] = self.all_folders_cache

        # 2. Determine Target Directory
        # If user typed something that matches exactly, use it. Otherwise default to Root.
        if current_typed in self.all_folders_cache and current_typed != "(Root)":
             target_dir = os.path.join(base_dir, current_typed)
        else:
             target_dir = base_dir # Default to root if text doesn't match a folder or is "(Root)"

        # 3. Clear UI
        for w in self.custom_tp_frame.winfo_children(): w.destroy()
        
        # 4. Scan Files
        search_file = self.custom_group_search.get().lower().strip()
        search_tp = self.custom_tp_search.get().lower().strip()
        
        valid_files = []
        if os.path.exists(target_dir):
            try:
                for f in os.listdir(target_dir):
                    if not f.lower().endswith(('.tps', '.json')): continue
                    if search_file and search_file not in f.lower(): continue
                    valid_files.append(f)
            except OSError: pass # Handle invalid path
        
        valid_files.sort()
        
        # 5. Render
        if not valid_files:
            # Show friendly message
            msg = f"No files in {current_typed}" if current_typed != "(Root)" else "No files in Root"
            tk.Label(self.custom_tp_frame, text=msg, bg="#121212", fg="#666").pack(pady=5)
        else:
            display_title = "Root" if target_dir == base_dir else os.path.basename(target_dir)
            
            section, content = self._create_collapsible_section(
                self.custom_tp_frame,
                f"📂 {display_title}",
                start_open=True
            )
            section.pack(fill=tk.X, pady=(10, 2))

            for fname in valid_files:
                path = os.path.join(target_dir, fname)
                group_name = os.path.splitext(fname)[0]
                
                teleports = self._load_map_file(path)
                
                if search_tp:
                    teleports = [tp for tp in teleports if search_tp in tp["name"].lower()]
                    if not teleports: continue
                
                grp_widget = self._create_map_tp_group(content, group_name, teleports, path)
                grp_widget.pack(fill=tk.X, pady=1, padx=8)

        self._recalc_custom_scrollregion()

    # --- HELPER 2: Add Custom File (Uses Selected Folder) ---
    def add_custom_tp_file(self):
        # 1. Ask for Name
        name = simpledialog.askstring("New Custom File", "File Name (e.g. 'Farming Route'):", parent=self.root)
        if not name: return

        # 2. Determine Folder based on Dropdown
        current_selection = self.custom_folder_var.get()
        base_dir = data.CUSTOM_TP_DIR
        
        if current_selection == "(Root)":
            target_dir = base_dir
        else:
            target_dir = os.path.join(base_dir, current_selection)
            
        os.makedirs(target_dir, exist_ok=True)
        
        filename = f"{name}.tps"
        path = os.path.join(target_dir, filename)

        if os.path.exists(path):
            messagebox.showerror("Error", "File already exists in this folder!")
            return

        # 3. Create Empty File
        with open(path, "w", encoding="utf-8") as f:
            f.write("") # Empty
            
        # 4. Refresh
        self.refresh_custom_tp_tab()

        # 5. Open it
        self._open_map_file_window(name, path, force_open=True)

    # --- HELPER 3: Scroll Region Calc ---
    def _recalc_custom_scrollregion(self):
        if not self.custom_canvas.winfo_exists(): return
        self.custom_canvas.update_idletasks()
        bbox = self.custom_canvas.bbox("all")
        if not bbox:
            self.custom_canvas.configure(scrollregion=(0,0,0,0))
            return
        self.custom_canvas.configure(scrollregion=bbox)              
    
    def _recalc_map_scrollregion(self):
        if not self.map_canvas.winfo_exists():
            return

        self.map_canvas.update_idletasks()
        bbox = self.map_canvas.bbox("all")

        if not bbox:
            self.map_canvas.configure(scrollregion=(0, 0, 0, 0))
            self.map_canvas.yview_moveto(0)
            return

        x1, y1, x2, y2 = bbox
        view_h = self.map_canvas.winfo_height()
        content_h = y2 - y1

        if content_h <= view_h:
            self.map_canvas.configure(scrollregion=(0, 0, x2, view_h))
            self.map_canvas.yview_moveto(0)
        else:
            self.map_canvas.configure(scrollregion=bbox)

    def start_map_tp_hotkey_listener(self):
        import win32gui

        def _gw2_focused():
            hwnd = win32gui.GetForegroundWindow()
            return hwnd and win32gui.GetWindowText(hwnd) == "Guild Wars 2"

        def _loop():
            user32 = ctypes.windll.user32
            was_down = False
            
            # STRICT Helper: Returns True ONLY if pressed mods match EXACTLY (Biarkan untuk fitur lain)
            def check_hk_strict(cfg):
                if not cfg: return False
                if isinstance(cfg, int):
                    if (user32.GetAsyncKeyState(cfg) & 0x8000):
                        if (user32.GetAsyncKeyState(0x10) & 0x8000) or \
                           (user32.GetAsyncKeyState(0x11) & 0x8000) or \
                           (user32.GetAsyncKeyState(0x12) & 0x8000):
                            return False
                        return True
                    return False
                
                if isinstance(cfg, dict):
                    main_key = cfg.get("key")
                    req_mods = set(cfg.get("mods", []))
                    if not (user32.GetAsyncKeyState(main_key) & 0x8000): return False
                    
                    pressed_mods = set()
                    if user32.GetAsyncKeyState(0x10) & 0x8000: pressed_mods.add(0x10)
                    if user32.GetAsyncKeyState(0x11) & 0x8000: pressed_mods.add(0x11)
                    if user32.GetAsyncKeyState(0x12) & 0x8000: pressed_mods.add(0x12)
                    
                    return pressed_mods == req_mods
                return False

            # LOOSE Helper: Mengabaikan extra modifiers! (KHUSUS UNTUK MAP TP)
            def check_hk_loose(cfg):
                if not cfg: return False
                
                if isinstance(cfg, int):
                    return (user32.GetAsyncKeyState(cfg) & 0x8000) != 0
                    
                if isinstance(cfg, dict):
                    main_key = cfg.get("key")
                    req_mods = cfg.get("mods", [])
                    
                    # 1. Pastikan tombol utama ditekan
                    if not main_key or not (user32.GetAsyncKeyState(main_key) & 0x8000): 
                        return False
                        
                    # 2. Pastikan modifier bawaan (jika ada) ditekan
                    for mod in req_mods:
                        if not (user32.GetAsyncKeyState(mod) & 0x8000):
                            return False
                            
                    # JIKA SAMPAI SINI: Tombol utama + modifier bawaan sudah ditekan.
                    # KITA MENGABAIKAN APABILA ADA MODIFIER EKSTRA SEPERTI ALT/CTRL!
                    return True
                return False

            while True:
                try:
                    # === MAP TELEPORT ===
                    # KITA GUNAKAN LOOSE CHECK DI SINI AGAR ALT & CTRL TEMBUS!
                    if self.map_click_tp_enabled.get():
                        if check_hk_loose(self.map_tp_hotkey) and not was_down:
                            was_down = True
                            print("[MapTP] Hotkey pressed (Loose Modifiers)")
                            pt = ctypes.wintypes.POINT()
                            user32.GetCursorPos(ctypes.byref(pt))
                            self.logic.teleport_from_map_click(pt.x, pt.y)

                    if not check_hk_loose(self.map_tp_hotkey):
                        was_down = False

                    # === CURSOR TELEPORT ===
                    if self.mouse_tp_active.get():
                        if check_hk_strict(self.mouse_tp_hotkey): # Tetap strict
                            print("[MouseTP] Hotkey pressed")
                            self.logic.teleport_from_cursor()
                            time.sleep(0.3)

                    time.sleep(0.02)
                    
                    # === TPS NAV HOTKEYS ===
                    if (
                        _gw2_focused()
                        and getattr(self, "active_tps_window", None)
                        and self.active_tps_window.winfo_exists()
                    ):
                        if check_hk_strict(self.tps_nav_hotkeys.get("next")): # Tetap strict
                            self._tps_manual_step(1)
                            time.sleep(0.20) 

                        if check_hk_strict(self.tps_nav_hotkeys.get("back")): # Tetap strict
                            self._tps_manual_step(-1)
                            time.sleep(0.20)

                except Exception as e:
                    print("[MapTP] ERROR:", e)
                    time.sleep(1)

        threading.Thread(target=_loop, daemon=True).start()
     
    def prompt_map_tp_hotkey(self):
        """
        Offers Manual Selection buttons to bypass detection issues.
        Also continues to poll for input as a backup.
        """
        dlg = tk.Toplevel(self.root)
        dlg.title("Configure Hotkey")
        # Increase size to fit buttons
        dlg.geometry(f"300x160+{self.root.winfo_x()+20}+{self.root.winfo_y()+20}")
        dlg.configure(bg="#121212")
        dlg.attributes("-topmost", True)
        
        lbl = tk.Label(dlg, text="Press Key or Select Preset:", fg="#00ff00", bg="#121212", font=("Segoe UI", 10))
        lbl.pack(pady=(10, 5))
        
        debug_lbl = tk.Label(dlg, text="Detected: ...", fg="#888", bg="#121212", font=("Consolas", 9))
        debug_lbl.pack(side=tk.BOTTOM, pady=5)

        # --- Manual Helper ---
        def set_manual(vk, name):
            self.map_tp_hotkey = {"mods": [], "key": vk, "text": name}
            self.saved_inputs["map_tp_hotkey"] = self.map_tp_hotkey
            
            if hasattr(self, "btn_map_hotkey"):
                self.btn_map_hotkey.config(text=name)
            
            self.save_settings()
            print(f"[UI] Manually Set Hotkey: {name} (VK: {vk})")
            self._hk_poll_active = False
            dlg.destroy()

        # --- Preset Grid ---
        grid_frame = tk.Frame(dlg, bg="#121212")
        grid_frame.pack(pady=10)
        
        btn_opts = {"bg": "#333", "fg": "#ddd", "relief": "flat", "width": 12, "font": ("Segoe UI", 8)}
        
        # Row 1
        tk.Button(grid_frame, text="Side 1 (X1)", command=lambda: set_manual(0x05, "Side 1"), **btn_opts).grid(row=0, column=0, padx=2, pady=2)
        tk.Button(grid_frame, text="Side 2 (X2)", command=lambda: set_manual(0x06, "Side 2"), **btn_opts).grid(row=0, column=1, padx=2, pady=2)
        
        # Row 2
        tk.Button(grid_frame, text="Middle Click", command=lambda: set_manual(0x04, "Middle"), **btn_opts).grid(row=1, column=0, padx=2, pady=2)
        tk.Button(grid_frame, text="Alt + T", command=lambda: set_manual(0x54, "Alt+T"), **btn_opts).grid(row=1, column=1, padx=2, pady=2)

        # --- Polling Logic (Background) ---
        MOUSE_MAP = {
            0x01: "Left", 0x02: "Right", 0x04: "Middle",
            0x05: "Side 1", 0x06: "Side 2",
            0xA6: "Back", 0xA7: "Fwd"
        }
        PRIORITY_KEYS = [0x05, 0x06, 0xA6, 0xA7, 0x04]

        self._hk_poll_active = True
        
        def poll_input():
            if not self._hk_poll_active or not dlg.winfo_exists(): return

            user32 = ctypes.windll.user32
            
            # 1. Modifiers
            mods = []
            mod_names = []
            if user32.GetAsyncKeyState(0x11) & 0x8000: mods.append(0x11); mod_names.append("Ctrl")
            if user32.GetAsyncKeyState(0x12) & 0x8000: mods.append(0x12); mod_names.append("Alt")
            if user32.GetAsyncKeyState(0x10) & 0x8000: mods.append(0x10); mod_names.append("Shift")
            
            detected_vk = None
            detected_name = ""

            # 2. Priority Check
            for vk in PRIORITY_KEYS:
                if user32.GetAsyncKeyState(vk) & 0x8000:
                    detected_vk = vk
                    detected_name = MOUSE_MAP.get(vk, "Mouse")
                    break

            # 3. Standard Check
            if not detected_vk:
                for vk in range(8, 255): # Skip Mouse 1-7 in this loop
                    if vk in [0x10, 0x11, 0x12, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5]: continue
                    if vk in PRIORITY_KEYS: continue
                    
                    if user32.GetAsyncKeyState(vk) & 0x8000:
                        detected_vk = vk
                        if 0x30 <= vk <= 0x5A: detected_name = chr(vk)
                        elif 0x70 <= vk <= 0x87: detected_name = f"F{vk - 0x6F}"
                        else: detected_name = f"Key_{vk:02X}"
                        break
            
            # 4. Save
            if detected_vk:
                debug_lbl.config(text=f"Detected: {detected_name} ({detected_vk})")
                
                # If we detect 'L', we just show it but wait for release or confirmation
                # to prevent instant mis-binding if user is holding the mouse button.
                # But for now, let's just save it like before.
                
                full_text = "+".join(mod_names + [detected_name])
                self.map_tp_hotkey = {"mods": mods, "key": detected_vk, "text": full_text}
                self.saved_inputs["map_tp_hotkey"] = self.map_tp_hotkey
                
                if hasattr(self, "btn_map_hotkey"):
                    self.btn_map_hotkey.config(text=full_text)
                
                self.save_settings()
                print(f"[UI] Detected: {full_text} (VK: {detected_vk})")
                
                self._hk_poll_active = False
                dlg.destroy()
                return

            dlg.after(15, poll_input)

        dlg.after(100, poll_input)
        dlg.focus_force()
    
    def prompt_mouse_tp_hotkey(self):
        """Dedicated hotkey configurator that waits for key release to prevent instant TP."""
        dlg = tk.Toplevel(self.root)
        dlg.title("Cursor TP Hotkey")
        dlg.geometry(f"300x120+{self.root.winfo_x()+20}+{self.root.winfo_y()+20}")
        dlg.configure(bg="#121212")
        dlg.attributes("-topmost", True)
        dlg.grab_set() # Block main UI interaction
        
        lbl = tk.Label(dlg, text="Press Key for Cursor TP...", fg="#00aaff", bg="#121212", font=("Segoe UI", 10, "bold"))
        lbl.pack(expand=True)
        
        self._hk_poll_active = True
        
        def poll_input():
            if not self._hk_poll_active or not dlg.winfo_exists(): return
            user32 = ctypes.windll.user32
            
            # 1. Detect standard keys (Skip modifiers to allow pure keys)
            for vk in range(4, 255): 
                if vk in [0x10, 0x11, 0x12]: continue # Skip Ctrl/Alt/Shift
                
                if user32.GetAsyncKeyState(vk) & 0x8000:
                    name = chr(vk) if 0x30 <= vk <= 0x5A else f"Key_{vk:02X}"
                    if 0x70 <= vk <= 0x87: name = f"F{vk - 0x6F}"
                    
                    # 2. Key detected! Stop polling and update label
                    self._hk_poll_active = False
                    lbl.config(text=f"RELEASE {name} TO SAVE", fg="#ffaa00")
                    
                    # 3. Wait for release to prevent instant teleport trigger
                    def wait_for_release():
                        if user32.GetAsyncKeyState(vk) & 0x8000:
                            dlg.after(10, wait_for_release)
                        else:
                            # 4. Finalize Save
                            self.mouse_tp_hotkey = {"mods": [], "key": vk, "text": name}
                            self.saved_inputs["mouse_tp_hotkey"] = self.mouse_tp_hotkey
                            self.btn_mouse_tp_hk.config(text=name)
                            self.save_settings()
                            print(f"[UI] Saved Cursor Hotkey: {name}")
                            dlg.destroy()
                    
                    dlg.after(10, wait_for_release)
                    return
                    
            dlg.after(15, poll_input)
            
        dlg.after(100, poll_input)
        
    def _build_tab_map_teleports(self, parent):
        top = parent.winfo_toplevel()
        if not hasattr(top, "_map_f5_bound"):
            top.bind("<F5>", lambda e: self.refresh_map_tp_tab())
            top._map_f5_bound = True
            
        # --- 1. SEARCH AREA CONTAINER ---
        top_container = tk.Frame(parent, bg="#1e1e1e", pady=3)
        top_container.pack(fill=tk.X, side=tk.TOP)

        # Left Side: Search Bars
        search_frame = tk.Frame(top_container, bg="#1e1e1e")
        search_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5)

        # Helper to create high-visibility rows
        def create_search_row(parent_frame, icon, text_var, placeholder_color):
            row = tk.Frame(parent_frame, bg="#1e1e1e", pady=1)
            row.pack(fill=tk.X)

            # ICON LABEL
            lbl = tk.Label(
                row,
                text=icon,
                bg="#1e1e1e",
                fg="#ffffff",
                font=("Segoe UI", 8),   
                width=6,               
                anchor="w"
            )
            lbl.pack(side=tk.LEFT)

            # ENTRY BOX
            ent = tk.Entry(
                row,
                textvariable=text_var,
                bg="#333333",
                fg=placeholder_color,
                insertbackground="white",
                relief="flat",
                font=("Segoe UI", 9)
            )
            ent.pack(side=tk.LEFT, fill=tk.X, expand=True)

            # CLEAR BUTTON (X inside row)
            def clear_search():
                text_var.set("")          # instantly clear
                self.refresh_map_tp_tab() # force refresh

            clear_btn = tk.Label(
                row,
                text="✖",
                bg="#1e1e1e",
                fg="#888",
                font=("Segoe UI", 9),
                cursor="hand2",
                width=2
            )
            clear_btn.pack(side=tk.RIGHT, padx=(5, 0))
            clear_btn.bind("<Button-1>", lambda e: clear_search())

            # underline
            frame_border = tk.Frame(row, bg="#555555", height=1)
            frame_border.pack(side=tk.BOTTOM, fill=tk.X, pady=(2, 0))
    
        # Create the 3 Search Bars
        self.map_folder_search = tk.StringVar()
        self.map_group_search = tk.StringVar()
        self.map_tp_search = tk.StringVar()

        create_search_row(search_frame, "⌕ Dir",  self.map_folder_search, "#00aaff")
        create_search_row(search_frame, "⌕ File", self.map_group_search, "#ffffff")
        create_search_row(search_frame, "⌕ TP",   self.map_tp_search,    "#00ff00")

        # Bind Search Updates
        self.map_folder_search.trace_add("write", lambda *_: self.refresh_map_tp_tab())
        self.map_group_search.trace_add("write", lambda *_: self.refresh_map_tp_tab())
        self.map_tp_search.trace_add("write", lambda *_: self.refresh_map_tp_tab())

        # Right Side: Buttons
        btn_frame = tk.Frame(top_container, bg="#1e1e1e")
        btn_frame.pack(side=tk.RIGHT, padx=5, anchor="n")
        
        # --- LOGIC: CLEAR & REFRESH ---
        def clear_all_and_refresh():
            # Clear all search boxes
            self.map_folder_search.set("")
            self.map_group_search.set("")
            self.map_tp_search.set("")
            # Trigger refresh
            self.refresh_map_tp_tab()

        def toggle_map_edit():
            self.tp_edit_mode.set(not self.tp_edit_mode.get())
            update_btns()
            self.refresh_map_tp_tab()

        # 1. EDIT BUTTON
        self.btn_map_edit = tk.Button(
            btn_frame,
            image=self.icons["edit"],
            bg="#1e1e1e",
            activebackground="#333333",
            relief="flat",
            bd=0,
            padx=1,
            pady=1,
            cursor="hand2",
            command=toggle_map_edit
        )
        self.btn_map_edit.image = self.icons["edit"] # keep ref
        self.btn_map_edit.pack(side=tk.TOP, pady=1)
        
        # 2. REFRESH BUTTON (Integrated Clear)
        tk.Button(
            btn_frame,
            image=self.icons["refresh"],
            bg="#1e1e1e",
            activebackground="#333333",
            relief="flat",
            bd=0,
            cursor="hand2",
            command=clear_all_and_refresh
        ).pack(side=tk.TOP, pady=1)
        
        # 3. ADD BUTTON (Styled identical to others)
        self.btn_new_file = tk.Button(
            btn_frame, 
            image=self.icons["add"],
            bg="#1e1e1e",
            activebackground="#FFFFFF",
            relief="flat",
            bd=0,
            padx=1,
            pady=1,
            cursor="hand2",
            command=self.add_map_tp
        )
        self.btn_new_file.image = self.icons["add"] # keep ref
        self.btn_new_file.pack(side=tk.TOP, pady=1)

        def update_btns():
            state = tk.NORMAL if self.tp_edit_mode.get() else tk.DISABLED
            self.btn_new_file.config(state=state)

        update_btns()

        # Status Label
        self.map_tp_status_lbl = tk.Label(parent, text="Searching...", bg="#121212", fg="#888", font=("Segoe UI", 9))
        self.map_tp_status_lbl.pack(pady=(2, 3))
        
        def update_map_status():
            if not parent.winfo_exists(): return
            if self.logic.map_ready:
                name = self.logic.get_map_name()
                self.map_tp_status_lbl.config(text=f"Current Map: {name}", fg="#00ff00")
                
                if name != self._last_map_name:
                    self._last_map_name = name
                    self.refresh_map_tp_tab()
            else:
                self.map_tp_status_lbl.config(text="Searching...", fg="#888")
                self._last_map_name = None
            parent.after(1000, update_map_status)

        # --- 2. SCROLLABLE LIST CONTAINER ---
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True)

        self.map_canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        
        style = ttk.Style()
        style.configure("Vertical.TScrollbar", background="#444444", troughcolor="#222222")
        scroll = ttk.Scrollbar(list_container, orient=tk.VERTICAL, command=self.map_canvas.yview, style="Vertical.TScrollbar")
        
        scroll.pack(side=tk.RIGHT, fill=tk.Y)
        self.map_canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        self.map_canvas.configure(yscrollcommand=scroll.set)
        
        self.map_tp_frame = tk.Frame(self.map_canvas, bg="#121212")
        cw = self.map_canvas.create_window((0, 0), window=self.map_tp_frame, anchor="nw")
        
        self.map_canvas.bind(
            "<Configure>",
            lambda e: self.map_canvas.itemconfig(cw, width=e.width)
        )
              
        self.map_tp_frame.bind("<Configure>", lambda e: self._recalc_map_scrollregion())
        
        def _on_mousewheel(e):
            try:
                if not self.map_canvas or not self.map_canvas.winfo_exists():
                    return

                first, last = self.map_canvas.yview()
                delta = int(-1 * (e.delta / 120))

                if first <= 0 and delta < 0:
                    return
                if last >= 1 and delta > 0:
                    return

                self.map_canvas.yview_scroll(delta, "units")

            except tk.TclError:
                # canvas already destroyed → ignore safely
                return
                      
        self._map_scroll_restored = False
        update_map_status()
        self.refresh_map_tp_tab()
        self.root.after(0, self._recalc_map_scrollregion)

     
    def _build_tab_events(self, parent):
        parent._event_rows = []

        # ── Filter bar ────────────────────────────────────────────────────────
        filter_bar = tk.Frame(parent, bg="#1a1a1a")
        filter_bar.pack(fill=tk.X, padx=4, pady=(4, 0))

        # Search box
        search_var = tk.StringVar()
        search_entry = tk.Entry(
            filter_bar, textvariable=search_var,
            bg="#2a2a2a", fg="#dddddd", insertbackground="white",
            relief="flat", font=("Segoe UI", 9), width=18
        )
        search_entry.pack(side=tk.LEFT, padx=(0, 4), ipady=3)
        tk.Label(filter_bar, text="🔍", bg="#1a1a1a", fg="#888",
                font=("Segoe UI", 9)).place(in_=search_entry, relx=1.0, rely=0.5,
                                            anchor="e", x=-4)

        # Active-only toggle
        active_only_var = tk.BooleanVar(value=False)
        tk.Checkbutton(
            filter_bar, text="Active", variable=active_only_var,
            bg="#1a1a1a", fg="#aaaaaa", selectcolor="#1a1a1a",
            activebackground="#1a1a1a", activeforeground="white",
            font=("Segoe UI", 8)
        ).pack(side=tk.LEFT, padx=4)

        # Max distance filter
        tk.Label(filter_bar, text="≤", bg="#1a1a1a",
                fg="#888", font=("Segoe UI", 9)).pack(side=tk.LEFT)
        dist_var = tk.StringVar(value="")
        dist_entry = tk.Entry(
            filter_bar, textvariable=dist_var,
            bg="#2a2a2a", fg="#dddddd", insertbackground="white",
            relief="flat", font=("Segoe UI", 9), width=6
        )
        dist_entry.pack(side=tk.LEFT, ipady=3)
        tk.Label(filter_bar, text="m", bg="#1a1a1a",
                fg="#888", font=("Segoe UI", 8)).pack(side=tk.LEFT, padx=(1, 4))

        # Status label + refresh
        self._event_status_var = tk.StringVar(value="")
        tk.Label(filter_bar, textvariable=self._event_status_var,
                bg="#1a1a1a", fg="#666", font=("Segoe UI", 7)).pack(side=tk.LEFT)

        tk.Button(
            filter_bar, text="⟳", bg="#1a1a1a", fg="#aaa",
            activeforeground="white", relief="flat", cursor="hand2",
            font=("Segoe UI", 10),
            command=lambda: self._refresh_event_tab(parent)
        ).pack(side=tk.RIGHT, padx=2)

        def _debug_ipc():
            if not self.logic:
                return
            try:
                ents = core.shared_entities.read_entities() if hasattr(core, 'shared_entities') and core.shared_entities else []
                print(f"[EventDebug] Total IPC entities: {len(ents)}")
                # Show ALL non-player entities with their attitude
                for e in ents:
                    if e.get("type") != 0:  # skip players
                        print(f"  type={e.get('type')} att={e.get('raw_attitude')} "
                            f"name={e.get('real_name','?')[:30]} "
                            f"x={e.get('x',0):.0f} z={e.get('z',0):.0f}")
                # Also show current map events from DB
                mid = self.logic.current_map_id
                with EventDetector._db_lock:
                    evs = EventDetector._event_db.get(int(mid), [])
                culls = [ev for ev in evs if 'cull' in ev.get('name','').lower()]
                print(f"[EventDebug] 'Cull' events for map {mid}:")
                for ev in culls:
                    print(f"  cx={ev['cx_m']:.0f} cz={ev['cz_m']:.0f} r={ev['radius_m']:.0f} name={ev['name']}")
            except Exception as ex:
                import traceback; traceback.print_exc()

        tk.Button(
            filter_bar, text="dbg", bg="#1a1a1a", fg="#666",
            relief="flat", font=("Segoe UI", 7),
            command=_debug_ipc
        ).pack(side=tk.RIGHT, padx=2)

        # ── Scrollable list ───────────────────────────────────────────────────
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True, padx=2, pady=(2, 2))

        canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        scrollbar = ttk.Scrollbar(list_container, orient=tk.VERTICAL,
                                command=canvas.yview)
        scroll_frame = tk.Frame(canvas, bg="#121212")

        canvas_win = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")
        canvas.bind("<Configure>",
                    lambda e: canvas.itemconfig(canvas_win, width=e.width))
        scroll_frame.bind("<Configure>",
                        lambda e: canvas.configure(
                            scrollregion=canvas.bbox("all")))
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        def _mw(e):
            if canvas.winfo_exists():
                canvas.yview_scroll(int(-1 * (e.delta / 120)), "units")
        scroll_frame.bind("<Enter>",  lambda _: canvas.bind_all("<MouseWheel>", _mw))
        scroll_frame.bind("<Leave>",  lambda _: canvas.unbind_all("<MouseWheel>"))

        parent._event_scroll_frame = scroll_frame
        parent._event_canvas       = canvas
        parent._event_search_var   = search_var
        parent._event_active_var   = active_only_var
        parent._event_dist_var     = dist_var

        # Trigger refresh on filter changes
        def _on_filter(*_):
            self._refresh_event_tab(parent)

        search_var.trace_add("write", _on_filter)
        active_only_var.trace_add("write", _on_filter)
        dist_var.trace_add("write", _on_filter)

        self._refresh_event_tab(parent)

        def _auto():
            try:
                if parent.winfo_exists():
                    self._refresh_event_tab(parent)
                    parent.after(30000, _auto)
            except Exception:
                pass
        parent.after(15000, _auto)

    def _refresh_event_tab(self, parent):
        if not hasattr(parent, "_event_scroll_frame"):
            return
        try:
            if not parent._event_scroll_frame.winfo_exists():
                return
        except Exception:
            return
        try:
            parent._event_scroll_frame.unbind_all("<MouseWheel>")
        except Exception:
            pass
        for w in parent._event_scroll_frame.winfo_children():
            w.destroy()

        if not self.logic:
            return

        if not self.logic.is_event_db_ready():
            tk.Label(parent._event_scroll_frame,
                    text="⏳ Building event database...\n(First run only)",
                    bg="#121212", fg="#888", font=("Segoe UI", 9),
                    justify="center").pack(pady=20)
            self._event_status_var.set("loading...")
            parent.after(3000, lambda: self._refresh_event_tab(parent))
            return

        # ── Get events ────────────────────────────────────────────────────────
        all_events = []
        try:
            all_events = self.logic.get_active_events()
        except Exception as e:
            print(f"[EventTab] {e}")
            import traceback; traceback.print_exc()

        # ── Apply filters ─────────────────────────────────────────────────────
        query      = getattr(parent, "_event_search_var",  tk.StringVar()).get().lower().strip()
        active_only = getattr(parent, "_event_active_var", tk.BooleanVar()).get()
        dist_str   = getattr(parent, "_event_dist_var",    tk.StringVar()).get().strip()
        max_dist   = None
        try:
            if dist_str:
                max_dist = float(dist_str)
        except ValueError:
            pass

        DISPLAY_LIMIT = 40

        filtered = []
        for ev in all_events:
            if active_only and not ev.get("likely_active"):
                continue
            if max_dist is not None and ev.get("dist_m", 999999) > max_dist:
                continue
            if query:
                name_match = query in ev.get("name", "").lower()
                npc_match  = any(query in n.lower()
                                for n in ev.get("matched_npcs", []))
                if not name_match and not npc_match:
                    continue
            filtered.append(ev)

        total      = len(all_events)
        shown      = min(len(filtered), DISPLAY_LIMIT)
        active_cnt = sum(1 for e in all_events if e.get("likely_active"))
        self._event_status_var.set(
            f"{shown}/{total} shown  •  {active_cnt} active  •  map {self.logic.current_map_id}"
        )

        if not filtered:
            tk.Label(parent._event_scroll_frame,
                    text="No events match the current filter.",
                    bg="#121212", fg="#555",
                    font=("Segoe UI", 9)).pack(pady=20)
            return

        # ── Render rows (click to TP) ─────────────────────────────────────────
        for ev in filtered[:DISPLAY_LIMIT]:
            name          = ev.get("name", f"[{ev['guid'][:8]}]")
            likely_active = ev.get("likely_active", False)
            dist_m        = ev.get("dist_m", 999999)
            matched_npcs  = ev.get("matched_npcs", [])
            has_loc       = ev.get("cx_m") is not None

            # Color strip
            if likely_active:
                strip_col = "#00ff66"
            elif dist_m < 500:
                strip_col = "#ffcc00"
            else:
                strip_col = "#383838"

            row = tk.Frame(parent._event_scroll_frame, bg="#1e1e1e",
                        cursor="hand2" if has_loc else "arrow")
            row.pack(fill=tk.X, pady=1)

            tk.Frame(row, width=4, bg=strip_col).pack(side=tk.LEFT, fill=tk.Y)

            text_block = tk.Frame(row, bg="#1e1e1e")
            text_block.pack(side=tk.LEFT, fill=tk.BOTH, expand=True,
                            padx=(6, 6), pady=3)

            tk.Label(
                text_block, text=name, bg="#1e1e1e",
                fg="#ffffff" if likely_active else "#cccccc",
                font=("Segoe UI", 9, "bold" if likely_active else "normal"),
                anchor="w", wraplength=300, justify="left"
            ).pack(anchor="w")

            # Sub-line: distance + matched NPC
            sub_parts = []
            if dist_m < 999999:
                sub_parts.append(f"{dist_m:.0f}m away")
            if likely_active and matched_npcs:
                npc_str = matched_npcs[0].get("name", "?")  # was matched_npcs[0] directly
                if len(matched_npcs) > 1:
                    npc_str += f" +{len(matched_npcs)-1}"
                sub_parts.append(npc_str)
            if sub_parts:
                tk.Label(
                    text_block, text="  •  ".join(sub_parts),
                    bg="#1e1e1e",
                    fg="#00cc55" if likely_active else "#555555",
                    font=("Segoe UI", 7), anchor="w"
                ).pack(anchor="w")

            # Click whole row to TP
            if has_loc:
                def _tp(e, ev=ev):
                    ok, msg = self.logic.teleport_to_event(ev)
                    if not ok:
                        from tkinter import messagebox
                        messagebox.showerror("Event TP", msg)

                row.bind("<Button-1>",       _tp)
                text_block.bind("<Button-1>", _tp)
                for child in text_block.winfo_children():
                    child.bind("<Button-1>", _tp)

                color_strip_frame = tk.Frame(row, width=4, bg=strip_col)
                color_strip_frame.pack(side=tk.LEFT, fill=tk.Y)
                # Hover highlight
                def _enter(e, r=row, strip=color_strip_frame):
                    r.config(bg="#2a2a2a")
                    for c in r.winfo_children():
                        try:
                            if c is not strip:
                                c.config(bg="#2a2a2a")
                        except Exception:
                            pass

                def _leave(e, r=row, strip=color_strip_frame, col=strip_col):
                    r.config(bg="#1e1e1e")
                    for c in r.winfo_children():
                        try:
                            if c is not strip:
                                c.config(bg="#1e1e1e")
                            else:
                                c.config(bg=col)  # restore strip color
                        except Exception:
                            pass

                row.bind("<Enter>", _enter)
                row.bind("<Leave>", _leave)

        if len(filtered) > DISPLAY_LIMIT:
            tk.Label(
                parent._event_scroll_frame,
                text=f"… {len(filtered) - DISPLAY_LIMIT} more — refine your search",
                bg="#121212", fg="#555", font=("Segoe UI", 8)
            ).pack(pady=4)


    def _do_event_teleport(self, event_entry):
        """Called when user clicks TP on an event row."""
        if not self.logic:
            return
        ok, msg = self.logic.teleport_to_event(event_entry)
        if not ok:
            from tkinter import messagebox
            messagebox.showerror("Event Teleport", msg)
                
    def get_current_map_name(self):
        """
        Unified map-name resolver.
        Uses the same API-backed logic as Global tab.
        """
        try:
            name = self.logic.get_map_name()
            if name:
                return name.replace(":", "").strip()
        except Exception:
            pass
        return None

    def on_close(self):
        try:
            if self.logic and self.logic.auto_tp_running:
                self.logic.stop_auto_teleport()

            # 🔒 Safe unbind (canvas may already be destroyed)
            try:
                if self.map_canvas and self.map_canvas.winfo_exists():
                    self.map_canvas.unbind("<MouseWheel>")
            except tk.TclError:
                pass

            self._force_stop_macro("A")
            self._force_stop_macro("B")

        except Exception:
            pass

        # ❗ Close ONLY the TPS / Map window
        try:
            if hasattr(self, "active_tps_window") and self.active_tps_window:
                self.active_tps_window.destroy()
                self.active_tps_window = None
        except:
            pass

    
    def refresh_map_tp_tab(self):
        if not hasattr(self, "map_canvas") or not self.map_canvas.winfo_exists():
            return
            
        self.map_canvas.yview_moveto(0)
        self.map_canvas.update_idletasks()
        current_map_name = self.logic.get_map_name() or ""

        if not hasattr(self, "map_tp_frame") or not self.map_tp_frame.winfo_exists():
            return

        for w in self.map_tp_frame.winfo_children():
            w.destroy()
            
        base_dir = os.path.join(os.path.dirname(__file__), "teleports", "maps")
        
        # --- SCROLL HELPER ---
        def bind_scroll(widget):
            def _scroll(e):
                try: self.map_canvas.yview_scroll(int(-1*(e.delta/120)), "units")
                except: pass
            widget.unbind("<MouseWheel>")
            widget.bind("<MouseWheel>", _scroll)
            for child in widget.winfo_children(): bind_scroll(child)

        # =========================================================
        # 1. DISCOVERY PHASE
        # Find all folders and files relevant to the current map
        # =========================================================
        
        # Structure: { folder_path: {'show_all': Bool, 'files': [list_of_filenames]} }
        render_targets = {}
        
        norm_map = self._normalize_map_name(current_map_name) if current_map_name else ""
        
        search_folder_query = self.map_folder_search.get().lower().strip()
        search_file_query = self.map_group_search.get().lower().strip()
        search_tp_query = self.map_tp_search.get().lower().strip()
        
        is_manual_search = bool(search_folder_query or search_file_query)

        if os.path.exists(base_dir):
            for root, dirs, files in os.walk(base_dir):
                folder_name = os.path.basename(root)
                norm_folder = self._normalize_map_name(folder_name)
                norm_root = self._normalize_map_name(root)
                is_inside_map_folder = bool(norm_map and norm_map in norm_root)
                
                # A. CHECK FOLDER MATCH (PATH-BASED)
                # If this folder is inside the current map folder -> show ALL files
                is_map_folder = False
                if not is_manual_search and is_inside_map_folder:
                    is_map_folder = True
                    if root not in render_targets:
                        render_targets[root] = {'show_all': True, 'files': []}
                    render_targets[root]['show_all'] = True

                if search_folder_query and search_folder_query in folder_name.lower():
                     if root not in render_targets: render_targets[root] = {'show_all': True, 'files': []}

                # B. CHECK FILE MATCH (Cross-Folder)
                # If a file INSIDE this folder matches Map Name -> Show ONLY that file
                for f in files:
                    if not f.lower().endswith(('.tps', '.json')): continue
                    
                    norm_file = self._normalize_map_name(f)
                    should_include = False
                    
                    # Logic: If we are not manually searching, and the file matches the map
                    if not is_manual_search and norm_map and norm_map in norm_file:
                        should_include = True
                    
                    # Logic: Manual Search overrides
                    if search_file_query and search_file_query in f.lower():
                        should_include = True
                        
                    if should_include:
                        if root not in render_targets: 
                            render_targets[root] = {'show_all': False, 'files': []}
                        
                        # Only add if not already showing all (or if we need to track specific matches)
                        if f not in render_targets[root]['files']:
                            render_targets[root]['files'].append(f)

        # Handle "No Map" state (Show everything if map is 0 and no search)
        if not current_map_name and not is_manual_search:
             for root, dirs, files in os.walk(base_dir):
                 render_targets[root] = {'show_all': True, 'files': []}

        # =========================================================
        # 2. RENDER PHASE
        # =========================================================
        
        # Sort folders to keep UI stable
        sorted_roots = sorted(render_targets.keys())

        for root in sorted_roots:
            data = render_targets[root]
            folder_name = os.path.basename(root)
            
            # --- LOGIC: EXTRACTION (SIBLINGS) ---
            # If this is a main map folder, we might want to extract "Achievements" 
            # to be a top-level sibling instead of a nested child.
            extracted_subfolders = []
            
            if data['show_all']:
                try:
                    # Look for subdirectories to extract
                    for item in os.listdir(root):
                        full_path = os.path.join(root, item)
                        if os.path.isdir(full_path):
                            # If it's an Achievement folder, we extract it
                            if "achievement" in item.lower():
                                extracted_subfolders.append(full_path)
                except: pass

            # --- RENDER MAIN FOLDER SECTION ---
            # Only create section if there are files to show OR if it's a main map match
            valid_files = [f for f in os.listdir(root) if f.endswith(('.tps','.json'))]
            if not data['show_all']:
                valid_files = [f for f in valid_files if f in data['files']]
            
            if valid_files or data['show_all']:
                section, content = self._create_collapsible_section(
                    self.map_tp_frame,
                    f"{folder_name}",
                    start_open=True,
                    unique_id=root
                )
                section.pack(fill=tk.X, pady=(10, 2))
                bind_scroll(section)

                # Render Files
                valid_files.sort()
                for fname in valid_files:
                    path = os.path.join(root, fname)
                    group_name = os.path.splitext(fname)[0]
                    
                    # Load & Filter TPs inside the file
                    teleports = self._load_map_file(path)
                    if search_tp_query:
                        teleports = [tp for tp in teleports if search_tp_query in tp["name"].lower()]
                        if not teleports: continue
                    
                    # Indent the files slightly (padx=15 in pack)
                    grp_widget = self._create_map_tp_group(content, group_name, teleports, path)
                    grp_widget.pack(fill=tk.X, pady=1, padx=10) # <--- INDENTATION ADDED HERE
                    bind_scroll(grp_widget)
                    
                # If we showed this folder because of "Show All" but it has subfolders (not extracted)
                # We should technically recurse, but for this specific "Flat + Extracted" view,
                # we usually only care about the files. 
                # (Standard recursive rendering omitted for clarity in this specific 'Map View' mode)

            # --- RENDER EXTRACTED SIBLINGS (Achievements) ---
            for sub_path in extracted_subfolders:
                sub_name = os.path.basename(sub_path)
                display_title = f"{folder_name} - {sub_name}"
                
                sub_section, sub_content = self._create_collapsible_section(
                    self.map_tp_frame,
                    display_title,
                    start_open=True,
                    unique_id=sub_path
                )
                sub_section.pack(fill=tk.X, pady=(5, 2))
                bind_scroll(sub_section)
                
                # Render files inside the subfolder
                for fname in sorted(os.listdir(sub_path)):
                    if not fname.endswith(('.tps', '.json')): continue
                    path = os.path.join(sub_path, fname)
                    group_name = os.path.splitext(fname)[0]
                    
                    teleports = self._load_map_file(path)
                    if search_tp_query:
                        teleports = [tp for tp in teleports if search_tp_query in tp["name"].lower()]
                        if not teleports: continue

                    grp_widget = self._create_map_tp_group(sub_content, group_name, teleports, path)
                    grp_widget.pack(fill=tk.X, pady=1, padx=10) # Indent
                    bind_scroll(grp_widget)

        if not sorted_roots and current_map_name:
             tk.Label(self.map_tp_frame, text=f"No files found for\n{current_map_name}", bg="#121212", fg="#666").pack(pady=20)

        # Restore Scroll Position
        if not self._map_scroll_restored and "map_tab_scroll" in self.saved_inputs:
            try:
                target_pos = float(self.saved_inputs["map_tab_scroll"])
                self.root.after(100, lambda: self.map_canvas.yview_moveto(target_pos))
                self._map_scroll_restored = True
            except: pass
    
    def _load_remainder(self, parent_frame, remaining_items, start_idx, total, path, dialog_win):
        # Remove the "Load More" button (it's the last widget)
        children = parent_frame.winfo_children()
        if children:
            children[-1].destroy()
        
        # Load the rest (Warning: This might still lag for huge lists, but user asked for it)
        for i, tp in enumerate(remaining_items):
            self._create_tp_row(
                parent_frame=parent_frame,
                tp=tp,
                index=start_idx + i,
                total=total,
                refresh_cb=self.refresh_map_tp_tab,
                dialog_parent=dialog_win,
                delete_cb=lambda t=tp: self.delete_map_tp(path, t) 
            )
    
    def _create_map_tp_group(self, parent, group_name, teleports, path):
        # 1. Main Group Container
        group_frame = tk.Frame(parent, bg="#121212")
        group_frame.pack(fill=tk.X, pady=1)

        # 2. Header Frame (Acts as a Button)
        header_frame = tk.Frame(group_frame, bg="#333333", height=28)
        header_frame.pack(fill=tk.X)
        header_frame.pack_propagate(False)

        count = len(teleports)

        lbl = tk.Label(
            header_frame,
            text=f"{group_name}   [{count}]", # Keep names only
            bg="#1e1e1e",
            fg="#ffffff",
            font=("Segoe UI", 9),
            anchor="w",
            cursor="hand2"
        )
        # Left padding reduced to 2 (barely visible)
        lbl.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(2, 5))

        # CLICK ACTION -> Open New Window
        def open_window(event=None):
            self._open_map_file_window(group_name, path)

        header_frame.bind("<Button-1>", open_window)
        lbl.bind("<Button-1>", open_window)

        # 3. EDIT MODE ACTIONS
        if self.tp_edit_mode.get():
            
            # --- ACTION: DELETE FILE ---
            def delete_file():
                filename = os.path.basename(path)
                if messagebox.askyesno(
                    "Confirm Delete", 
                    f"Are you sure you want to delete this file?\n\n{filename}", 
                    parent=parent.winfo_toplevel()
                ):
                    try:
                        os.remove(path)
                        # Refresh UI to remove the deleted group
                        self.refresh_map_tp_tab()
                    except Exception as e:
                        messagebox.showerror("Delete Error", str(e))

            # --- ACTION: RENAME FILE ---
            def rename_file():
                old_name = group_name
                new_name = simpledialog.askstring(
                    "Rename File", 
                    f"Rename '{old_name}' to:", 
                    initialvalue=old_name,
                    parent=parent.winfo_toplevel()
                )
                
                if not new_name or new_name == old_name: return

                dir_name = os.path.dirname(path)
                extension = os.path.splitext(path)[1]
                new_filename = f"{new_name}{extension}"
                new_path = os.path.join(dir_name, new_filename)

                try:
                    if os.path.exists(new_path):
                        messagebox.showerror("Error", "A file with that name already exists.")
                        return
                    
                    os.rename(path, new_path)
                    # Refresh UI to show new name
                    self.refresh_map_tp_tab()
                except Exception as e:
                    messagebox.showerror("Rename Error", str(e))

            # --- PACK BUTTONS (Right Side) ---
            # Note: We pack Delete first (Rightmost), then Rename (Left of Delete)
            
            # DELETE BUTTON (🗑)
            tk.Button(
                header_frame, 
                text="🗑", 
                bg="#444444", 
                fg="#ff6666", # Slight red tint for warning 
                relief="flat", 
                font=("Segoe UI", 8), 
                command=delete_file
            ).pack(side=tk.RIGHT, padx=(2, 5), pady=2)

            # RENAME BUTTON (✎)
            tk.Button(
                header_frame, 
                text="✎", 
                bg="#444444", 
                fg="white", 
                relief="flat", 
                font=("Segoe UI", 8), 
                command=rename_file
            ).pack(side=tk.RIGHT, padx=0, pady=2)
            
        return group_frame
    
    def add_map_tp(self):
        pos = self.logic.read_live_coords()
        if not pos: return

        name = simpledialog.askstring("New Teleport", "Teleport name:")
        if not name: return

        map_name = self.get_current_map_name()
        if not map_name: return

        folder = self._find_map_folder(map_name)

        if not folder:
            folder = os.path.join(os.path.dirname(__file__), "teleports", "maps", map_name.replace(":", "").strip())
            os.makedirs(folder, exist_ok=True)

        # UPDATED: Default to .tps
        path = os.path.join(folder, "New Group.tps")

        tps = self._load_map_file(path) # Load existing if it happens to exist
        
        tps.append({
            "name": name,
            "x": pos[0], "y": pos[1], "z": pos[2],
            "map_id": self.current_map_id,
            "allow_cross_map": True
        })

        self._save_map_file(path, tps)
        self.refresh_map_tp_tab()
    
    def delete_map_tp(self, path, tp_to_delete):
        try:
            # UPDATED: Use helpers
            data = self._load_map_file(path)
            
            # Find and remove
            found_idx = -1
            search_name = tp_to_delete.get("name", "").lower()
            search_x = tp_to_delete.get("x", 0)

            for i, item in enumerate(data):
                i_name = item.get("name", "").lower()
                i_x = item.get("x", 0)
                
                # Match roughly
                if i_name == search_name and abs(float(i_x) - float(search_x)) < 0.1:
                    found_idx = i
                    break
            
            if found_idx != -1:
                del data[found_idx]
                self._save_map_file(path, data)

        except Exception as e:
            print(f"Delete failed: {e}")

    def sync_current_map_teleports(self):
        pos = self.logic.read_live_coords()
        if not pos: return

        map_name = self.get_current_map_name()
        
        # Use the smart finder
        folder = self._find_map_folder(map_name)
        
        # If no folder exists, there is nothing to sync
        if not folder or not os.path.exists(folder):
            return

        for f in os.listdir(folder):
            if not f.endswith(".json"): continue

            path = os.path.join(folder, f)
            try:
                tps = json.load(open(path))
                for tp in tps:
                    tp["x"], tp["y"], tp["z"] = pos
                json.dump(tps, open(path, "w"), indent=2)
            except: pass

        self.refresh_map_tp_tab()

    def _build_tab_auto_teleport(self, parent):
        # --- LOAD SAVED STATE ---
        saved = self.saved_inputs
        
        self.auto_tp_loop.set(saved.get("auto_tp_loop", False))
        self.auto_tp_loop_count.set(saved.get("auto_tp_loop_count", ""))
        self.auto_tp_start_mode.set(saved.get("auto_start_mode", "start"))
        
        self.auto_tp_interact_object_var = tk.BooleanVar(value=saved.get("auto_interact_obj", False))
        self.auto_tp_interact_vista_var = tk.BooleanVar(value=saved.get("auto_interact_vista", False))
        self.auto_relog_var = tk.BooleanVar(value=saved.get("auto_relog", False))
        self.auto_relog_twice_var = tk.BooleanVar(value=saved.get("auto_relog_twice", False))
        self.auto_relog_loop_var = tk.BooleanVar(value=saved.get("auto_relog_loop", False))
        self.auto_quickness_var = tk.BooleanVar(value=saved.get("auto_quickness", False))

        # --- SYNC TO LOGIC IMMEDIATELY ---
        # This ensures logic matches UI even before you click anything
        if self.logic:
            self.logic.auto_relog_enabled = self.auto_relog_var.get()
            self.logic.auto_relog_twice_enabled = self.auto_relog_twice_var.get()
            self.logic.auto_relog_loop_enabled = self.auto_relog_loop_var.get()
            self.logic.auto_quickness_enabled = self.auto_quickness_var.get()
            self._update_auto_tp_interact_flags()

        # --- UI CONSTRUCTION ---
        fixed = tk.Frame(parent, bg="#121212", height=90)
        fixed.pack(fill=tk.X, side=tk.TOP)
        fixed.pack_propagate(False)

        middle_container = tk.Frame(parent, bg="#121212")
        middle_container.pack(fill=tk.BOTH, expand=True)
        fixed_mid, middle = self.create_scroll_area(middle_container, scroll=True)
        fixed_mid.pack_forget() 
        
        footer = tk.Frame(parent, bg="#0e0e0e")
        footer.pack(fill=tk.X, side=tk.BOTTOM)

        ttk.Label(fixed, text="AUTO TELEPORT (FILE BASED)", style="Section.TLabel").pack(fill=tk.X, pady=8)
            
        # File Select Row
        row = tk.Frame(fixed, bg="#121212")
        row.pack(fill=tk.X, padx=10, pady=5)
        self.auto_tp_file_lbl = tk.Message(row, text="No .tps file selected", bg="#121212", fg="#888", width=260, anchor="w")
        self.auto_tp_file_lbl.pack(side=tk.LEFT, fill=tk.X, expand=True)

        def select_file():
            if self.auto_run_active.get():
                self.logic.stop_auto_teleport()
                self.auto_run_active.set(False)
                self.btn_auto_run.config(text="▶ START AUTO TELEPORT", bg="#121212", fg="white")

            base_dir = os.path.join(os.path.dirname(__file__), "teleports", "maps")
            os.makedirs(base_dir, exist_ok=True)
            path = filedialog.askopenfilename(title="Select .tps file", initialdir=base_dir, filetypes=[("Teleport Files", "*.tps")], parent=parent)
            if not path: return

            self.auto_run_source = path
            self.auto_tp_file_lbl.config(text=os.path.basename(path), fg="#00ff00")
            self.saved_inputs["auto_tp_last_file"] = self.auto_run_source
            self.saved_inputs["auto_tp_open"] = True
            self.save_settings()
            
            # Open the file window
            self._open_map_file_window(os.path.basename(path), path, force_open=True)
            
        ttk.Button(row, text="Select .tps", command=select_file).pack(side=tk.RIGHT)
        
        # Delay Row
        delay_frame = tk.Frame(middle, bg="#121212"); delay_frame.pack(fill=tk.X, padx=10, pady=(10, 10))
        # Note: 'settings_frame' doesn't exist in this scope in your pasted code, using standard pack logic is safer here, 
        # but if you have a grid layout above, ensure the parent is correct. 
        # Based on your file, just packing a label into delay_frame works best:
        tk.Label(delay_frame, text="Teleport Delay (s):", bg="#121212", fg="#ccc").pack(anchor="w", padx=0)
        
        delay_row = tk.Frame(delay_frame, bg="#121212"); delay_row.pack(fill=tk.X)
        
        delay_entry = tk.Entry(delay_row, textvariable=self.auto_tp_delay, width=6, bg="#202020", fg="#00ff00", relief="flat", validate="key", validatecommand=self.num_vcmd)
        delay_entry.pack(side=tk.LEFT)
        
        # CHANGED: Use tk.Scale instead of ttk.Scale to support 'resolution'
        delay_scale = tk.Scale(
            delay_row, 
            from_=0.0, 
            to=5.0, 
            variable=self.auto_tp_delay, 
            orient="horizontal", 
            resolution=0.5,     # <--- Forces 0.5s increments
            showvalue=0,        # Hide the number on the slider itself
            bg="#121212",       
            fg="#00ff00",
            activebackground="#00ff00",
            highlightthickness=0,
            bd=0,
            troughcolor="#333"
        )
        delay_scale.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=8)

        def update_delay_lock(*_):
            locked = self.auto_run_active.get()
            if delay_entry.winfo_exists(): delay_entry.config(state=tk.DISABLED if locked else tk.NORMAL)
            # tk.Scale uses config(state=...)
            if delay_scale.winfo_exists(): delay_scale.config(state=tk.DISABLED if locked else tk.NORMAL)
        
        # Loop Settings
        loop_frame = tk.Frame(middle, bg="#121212"); loop_frame.pack(fill=tk.X, padx=10, pady=(5, 10))
        tk.Checkbutton(loop_frame, text="Loop", variable=self.auto_tp_loop, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff").pack(side=tk.LEFT)
        tk.Label(loop_frame, text="Count:", bg="#121212", fg="#888").pack(side=tk.LEFT, padx=(10, 2))
        tk.Entry(loop_frame, textvariable=self.auto_tp_loop_count, width=5, bg="#202020", fg="#00ff00", relief="flat", validate="key", validatecommand=self.num_vcmd).pack(side=tk.LEFT)

        # Checkboxes
        tk.Checkbutton(middle, text="Relog after Auto TP finishes", variable=self.auto_relog_var, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff", command=lambda: setattr(self.logic, "auto_relog_enabled", self.auto_relog_var.get())).pack(anchor="w", padx=10, pady=(4, 2))
        tk.Checkbutton(middle, text="Double Relog (Login -> Relog again)", variable=self.auto_relog_twice_var, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff", command=lambda: setattr(self.logic, "auto_relog_twice_enabled", self.auto_relog_twice_var.get())).pack(anchor="w", padx=30, pady=(0, 2))
        tk.Checkbutton(middle, text="Loop Auto TP after relog (20s delay)", variable=self.auto_relog_loop_var, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff", command=lambda: setattr(self.logic, "auto_relog_loop_enabled", self.auto_relog_loop_var.get())).pack(anchor="w", padx=10, pady=(0, 6))
        
        # Interact
        interact_frame = tk.Frame(middle, bg="#121212"); interact_frame.pack(fill=tk.X, padx=10, pady=(0, 10))
        tk.Checkbutton(interact_frame, text="Auto Interact Object", variable=self.auto_tp_interact_object_var, command=self._update_auto_tp_interact_flags, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff").pack(anchor="w")
        tk.Checkbutton(interact_frame, text="Auto Interact Vista", variable=self.auto_tp_interact_vista_var, command=self._update_auto_tp_interact_flags, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff").pack(anchor="w", pady=(2, 0))
        tk.Checkbutton(interact_frame, text="Auto Quickness (Skill 9)", variable=self.auto_quickness_var, command=lambda: setattr(self.logic, "auto_quickness_enabled", self.auto_quickness_var.get()), bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff").pack(anchor="w", pady=(2, 0))

        # Start Mode
        mode_frame = tk.Frame(middle, bg="#121212"); mode_frame.pack(fill=tk.X, padx=10, pady=(5, 10))
        tk.Radiobutton(mode_frame, text="Start from beginning", variable=self.auto_tp_start_mode, value="start", bg="#121212", fg="#dddddd", selectcolor="#121212").pack(anchor="w")
        tk.Radiobutton(mode_frame, text="Start from last teleport", variable=self.auto_tp_start_mode, value="last", bg="#121212", fg="#dddddd", selectcolor="#121212").pack(anchor="w")
        tk.Radiobutton(
            mode_frame,
            text="Backward Direction",
            variable=self.auto_tp_start_mode,
            value="backward",
            bg="#121212", fg="#dddddd", selectcolor="#121212"
        ).pack(anchor="w")


        tk.Radiobutton(
            mode_frame,
            text="Random Teleport",
            variable=self.auto_tp_start_mode,
            value="random",
            bg="#121212", fg="#dddddd", selectcolor="#121212"
        ).pack(anchor="w")

        self._auto_tp_delay_trace = self.auto_run_active.trace_add("write", update_delay_lock); update_delay_lock()
        
        self.btn_auto_run = tk.Button(footer, text="▶ START AUTO TELEPORT", height=2, bg="#330000", fg="white", font=("Segoe UI", 11, "bold"), relief="flat", command=self.toggle_auto_run_all)
        self.btn_auto_run.pack(fill=tk.X, padx=10, pady=8)

        # Restore Auto TP State (Runs after UI is built)
        def restore_auto_tp_state():
            if getattr(self, "_manual_tp_in_progress", False):
                return

            path = self.saved_inputs.get("auto_tp_last_file")
            should_open = self.saved_inputs.get("auto_tp_open", False)
            if path and should_open and os.path.exists(path):
                self.auto_run_source = path
                self.root.after(0, lambda: self.auto_tp_file_lbl.config(text=os.path.basename(path), fg="#00ff00"))
                self._open_map_file_window(os.path.basename(path), path, force_open=True)

        self.root.after_idle(restore_auto_tp_state)
        
        parent.update_idletasks()
        parent.winfo_toplevel().minsize(280, 360)
        
    def _update_auto_tp_interact_flags(self):
        if not self.logic:
            return

        self.logic.auto_tp_interact_object = self.auto_tp_interact_object_var.get()
        self.logic.auto_tp_interact_vista = self.auto_tp_interact_vista_var.get()

    
        # REPLACES build_global_tp_ui
    def _build_tab_global_teleport(self, parent):
        fixed, frame = self.create_scroll_area(parent, scroll=True)
        # No header/close button

        self.map_status_lbl = tk.Label(frame, text="Current Map: —", bg="#121212", fg="#888888", font=("Segoe UI", 9))
        self.map_status_lbl.pack(pady=(10, 5))
        
        # Important: Check if parent exists before scheduling update
        def update_tp_status():
            if not parent.winfo_exists(): return
            if self.logic.map_ready:
                name = self.logic.get_map_name()
                self.map_status_lbl.config(text=f"Current Map: {name}", fg="#00ff00")
            else:
                self.map_status_lbl.config(text="Current Map: Searching...", fg="#888888")
            parent.after(1000, update_tp_status)
        update_tp_status()
        
        # --- NEW: Chat Link Coordinates Config ---
        chat_frame = tk.LabelFrame(frame, text="Auto-Travel Config", bg="#121212", fg="#aaaaaa", font=("Segoe UI", 8), padx=5, pady=5)
        chat_frame.pack(fill=tk.X, padx=5, pady=5)
        
        # X Coordinate Input
        tk.Label(chat_frame, text="Chat Link X:", bg="#121212", fg="#888").grid(row=0, column=0, padx=5)
        self.chat_x_var = tk.StringVar(value=self.saved_inputs.get("chat_x", "163"))
        tk.Entry(chat_frame, textvariable=self.chat_x_var, width=6, bg="#222", fg="white").grid(row=0, column=1)
        
        # Y Coordinate Input
        tk.Label(chat_frame, text="Chat Link Y:", bg="#121212", fg="#888").grid(row=0, column=2, padx=5)
        self.chat_y_var = tk.StringVar(value=self.saved_inputs.get("chat_y", "1382")) # Default near bottom left
        tk.Entry(chat_frame, textvariable=self.chat_y_var, width=6, bg="#222", fg="white").grid(row=0, column=3)

        # Helper Button to capture mouse position
        def capture_pos():
            messagebox.showinfo("Capture", "Hover over your chat's newest line and press OK within 3 seconds...")
            self.root.after(3000, lambda: self._save_cursor_pos())
            
        ttk.Button(chat_frame, text="Get Mouse Pos", command=capture_pos).grid(row=1, column=0, columnspan=4, pady=5, sticky="ew")
        w_frame = tk.LabelFrame(frame, text="Wiki Coords [x, y]", bg="#121212", fg="#aaaaaa", font=("Segoe UI", 8), padx=5, pady=5, relief="flat")
        w_frame.pack(fill=tk.X, padx=5, pady=5)
        tk.Entry(w_frame, textvariable=self.global_coord, bg="#202020", fg="#ffaa00", relief="flat", justify="center").pack(fill=tk.X, pady=(0,2))
        ttk.Button(w_frame, text="TP (Wiki)", command=lambda: self.do_global_tp("wiki")).pack(fill=tk.X)

        t_frame = tk.LabelFrame(frame, text="GW2Timer Coords [x, y]", bg="#121212", fg="#aaaaaa", font=("Segoe UI", 8), padx=5, pady=5, relief="flat")
        t_frame.pack(fill=tk.X, padx=5, pady=5)
        tk.Entry(t_frame, textvariable=self.timer_input, bg="#202020", fg="#00aaff", relief="flat", justify="center").pack(fill=tk.X, pady=(0,2))
        ttk.Button(t_frame, text="TP (Timer)", command=lambda: self.do_global_tp("timer")).pack(fill=tk.X)

        hf = tk.Frame(frame, bg="#121212"); hf.pack(fill=tk.X, padx=10, pady=10)
        tk.Label(hf, text="Force Height (Opt):", bg="#121212", fg="#666", font=("Arial", 8)).pack(side=tk.LEFT)
        tk.Entry(hf, textvariable=self.global_h_tp, width=8, bg="#202020", fg="white", relief="flat", validate="key", validatecommand=self.num_vcmd).pack(side=tk.RIGHT)
    
    def on_mouse_click(self, x, y):
        now = time.time()
        if now - self._last_click_time < self._dbl_click_threshold:
            self.on_map_double_click(x, y)
        self._last_click_time = now
        
    def handle_map_mouse_click(self, screen_x, screen_y):
        # This is the bridge between the Listener and the Logic
        print(f"[MapClick] Processing Logic for {screen_x}, {screen_y}...")

        deltas = self.get_map_click_continent_coords(screen_x, screen_y)
        if not deltas:
            return

        map_dx, map_dy = deltas
        
        # Send to Logic
        self.logic.teleport_from_map_double_click(map_dx, map_dy)        
   
    def get_map_click_continent_coords(self, screen_x, screen_y):
        # 1. Get Mumble Data
        m_data = core.mumble.read() if core.mumble else None
        if not m_data:
            print("[MapClick] Mumble data is None")
            return None
            
        # 2. Get Screen Center
        hwnd = win32gui.FindWindow(None, "Guild Wars 2")
        if not hwnd: return None
        rect = win32gui.GetClientRect(hwnd)
        center_x, center_y = rect[2] // 2, rect[3] // 2

        # 3. Calculate Screen Offsets (Pixels)
        dx_pixels = screen_x - center_x
        dy_pixels = screen_y - center_y
        
        current_scale = m_data["map_scale"]
        if current_scale <= 0.001: current_scale = 1.0

        # 4. Calculate Absolute Map Coordinates of the CLICK
        # Formula: ClickMap = MapCenter + (ScreenOffset * Scale)
        map_center_x = m_data["map_center_x"]
        map_center_y = m_data["map_center_y"]
        
        click_map_x = map_center_x + (dx_pixels * current_scale)
        click_map_y = map_center_y + (dy_pixels * current_scale)
        
        # 5. Calculate Total Delta from PLAYER
        # We need the difference between "Where I clicked" and "Where I am"
        player_map_x = m_data["player_x"]
        player_map_y = m_data["player_y"]
        
        # Safety: If Mumble doesn't provide player map coords (rare), abort
        if player_map_x == 0 or player_map_y == 0:
            print("[MapClick] Error: Player Map Coords are 0. Cannot calc offset.")
            return None

        total_map_dx = click_map_x - player_map_x
        total_map_dy = click_map_y - player_map_y
        
        print(f"[MapClick] Click Abs: {click_map_x:.1f}, {click_map_y:.1f}")
        print(f"[MapClick] Player Map: {player_map_x:.1f}, {player_map_y:.1f}")
        print(f"[MapClick] Total Delta: {total_map_dx:.1f}, {total_map_dy:.1f}")

        return (total_map_dx, total_map_dy)
    
    def _on_map_double_click(self, screen_x, screen_y):
        print("[MapClick] Processing Double Click...") # <--- LOGGING

        deltas = self.get_map_click_continent_coords(screen_x, screen_y)
        if not deltas:
            return

        map_dx, map_dy = deltas
        
        # Update Core (Optional, purely for other mods using 'hover')
        core.update_map_hover(map_dx, map_dy)

        # Send to Logic
        self.logic.teleport_from_map_double_click(map_dx, map_dy)
    
    def start_mouse_listener(self):
        """
        Background thread to detect mouse clicks on the GW2 window.
        Triggers handle_map_mouse_click on double click.
        """
        print("[MapClick] Listener: STARTED (Waiting for input...)") 
        
        def _mouse_loop():
            user32 = ctypes.windll.user32
            VK_LBUTTON = 0x01
            was_down = False
            last_click = 0
            
            while self.live_running:
                try:
                    # 1. Check if Left Mouse is physically down
                    is_down = user32.GetAsyncKeyState(VK_LBUTTON) & 0x8000 != 0
                    
                    if is_down and not was_down:
                        # 2. Mouse just went DOWN. Check active window.
                        hwnd = win32gui.GetForegroundWindow()
                        window_title = win32gui.GetWindowText(hwnd)
                        
                        if window_title == "Guild Wars 2":
                            # 3. Get Mouse Position
                            pt = ctypes.wintypes.POINT()
                            user32.GetCursorPos(ctypes.byref(pt))
                            x, y = pt.x, pt.y
                                                        
                            # 4. Double-Click Logic (0.35s threshold)
                            now = time.time()
                            diff = now - last_click
                            
                            # Debug log for single clicks to prove listener is alive
                            if diff > 1.0: 
                                # Only log single clicks if they aren't part of a double click spam
                                # print(f"[MapClick] Click detected at {pt.x},{pt.y} (Window: {window_title})") 
                                pass

                            if diff < 0.35: 
                                print(f"[MapClick] DOUBLE-CLICK Detected! (Interval: {diff:.3f}s) at {pt.x}, {pt.y}")
                                self.root.after(0, lambda x=pt.x, y=pt.y: self.handle_map_mouse_click(x, y))
                            
                            last_click = now
                            
                    was_down = is_down
                    time.sleep(0.01) # 10ms polling
                except Exception as e:
                    print(f"[MapClick] Listener CRASH: {e}")
                    time.sleep(1.0)

        threading.Thread(target=_mouse_loop, daemon=True).start()       
     
    def filter_wp(self, event=None):
        if not hasattr(self, "wp_list"):
            return

        query = ""
        if hasattr(self, "wp_search") and self.wp_search.winfo_exists():
            query = self.wp_search.get().lower().strip()

        self.wp_list.delete(0, tk.END)

        for name in self.all_wps:
            if query in name:
                self.wp_list.insert(tk.END, name)

        if self.wp_list.size() == 0:
            self.wp_list.insert(tk.END, "No match")

   # --- Update on_wp_click in gw2x_ui.py ---
    def on_wp_click(self, event=None):
        if not hasattr(self, "wp_list"): return
        sel = self.wp_list.curselection()
        if not sel: return
        name = self.wp_list.get(sel[0])

        # 1. Get ID
        wp_id = data.WAYPOINT_DB.get(name.lower()) 
        
        if wp_id:
            # Trigger the Chat automation
            # (Make sure you have valid Chat X/Y coords set in the Global Tab!)
            cx = int(self.saved_inputs.get("chat_x", "100"))
            cy = int(self.saved_inputs.get("chat_y", "1000"))
            self.logic.trigger_waypoint_chat(wp_id, cx, cy)
            
        if not wp_id: return
        
        # 2. Get Coordinates from UI inputs
        try:
            cx = int(self.chat_x_var.get())
            cy = int(self.chat_y_var.get())
        except:
            messagebox.showerror("Error", "Invalid Chat Coordinates")
            return

        # 3. Trigger Logic
        self.logic.trigger_waypoint_chat(wp_id, cx, cy)
    
    def filter_npc(self, event=None):
        query = ""
        if hasattr(self, "npc_entry") and self.npc_entry.winfo_exists():
            query = self.npc_entry.get().lower().strip()

        self.reset_npc_tree(query)
    
    def reset_npc_tree(self, query=""):
        self.npc_tree.delete(*self.npc_tree.get_children())

        for region, areas in data.NPC_INDEX.items():
            rnode = self.npc_tree.insert("", "end", text=region)
            for area, npcs in areas.items():
                anode = self.npc_tree.insert(rnode, "end", text=area)
                for npc in npcs:
                    name = npc["name"]
                    if query and query not in name.lower():
                        continue
                    self.npc_tree.insert(anode, "end", text=name)

    def fav_npc(self):
        sel = self.npc_tree.selection()
        if not sel:
            return

        name = self.npc_tree.item(sel[0], "text")
        if not name:
            return

        if name in data.FAVORITE_NPCS:
            data.FAVORITE_NPCS.remove(name)
        else:
            data.FAVORITE_NPCS.add(name)

        data.save_favorites()
        messagebox.showinfo("NPC", f"Toggled favorite:\n{name}")

    def _build_tab_waypoints(self, parent):
        from collections import defaultdict

        # --- STATE VARIABLES ---
        edit_mode = tk.BooleanVar(value=False)
        search_var = tk.StringVar()
        
        if not hasattr(self, 'wp_expanded_states'):
            self.wp_expanded_states = {} 

        # 1. HEADER & CONTROLS
        top_frame = tk.Frame(parent, bg="#1e1e1e", pady=5)
        top_frame.pack(fill=tk.X)

        tk.Label(top_frame, text="🔍", bg="#1e1e1e", fg="#888").pack(side=tk.LEFT, padx=(5, 0))
        entry = tk.Entry(top_frame, textvariable=search_var, bg="#333333", fg="white", insertbackground="white", relief="flat")
        entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=5)

        def clear_search(): search_var.set("")
        btn_clear = tk.Label(top_frame, text="✕", bg="#1e1e1e", fg="#888", font=("Segoe UI", 9), cursor="hand2", width=2)
        btn_clear.pack(side=tk.LEFT, padx=(0, 5))
        btn_clear.bind("<Button-1>", lambda e: clear_search())

        btn_edit = tk.Button(top_frame, text="✎", bg="#1e1e1e", fg="#888", activebackground="#333", activeforeground="white", relief="flat", width=3, cursor="hand2")
        btn_edit.pack(side=tk.RIGHT, padx=5)

        # 2. SCROLLABLE AREA
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True)

        canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        scrollbar = ttk.Scrollbar(list_container, orient="vertical", command=canvas.yview)
        scroll_frame = tk.Frame(canvas, bg="#121212")

        canvas_window = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")
        
        btn_refresh = tk.Label(top_frame, text="⟳", bg="#1e1e1e", fg="#888", font=("Segoe UI", 10), cursor="hand2", width=2)
        btn_refresh.pack(side=tk.LEFT, padx=(0, 5))
        
        def update_scroll_region(event=None): canvas.configure(scrollregion=canvas.bbox("all"))
        scroll_frame.bind("<Configure>", update_scroll_region)
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))

        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        def _on_mousewheel(event):
            try: canvas.yview_scroll(int(-1*(event.delta/120)), "units")
            except: pass
        canvas.bind("<Enter>", lambda _: canvas.bind_all("<MouseWheel>", _on_mousewheel))
        canvas.bind("<Leave>", lambda _: canvas.unbind_all("<MouseWheel>"))

        def safe_tps_rebuild():
            if (hasattr(self, "_active_tps_rebuild") and self.active_tps_window and 
                self.active_tps_window.winfo_exists() and not getattr(self, "_manual_tp_in_progress", False)):
                try: self._active_tps_rebuild()
                except: pass

        # --- CORE REFRESH LOGIC (OPTIMIZED) ---
        def refresh_list(*args):
            for w in scroll_frame.winfo_children(): w.destroy()

            if not data.WAYPOINT_DB:
                tk.Label(scroll_frame, text="⚠ NO DATA LOADED", bg="#121212", fg="#ff5555").pack(pady=10)
                return

            query = search_var.get().lower()
            is_editing = edit_mode.get()
            current_map_id = self.logic.current_map_id
            refresh_list.last_known_map_id = current_map_id
            
            btn_edit.config(bg="#333" if is_editing else "#1e1e1e", fg="white" if is_editing else "#888")

            groups = defaultdict(list)
            for wp in data.WAYPOINT_DB:
                w_name = str(wp.get("name", "Unknown"))
                w_map_name = str(wp.get("map_name", "Unknown Map"))
                if query:
                    if (query not in w_name.lower()) and (query not in w_map_name.lower()): continue
                groups[(wp.get('map_id', 0), w_map_name)].append(wp)

            sorted_group_keys = sorted(groups.keys(), key=lambda x: (x[0] != current_map_id, x[1]))

            # --- RENDERER HELPER (Creates the rows) ---
            # --- RENDERER HELPER (Creates the rows) ---
            def render_rows(container, wps):
                for wp in wps:
                    row = tk.Frame(container, bg="#1e1e1e")
                    row.pack(fill=tk.X)
                    has_coords = (wp.get("coord") is not None)
                    disp_text = f"      • {wp['name']}"
                    if is_editing and has_coords: disp_text += " [Has Coords]"
                    
                    # --- UPDATE: Added justify="left" ---
                    lbl_item = tk.Label(row, text=disp_text, bg="#1e1e1e", fg="#bbbbbb", font=("Segoe UI", 9), anchor="w", justify="left", cursor="hand2")
                    lbl_item.pack(side=tk.LEFT, fill=tk.X, expand=True)

                    # --- UPDATE: Dynamic Wrapping ---
                    def on_lbl_resize(e, l=lbl_item):
                        # Set wraplength to width minus a small padding (e.g. 10px)
                        l.config(wraplength=e.width - 10)
                    lbl_item.bind("<Configure>", on_lbl_resize)

                    if not is_editing:
                        def do_tp(e, w_data=wp):
                            try:
                                cx = int(self.chat_x_var.get()); cy = int(self.chat_y_var.get())
                                ok, msg = self.logic.teleport_smart_waypoint(w_data, cx, cy)
                                if not ok: messagebox.showerror("Teleport Error", msg)
                            except: messagebox.showerror("Config Error", "Check Chat Coords")
                        lbl_item.bind("<Button-1>", do_tp)
                    else:
                        lbl_item.config(cursor="")
                        def do_sync(w_data=wp):
                            pos = self.logic.read_live_coords()
                            if not pos: return messagebox.showerror("Error", "No Coordinates Found")
                            if messagebox.askyesno("Sync Waypoint", f"Save coords for {w_data['name']}?"):
                                if data.update_and_save_waypoint(w_data['name'], w_data['map_id'], pos[0], pos[1], pos[2]):
                                    reload_waypoints()
                        tk.Button(row, text="🔄", bg="#224422", fg="#88ff88", relief="flat", width=2, command=do_sync).pack(side=tk.RIGHT, padx=5)

                    def on_enter(e, l=lbl_item, r=row): l.config(bg="#333", fg="white"); r.config(bg="#333")
                    def on_leave(e, l=lbl_item, r=row): l.config(bg="#1e1e1e", fg="#bbbbbb"); r.config(bg="#1e1e1e")
                    lbl_item.bind("<Enter>", on_enter); row.bind("<Enter>", on_enter)
                    lbl_item.bind("<Leave>", on_leave); row.bind("<Leave>", on_leave)

            # --- GROUP LOOP ---
            for g_key in sorted_group_keys:
                m_id, m_name = g_key
                wps = groups[g_key]
                wps.sort(key=lambda x: x.get('name', '')) 

                is_current_map = (m_id == current_map_id)
                if query: should_expand = True 
                elif is_current_map: should_expand = True 
                else: should_expand = self.wp_expanded_states.get(m_name, False)
                self.wp_expanded_states[m_name] = should_expand

                group_container = tk.Frame(scroll_frame, bg="#121212")
                group_container.pack(fill=tk.X, pady=(1, 0))

                header_bg = "#252525"
                header_frame = tk.Frame(group_container, bg=header_bg, pady=4, padx=5, cursor="hand2")
                header_frame.pack(fill=tk.X)

                arrow_icon = "▼" if should_expand else "▶"
                title_color = "#00ff00" if is_current_map else "#dddddd"
                title_text = f"{arrow_icon}  {m_name} ({len(wps)})"
                if is_current_map: title_text += " [YOU ARE HERE]"

                lbl_title = tk.Label(header_frame, text=title_text, bg=header_bg, fg=title_color, font=("Segoe UI", 9, "bold"))
                lbl_title.pack(side=tk.LEFT)

                content_frame = tk.Frame(group_container, bg="#1e1e1e")
                
                # OPTIMIZATION: Track if we have built the rows yet
                header_frame.is_built = False
                
                # If expanding by default, build immediately
                if should_expand:
                    render_rows(content_frame, wps)
                    content_frame.pack(fill=tk.X)
                    header_frame.is_built = True
                
                def toggle_group(event, cf=content_frame, lbl=lbl_title, name=m_name, base_txt=title_text, hf=header_frame, items=wps):
                    if cf.winfo_viewable():
                        cf.pack_forget()
                        lbl.config(text=base_txt.replace("▼", "▶"))
                        self.wp_expanded_states[name] = False
                    else:
                        # LAZY BUILD: Create widgets only now
                        if not hf.is_built:
                            render_rows(cf, items)
                            hf.is_built = True
                            
                        cf.pack(fill=tk.X)
                        lbl.config(text=base_txt.replace("▶", "▼"))
                        self.wp_expanded_states[name] = True
                    
                    scroll_frame.update_idletasks()
                    canvas.configure(scrollregion=canvas.bbox("all"))

                header_frame.bind("<Button-1>", toggle_group)
                lbl_title.bind("<Button-1>", toggle_group)

        refresh_list.last_known_map_id = 0
        
        def reload_waypoints():
            data.load_waypoints_from_file("map_names.json")
            refresh_list()
            safe_tps_rebuild()

        def monitor_map():
            if not scroll_frame.winfo_exists(): return
            current = self.logic.current_map_id
            if current != 0 and current != refresh_list.last_known_map_id:
                refresh_list()
                safe_tps_rebuild()
            scroll_frame.after(1500, monitor_map)
            
        monitor_map() 

        def toggle_edit():
            edit_mode.set(not edit_mode.get())
            refresh_list()
            safe_tps_rebuild()

        btn_edit.config(command=toggle_edit)
        search_var.trace_add("write", lambda *a: refresh_list())
        btn_refresh.bind("<Button-1>", lambda e: reload_waypoints())
        
        refresh_list()
    
    def _build_tab_map_portals(self, parent):
        from collections import defaultdict

        # --- STATE VARIABLES ---
        edit_mode = tk.BooleanVar(value=False)
        search_var = tk.StringVar()

        # Persistent expand state
        if not hasattr(self, "portal_expanded_states"):
            self.portal_expanded_states = {}

        # ===============================
        # 1. HEADER & CONTROLS
        # ===============================
        top_frame = tk.Frame(parent, bg="#1e1e1e", pady=5)
        top_frame.pack(fill=tk.X)

        # Search Icon & Entry
        tk.Label(top_frame, text="🔍", bg="#1e1e1e", fg="#888").pack(side=tk.LEFT, padx=(5, 0))

        entry = tk.Entry(
            top_frame,
            textvariable=search_var,
            bg="#333333",
            fg="white",
            insertbackground="white",
            relief="flat"
        )
        entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=5)

        # Clear Search (X)
        def clear_search():
            search_var.set("")

        tk.Label(
            top_frame,
            text="✕",
            bg="#1e1e1e",
            fg="#888",
            font=("Segoe UI", 9),
            cursor="hand2",
            width=2
        ).pack(side=tk.LEFT, padx=(0, 0))
        # Bind click for X inside the loop or wrapper, but Label works with bind below
        top_frame.winfo_children()[-1].bind("<Button-1>", lambda e: clear_search())

        # --- NEW: Refresh Button (⟳) ---
        # Placed immediately after Clear button
        btn_refresh = tk.Label(
            top_frame, text="⟳", bg="#1e1e1e", fg="#888",
            font=("Segoe UI", 10), cursor="hand2", width=2
        )
        btn_refresh.pack(side=tk.LEFT, padx=(0, 5))

        # --- NEW: Add Button (+) ---
        # Placed on the Right
        btn_add = tk.Button(
            top_frame,
            text="+",
            bg="#1e1e1e",
            fg="#888",
            activebackground="#333",
            activeforeground="white",
            relief="flat",
            width=3,
            cursor="hand2"
        )
        btn_add.pack(side=tk.RIGHT, padx=2)

        # Edit Button (✎)
        btn_edit = tk.Button(
            top_frame,
            text="✎",
            bg="#1e1e1e",
            fg="#888",
            activebackground="#333",
            activeforeground="white",
            relief="flat",
            width=3,
            cursor="hand2"
        )
        btn_edit.pack(side=tk.RIGHT, padx=2)

        # ===============================
        # 2. SCROLLABLE AREA
        # ===============================
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True)

        canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        scrollbar = ttk.Scrollbar(list_container, orient="vertical", command=canvas.yview)
        scroll_frame = tk.Frame(canvas, bg="#121212")

        canvas_window = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")

        def update_scroll_region(_=None):
            canvas.configure(scrollregion=canvas.bbox("all"))

        scroll_frame.bind("<Configure>", update_scroll_region)
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))

        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        def _on_mousewheel(event):
            try:
                canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
            except:
                pass

        canvas.bind("<Enter>", lambda _: canvas.bind_all("<MouseWheel>", _on_mousewheel))
        canvas.bind("<Leave>", lambda _: canvas.unbind_all("<MouseWheel>"))

        # ===============================
        # 3. LOGIC & DATA HANDLING
        # ===============================
        
        # --- Logic: Add Portal ---
        def add_portal():
            # 1. Get Coordinates
            pos = self.logic.read_live_coords()
            if not pos: 
                messagebox.showerror("Error", "Could not read live coordinates.")
                return

            # 2. Get Name
            name = simpledialog.askstring("Add Portal", "Portal Name:", parent=parent)
            if not name: return

            # 3. Get Map Name (Default to current detected map)
            current_map = self.logic.get_map_name() or "Unknown Map"
            map_name = simpledialog.askstring("Add Portal", "Map Name:", initialvalue=current_map, parent=parent)
            if not map_name: return

            # 4. Get Map ID
            curr_id = self.logic.current_map_id
            map_id_str = simpledialog.askstring("Add Portal", "Map ID:", initialvalue=str(curr_id), parent=parent)
            
            try:
                final_map_id = int(map_id_str) if map_id_str else 0
            except ValueError:
                final_map_id = 0

            new_portal = {
                "name": name,
                "x": pos[0], "y": pos[1], "z": pos[2],
                "map_id": final_map_id,
                "type": "portal"
            }

            # 5. Update Database
            if map_name not in data.PORTAL_DB:
                data.PORTAL_DB[map_name] = []
            
            data.PORTAL_DB[map_name].append(new_portal)
            
            # 6. Save (Try to find a save method, or update in-memory)
            if hasattr(data, "save_portals"):
                data.save_portals()
            elif hasattr(data, "save_custom_teleports"):
                # Sometimes portals are part of custom teleports in mixed implementations
                pass 
            
            # 7. Refresh UI
            refresh_list()
            messagebox.showinfo("Success", f"Portal '{name}' added to '{map_name}'.")

        # --- Logic: Refresh List ---
        def refresh_list(*_):            
            current_map_id = getattr(self.logic, "current_map_id", None)

            # Clear previous UI
            for w in scroll_frame.winfo_children():
                w.destroy()

            portals_by_map = data.PORTAL_DB
            if not portals_by_map:
                tk.Label(
                    scroll_frame,
                    text="⚠ NO MAP PORTALS LOADED",
                    bg="#121212",
                    fg="#ff5555"
                ).pack(pady=10)
                return

            query = search_var.get().lower()
            is_editing = edit_mode.get()

            btn_edit.config(
                bg="#333" if is_editing else "#1e1e1e",
                fg="white" if is_editing else "#888"
            )

            # Build filtered groups
            groups = defaultdict(list)

            for map_name, portal_list in portals_by_map.items():
                for tp in portal_list:
                    name = str(tp.get("name", "Unknown"))

                    if query:
                        if query not in map_name.lower() and query not in name.lower():
                            continue

                    groups[map_name].append(tp)

            if not groups:
                tk.Label(
                    scroll_frame,
                    text="⚠ NO MATCHING PORTALS",
                    bg="#121212",
                    fg="#ffaa55"
                ).pack(pady=10)
                return

            # Render groups
            # Sorting: Current map first, then alphabetical
            sorted_maps = sorted(
                groups.keys(),
                key=lambda m: 0 if any(
                    tp.get("map_id") == current_map_id
                    for tp in groups[m]
                ) else 1
            )

            for map_name in sorted_maps:
                items = groups[map_name]
                
                is_current_map = False
                if current_map_id is not None:
                    for tp in items:
                        if tp.get("map_id") == current_map_id:
                            is_current_map = True
                            break
                            
                should_expand = (
                    True if query or is_current_map else
                    self.portal_expanded_states.get(map_name, False)
                )
                self.portal_expanded_states[map_name] = should_expand
    
                container = tk.Frame(scroll_frame, bg="#121212")
                container.pack(fill=tk.X, pady=(1, 0))
                            
                header = tk.Frame(container, bg="#252525", pady=4, padx=5, cursor="hand2")
                header.pack(fill=tk.X)

                arrow = "▼" if should_expand else "▶"
                suffix = " [YOU ARE HERE]" if is_current_map else ""
                lbl = tk.Label(
                    header,
                    text=f"{arrow}  {map_name} ({len(items)}){suffix}",
                    bg="#252525",
                    fg="#00ff66" if is_current_map else "#dddddd",
                    font=("Segoe UI", 9, "bold")
                )
                lbl.pack(side=tk.LEFT)

                content = tk.Frame(container, bg="#1e1e1e")

                for i, tp in enumerate(items):
                    # Delete Callback for Edit Mode
                    def delete_portal_cb(t=tp, m=map_name):
                        if messagebox.askyesno("Delete", f"Delete portal '{t['name']}'?"):
                            if t in data.PORTAL_DB[m]:
                                data.PORTAL_DB[m].remove(t)
                                if hasattr(data, "save_portals"): data.save_portals()
                                refresh_list()

                    self._create_tp_row(
                        parent_frame=content,
                        tp=tp,
                        index=i,
                        total=len(items),
                        refresh_cb=refresh_list,
                        dialog_parent=parent,
                        edit_override=edit_mode, 
                        source_list=items,
                        delete_cb=delete_portal_cb if is_editing else None
                    )

                if should_expand:
                    content.pack(fill=tk.X)

                def toggle(_, cf=content, label=lbl, name=map_name):
                    if cf.winfo_viewable():
                        cf.pack_forget()
                        self.portal_expanded_states[name] = False
                        label.config(text=label.cget("text").replace("▼", "▶"))
                    else:
                        cf.pack(fill=tk.X)
                        self.portal_expanded_states[name] = True
                        label.config(text=label.cget("text").replace("▶", "▼"))

                    update_scroll_region()

                header.bind("<Button-1>", toggle)
                lbl.bind("<Button-1>", toggle)

            update_scroll_region()

        # ===============================
        # 4. FINAL WIRES & MONITORING
        # ===============================
        btn_edit.config(command=lambda: (edit_mode.set(not edit_mode.get()), refresh_list()))
        btn_add.config(command=add_portal)
        btn_refresh.bind("<Button-1>", lambda e: refresh_list())
        search_var.trace_add("write", refresh_list)

        # Initial Load
        refresh_list()
        
        # Monitor Map Change Logic
        def monitor_map():
            new_map = getattr(self.logic, "current_map_id", None)
            if new_map != getattr(monitor_map, "last_map", None):
                monitor_map.last_map = new_map
                refresh_list()
            parent.after(1500, monitor_map)

        monitor_map()

    def _build_tab_npc(self, parent):
        # --- STATE VARIABLES ---
        edit_mode = tk.BooleanVar(value=False)
        search_var = tk.StringVar()

        # 1. CONTROLS HEADER
        top_frame = tk.Frame(parent, bg="#1e1e1e", pady=5)
        top_frame.pack(fill=tk.X)

        tk.Label(top_frame, text="🔍", bg="#1e1e1e", fg="#888").pack(side=tk.LEFT, padx=(5, 2))
        entry = tk.Entry(top_frame, textvariable=search_var, bg="#333333", fg="white", insertbackground="white", relief="flat")
        entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=2)

        # Edit Button (Variable name fixed: btn_edit)
        btn_edit = tk.Button(
            top_frame, text="✎", bg="#1e1e1e", fg="#888",
            activebackground="#333", activeforeground="white",
            relief="flat", width=3, cursor="hand2"
        )
        
        btn_refresh = tk.Label(
            top_frame, text="⟳", bg="#1e1e1e", fg="#888",
            font=("Segoe UI", 10), cursor="hand2", width=2
        )
        btn_refresh.pack(side=tk.LEFT, padx=(0, 5))
            
        # Add NPC Button
        btn_add = tk.Button(
            top_frame, text="+", bg="#1e1e1e", fg="#888",
            activebackground="#333", activeforeground="white",
            relief="flat", width=3, cursor="hand2"
        )
        
        btn_add.pack(side=tk.RIGHT, padx=2)
        btn_edit.pack(side=tk.RIGHT, padx=2)

        # 2. SCROLLABLE LIST AREA
        list_container = tk.Frame(parent, bg="#121212")
        list_container.pack(fill=tk.BOTH, expand=True)

        canvas = tk.Canvas(list_container, bg="#121212", highlightthickness=0)
        scrollbar = ttk.Scrollbar(list_container, orient="vertical", command=canvas.yview)
        scroll_frame = tk.Frame(canvas, bg="#121212")

        # --- AUTO-FILL WIDTH LOGIC ---
        canvas_window = canvas.create_window((0, 0), window=scroll_frame, anchor="nw")

        scroll_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfig(canvas_window, width=e.width))

        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        def _on_mousewheel(event):
            try: canvas.yview_scroll(int(-1*(event.delta/120)), "units")
            except: pass
        canvas.bind("<Enter>", lambda _: canvas.bind_all("<MouseWheel>", _on_mousewheel))
        canvas.bind("<Leave>", lambda _: canvas.unbind_all("<MouseWheel>"))

        # --- LOGIC & REFRESH ---
        def refresh_list(*args):
            current_map_id = getattr(self.logic, "current_map_id", None)

            for w in scroll_frame.winfo_children(): w.destroy()

            if not getattr(self.logic, "npcs", None):
                tk.Label(scroll_frame, text="No NPCs loaded.", bg="#121212", fg="#666").pack(pady=20)
                return

            query = search_var.get().lower()
            is_editing = edit_mode.get()
            
            # Button Styling
            btn_edit.config(bg="#333" if is_editing else "#1e1e1e", fg="white" if is_editing else "#888")

            count = 0
            for npc in self.logic.npcs:
                # Prepare fields for Search
                n_name = str(npc.get("name", "Unknown") or "")
                n_svc  = str(npc.get("service", "") or "")
                n_reg  = str(npc.get("region", "") or "")
                n_zone = str(npc.get("zone", "") or "")
                n_id   = str(npc.get("id", "") or "")
                
                # Search Filter
                full_text = f"{n_name} {n_svc} {n_reg} {n_zone} {n_id}".lower()
                
                if query in full_text:
                    count += 1
                    if count > 60: break

                    row = tk.Frame(scroll_frame, bg="#1e1e1e", pady=2)
                    row.pack(fill=tk.X, pady=1)

                    # Display Text
                    txt = f"{n_name}"
                    if n_svc: txt += f" [{n_svc}]"
                    if n_zone: txt += f" ({n_zone})"
                    if is_editing and n_id: txt += f" ID:{n_id}"

                    # Main Clickable Label (Teleport on Click)
                    lbl = tk.Label(row, text=txt, bg="#1e1e1e", fg="#ddd", font=("Segoe UI", 9), anchor="w", cursor="hand2")
                    lbl.pack(side=tk.LEFT, padx=5, fill=tk.X, expand=True)
                    
                    # Highlight on hover
                    def on_enter(e, l=lbl): l.config(bg="#2a2a2a")
                    def on_leave(e, l=lbl): l.config(bg="#1e1e1e")
                    lbl.bind("<Enter>", on_enter)
                    lbl.bind("<Leave>", on_leave)

                    if not is_editing:
                        # --- NORMAL MODE: Click to Teleport ---
                        def do_tp(e, n=npc):
                            ok, msg = self.logic.teleport_npc(n)
                            if not ok: messagebox.showerror("Error", msg)
                        
                        # Bind click to the label itself
                        lbl.bind("<Button-1>", do_tp)
                    else:
                        # --- EDIT MODE ---
                        # Disable TP click in edit mode to avoid accidents
                        lbl.config(cursor="")
                        lbl.unbind("<Button-1>")

                        # 1. DELETE
                        def do_delete(n=npc):
                            if messagebox.askyesno("Delete", f"Delete '{n.get('name')}'?", parent=parent):
                                self.logic.npcs.remove(n)
                                self.logic.save_npcs()
                                refresh_list()
                        tk.Button(row, text="🗑", bg="#442222", fg="#ff8888", relief="flat", width=3, command=do_delete).pack(side=tk.RIGHT, padx=1)

                        # 2. SYNC
                        def do_sync(n=npc):
                            pos = self.logic.read_live_coords()
                            if not pos: return messagebox.showerror("Error", "No Coordinates")
                            if messagebox.askyesno("Sync", f"Update '{n.get('name')}' location?", parent=parent):
                                n["coord"] = list(pos)
                                n["zone"] = self.logic.get_map_name()
                                self.logic.save_npcs()
                                refresh_list()
                        tk.Button(row, text="🔄", bg="#224422", fg="#88ff88", relief="flat", width=3, command=do_sync).pack(side=tk.RIGHT, padx=1)

                        # 3. EDIT DETAILS
                        def do_edit_details(n=npc):
                            new_name = simpledialog.askstring("Edit", "Name:", initialvalue=n.get("name",""), parent=parent)
                            if new_name is None: return
                            
                            new_svc = simpledialog.askstring("Edit", "Service:", initialvalue=n.get("service","") or "", parent=parent)
                            if new_svc is None: return
                            
                            curr_id = n.get("id", "")
                            if curr_id is None: curr_id = ""
                            new_id = simpledialog.askstring("Edit", "Map ID:", initialvalue=str(curr_id), parent=parent)
                            if new_id is None: return
                            
                            n["name"] = new_name
                            n["service"] = new_svc
                            n["id"] = new_id
                            self.logic.save_npcs()
                            refresh_list()
                            
                        tk.Button(row, text="✎", bg="#333", fg="#ddd", relief="flat", width=3, command=do_edit_details).pack(side=tk.RIGHT, padx=1)
        
        def do_refresh_npcs(e=None):
            if self.logic.load_npcs():
                messagebox.showinfo("NPC", f"Reloaded {len(self.logic.npcs)} NPCs.")
            else:
                messagebox.showerror("NPC", "Failed to load all_npcs.json")
            refresh_list()
        
        btn_refresh.bind("<Button-1>", do_refresh_npcs)
        
        # --- ACTIONS ---
        def toggle_edit():
            edit_mode.set(not edit_mode.get())
            refresh_list()

        def add_npc():
            pos = self.logic.read_live_coords()
            if not pos: return messagebox.showerror("Error", "Read coords failed")
            
            name = simpledialog.askstring("Add NPC", "Name:", parent=parent)
            if not name: return
            
            svc = simpledialog.askstring("Add NPC", "Service (Optional):", parent=parent) or ""
            mid = simpledialog.askstring("Add NPC", "Map ID (Optional):", parent=parent) or ""
            
            new_npc = {
                "name": name,
                "service": svc,
                "region": "Custom",
                "zone": self.logic.get_map_name(),
                "area": "User Added",
                "id": mid,
                "coord": list(pos)
            }
            self.logic.npcs.insert(0, new_npc)
            self.logic.save_npcs()
            search_var.set("") 
            refresh_list()

        # Bind Commands (Corrected variable name here)
        btn_edit.config(command=toggle_edit)
        btn_add.config(command=add_npc)
        search_var.trace_add("write", refresh_list)
        
        # Bind Refresh Button AFTER refresh_list exists
        btn_refresh.bind("<Button-1>", lambda e: refresh_list())
        
        # Initial Load
        refresh_list()
    
    def on_npc_click(self, event=None):
        sel = self.npc_tree.selection()
        if not sel:
                        return

        name = self.npc_tree.item(sel[0], "text")
        npc = data.NPC_NAME_MAP.get(name)
        if not npc or not npc.get("coord"):
            messagebox.showerror("NPC", "No coordinates available.")
            return

        x, y = npc["coord"]
        self.global_coord.set(f"[{x}, {y}]")
        messagebox.showinfo("NPC", f"NPC coords loaded:\n{name}")
        
    def _create_tp_row(self, parent_frame, tp, index, total, refresh_cb, dialog_parent, delete_cb=None, edit_override=None, highlight_cb=None, true_index=None, widget_registry=None, source_list=None):
        row = tk.Frame(parent_frame, bg="#1e1e1e", height=36)
        row.pack(fill=tk.X, pady=1)
        is_editing = edit_override.get() if edit_override else self.tp_edit_mode.get()

        # Try to deduce source_list if not provided (for backward compatibility)
        if source_list is None and hasattr(dialog_parent, "points"):
            source_list = dialog_parent.points

        # Color Strip (Indicator)
        color_strip = tk.Frame(row, width=4, bg="#ffcc00") 
        color_strip.pack(side=tk.LEFT, fill=tk.Y)
        def _update_indicator_loop():
            if not color_strip.winfo_exists(): return
            try:
                is_match = False
                curr_id = self.logic.current_map_id if self.logic else 0
                tp_id = int(tp.get("map_id", 0))
                if curr_id > 0 and tp_id > 0:
                    if curr_id == tp_id: is_match = True
                if not is_match and self.logic:
                    live_name = self.logic.get_map_name()
                    if live_name:
                        live_name = live_name.lower().strip()
                        saved_map = str(tp.get("map_name", "")).lower().strip()
                        tp_name = str(tp.get("name", "")).lower().strip()
                        if (live_name and saved_map and live_name == saved_map) or (live_name and live_name in tp_name):
                             is_match = True
                new_color = "#00ff66" if is_match else "#ffcc00"
                if color_strip["bg"] != new_color: color_strip.config(bg=new_color)
            except Exception: pass
            color_strip.after(1000, _update_indicator_loop)
        _update_indicator_loop()

        current_idx = true_index if true_index is not None else index
        
        # --- CLICK HANDLER ---
        def do_tp():
            if is_editing: return # Disable normal click in edit mode

            if self.logic:
                self.logic.set_manual_index(current_idx)

            if highlight_cb:
                highlight_cb(btn, current_idx)
            else:
                if widget_registry is not None:
                    self.tp_row_widgets = widget_registry
                self._highlight_tp_index(current_idx)

            if tp.get("type") == "portal":
                ok, msg = self.logic.teleport_portal_direct(tp)
            else:
                ok, msg = self.logic.teleport_smart_custom(tp)

            if not ok: messagebox.showerror("Teleport", msg)
       
        btn = tk.Button(
            row, text=tp["name"], bg="#1e1e1e", fg="#dddddd",
            activeforeground="white", relief="flat", anchor="w", justify="left",           
            command=do_tp
        )

        def on_btn_resize(e):
            btn.config(wraplength=e.width - 10)
        btn.bind("<Configure>", on_btn_resize)

        if widget_registry is not None: widget_registry[current_idx] = btn
        else: self.tp_row_widgets[current_idx] = btn
        
        # --- EDIT MODE TOOLS ---
        if is_editing:
            # === DRAG BINDINGS START ===
            # We bind to both 'row' (background) and 'btn' (foreground text)
            # This ensures the drag works no matter where you click.
            
            # 1. Start Drag
            drag_start = lambda e, t=tp: self._start_tp_drag(e, t, source_list, refresh_cb)
            row.bind("<ButtonPress-1>", drag_start)
            btn.bind("<ButtonPress-1>", drag_start) 
            
            # 2. Do Drag
            drag_move = lambda e: self._do_tp_drag(e, refresh_cb)
            row.bind("<B1-Motion>", drag_move)
            btn.bind("<B1-Motion>", drag_move)
            
            # 3. End Drag
            drag_end = lambda e: self._end_tp_drag(e)
            row.bind("<ButtonRelease-1>", drag_end)
            btn.bind("<ButtonRelease-1>", drag_end)
            # === DRAG BINDINGS END ===

            def icon_btn(img_key, cmd):
                return tk.Button(row, image=self.icons[img_key], bg="#222", activebackground="#444", relief="flat", bd=0, cursor="hand2", command=cmd)
            def text_btn(txt, cmd):
                return tk.Button(row, text=txt, bg="#222", fg="#aaa", activebackground="#444", activeforeground="white", relief="flat", bd=0, width=3, font=("Segoe UI", 8), cursor="hand2", command=cmd)
            def delete_action():
                if delete_cb: delete_cb() 
                else:
                    g = data.CUSTOM_TP_DB["groups"][self.current_tp_group]
                    if tp in g["teleports"]:
                        g["teleports"].remove(tp); data.save_custom_teleports()
                        safe_refresh(); safe_refresh(save=True)
            def copy_tp():
                coords = f"{tp['x']:.2f}, {tp['y']:.2f}, {tp['z']:.2f}"
                pyperclip.copy(coords)
            def edit_tp():
                if self.logic and self.logic.auto_tp_running:
                    messagebox.showwarning("Locked", "Stop Auto Teleport first."); return
                new_name = simpledialog.askstring("Edit", "Rename:", initialvalue=tp["name"], parent=dialog_parent)
                if not new_name: return
                tp["name"] = new_name
                if delete_cb: refresh_cb(save_mode=True)
                else: data.save_custom_teleports(); refresh_cb()
            def sync_tp():
                if self.logic and self.logic.auto_tp_running:
                    messagebox.showwarning("Locked", "Stop Auto Teleport first."); return
                pos = self.logic.read_live_coords()
                if not pos: messagebox.showerror("Error", "Could not read live coords."); return
                if messagebox.askyesno("Sync", f"Update '{tp['name']}' to current pos?", parent=dialog_parent):
                    tp['x'], tp['y'], tp['z'] = pos
                    tp['map_id'] = self.logic.current_map_id 
                    if delete_cb: refresh_cb(save_mode=True)
                    else: data.save_custom_teleports(); refresh_cb()
            def safe_refresh(save=False):
                try: refresh_cb(save_mode=save)
                except TypeError: refresh_cb()

            icon_btn("clear", delete_action).pack(side=tk.RIGHT, padx=1, pady=2)
            if delete_cb is None: 
                # (Legacy buttons for custom tabs)
                def move_up():
                    lst = data.CUSTOM_TP_DB["groups"][self.current_tp_group]["teleports"]
                    if index > 0:
                        lst[index], lst[index-1] = lst[index-1], lst[index]
                        data.save_custom_teleports(); safe_refresh(save=True)
                def move_down():
                    lst = data.CUSTOM_TP_DB["groups"][self.current_tp_group]["teleports"]
                    if index < len(lst) - 1:
                        lst[index], lst[index+1] = lst[index+1], lst[index]
                        data.save_custom_teleports(); safe_refresh(save=True)
                text_btn("📂", lambda: None).pack(side=tk.RIGHT, padx=1, pady=2)
                text_btn("❐", copy_tp).pack(side=tk.RIGHT, padx=1, pady=2)
                icon_btn("edit", edit_tp).pack(side=tk.RIGHT, padx=1, pady=2)
                icon_btn("refresh", sync_tp).pack(side=tk.RIGHT, padx=1, pady=2)
                if index < total - 1: text_btn("▼", move_down).pack(side=tk.RIGHT, padx=1, pady=2)
                if index > 0: text_btn("▲", move_up).pack(side=tk.RIGHT, padx=1, pady=2)
            else: 
                text_btn("❐", copy_tp).pack(side=tk.RIGHT, padx=1, pady=2)
                icon_btn("edit", edit_tp).pack(side=tk.RIGHT, padx=1, pady=2)
                icon_btn("refresh", sync_tp).pack(side=tk.RIGHT, padx=1, pady=2)
        else:
            tk.Button(
                row, text="❐", bg="#2a2a2a", fg="#aaaaaa", activebackground="#444", activeforeground="white",
                relief="flat", bd=0, width=3, font=("Segoe UI", 8), cursor="hand2",
                command=lambda: pyperclip.copy(json.dumps(tp))
            ).pack(side=tk.RIGHT, padx=2, ipady=2)

        btn.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=6)
        return row
    
    def update_macro_status_labels(self, run_lbl_a=None, run_lbl_b=None):
        if run_lbl_a:
            run_lbl_a.config(
                text="Running" if self.macro_state["A"] else "Stopped",
                fg="#00ff00" if self.macro_state["A"] else "#ffaa00"
            )

        if run_lbl_b:
            run_lbl_b.config(
                text="Running" if self.macro_state["B"] else "Stopped",
                fg="#00ff00" if self.macro_state["B"] else "#ffaa00"
            )
    
    def register_macro_hotkeys(self):
        """
        REPLACED: Uses ctypes GetAsyncKeyState for GLOBAL hotkeys 
        (works while in-game), instead of tkinter.bind (works only in UI).
        """
        # Mapping Tkinter-style strings to Virtual Key Codes (Hex)
        self.vk_map = {
            "<F1>": 0x70, "<F2>": 0x71, "<F3>": 0x72, "<F4>": 0x73,
            "<F5>": 0x74, "<F6>": 0x75, "<F7>": 0x76, "<F8>": 0x77,
            "<F9>": 0x78, "<F10>": 0x79, "<F11>": 0x7A, "<F12>": 0x7B,
            "<HOME>": 0x24, "<END>": 0x23, "<INSERT>": 0x2D, "<DELETE>": 0x2E
        }

        # Start the background listener
        threading.Thread(target=self._global_hotkey_loop, daemon=True).start()
        print("[Hotkey] Global background listener started.")

    def _global_hotkey_loop(self):
        key_states = {}
        user32 = ctypes.windll.user32

        # Helper for strict combination checking
        def check_strict(cfg):
            if not cfg: return False
            
            # 1. Handle New Config (Dict with mods)
            if isinstance(cfg, dict):
                main_key = cfg.get("key")
                if not (user32.GetAsyncKeyState(main_key) & 0x8000): return False
                
                req_mods = set(cfg.get("mods", []))
                pressed_mods = set()
                if user32.GetAsyncKeyState(0x10) & 0x8000: pressed_mods.add(0x10) # Shift
                if user32.GetAsyncKeyState(0x11) & 0x8000: pressed_mods.add(0x11) # Ctrl
                if user32.GetAsyncKeyState(0x12) & 0x8000: pressed_mods.add(0x12) # Alt
                
                return pressed_mods == req_mods

            # 2. Handle Legacy Config (Strings like "<F6>")
            if isinstance(cfg, str):
                vk = self.vk_map.get(cfg)
                if vk and (user32.GetAsyncKeyState(vk) & 0x8000):
                    return True
            
            return False

        while True:
            try:
                # Iterate through all registered macro hotkeys
                # Keys expected: "A_TOGGLE", "A_PAUSE", "B_TOGGLE", "B_PAUSE"
                for action_name, cfg in self.macro_hotkeys.items():
                    is_down = check_strict(cfg)
                    was_down = key_states.get(action_name, False)

                    if is_down and not was_down:
                        # Trigger Action
                        if action_name == "A_TOGGLE": self.root.after(0, self.toggle_macro_a)
                        elif action_name == "A_PAUSE": self.root.after(0, self.pause_macro_a)
                        elif action_name == "B_TOGGLE": self.root.after(0, self.toggle_macro_b)
                        elif action_name == "B_PAUSE": self.root.after(0, self.pause_macro_b)
                        # --- NEW: AUTO ASSIST HOTKEYS ---
                        elif action_name == "AUTO_ATK_TOGGLE":
                            if hasattr(self, "auto_attack_active"):
                                self.auto_attack_active.set(not self.auto_attack_active.get())
                        elif action_name == "AUTO_TAB_TOGGLE":
                            if hasattr(self, "auto_tab_active"):
                                self.auto_tab_active.set(not self.auto_tab_active.get())
                        # --- NEW: SAVED SLOTS HOTKEYS ---
                        elif action_name.startswith("SLOT_SAVE_"):
                            idx = int(action_name.split("_")[-1])
                            if hasattr(self, "slot_entries") and len(self.slot_entries) > idx:
                                self.root.after(0, lambda i=idx: self.save_slot_ui(i, self.slot_entries[i]))
                        elif action_name.startswith("SLOT_LOAD_"):
                            idx = int(action_name.split("_")[-1])
                            self.root.after(0, lambda i=idx: self.load_slot_ui(i))

                    key_states[action_name] = is_down

                time.sleep(0.01) # Low CPU usage

            except Exception as e:
                print(f"[Hotkey] Error: {e}")
                time.sleep(1)
            
    def toggle_tool_window(self, key, builder, size):
        if key not in self.windows: self.windows[key] = {'win': None, 'ind': None}
        entry = self.windows[key]
        if entry['win'] and tk.Toplevel.winfo_exists(entry['win']):
            self.close_tool_window(entry['win'], key)
        else:
            win = tk.Toplevel(self.root)
            win.title(key)
            win.configure(bg="#121212")
            win.attributes("-topmost", True)
            win.attributes("-alpha", self.transparency)

            # IMPORTANT: DO NOT REMOVE DECORATION AT CREATION
            if not self.allow_resize.get():
                win.overrideredirect(True)
            win.protocol(
                "WM_DELETE_WINDOW",
                lambda: self.close_tool_window(win, key)
            )


            if key == "Manual Teleport":
                win.overrideredirect(True)

            if key in self.saved_positions:
                p = self.saved_positions[key]
                if "w" in p and "h" in p: win.geometry(f"{p['w']}x{p['h']}+{p['x']}+{p['y']}")
                else: win.geometry(f"+{p['x']}+{p['y']}")
            else: win.geometry(size)

            entry['win'] = win
            self.open_windows.add(key)

            builder(win)
            
            self._sync_tool_indicator(key)

            win.update_idletasks()
            win.attributes("-alpha", self.transparency)
            self.save_settings()
            
            win.protocol("WM_DELETE_WINDOW", lambda: self.close_tool_window(win, key))
            win.update_idletasks() 
            self.apply_resize_mode(win, self.allow_resize.get())
            self.save_settings()
    
    def close_tool_window(self, win, key):
        if win and tk.Toplevel.winfo_exists(win):
            self.saved_positions[key] = {"x": win.winfo_x(),"y": win.winfo_y(),"w": win.winfo_width(),"h": win.winfo_height()}
            
        # Set referensi window ke None terlebih dahulu
        self.windows[key]['win'] = None
        
        if win:
            if win in self.window_offsets: del self.window_offsets[win]
            win.destroy()
            
        if key in self.open_windows: self.open_windows.remove(key)
        self.save_settings()
        
        # --- PERBAIKAN: Panggil fungsi sync alih-alih di-hardcode jadi abu-abu ---
        self._sync_tool_indicator(key)
        
        try:
            if hasattr(self, "_auto_tp_delay_trace"):
                self.auto_run_active.trace_remove(
                    "write",
                    self._auto_tp_delay_trace
                )
                del self._auto_tp_delay_trace
        except:
            pass
            
    def start_drag(self, event):
        self.drag_data = {"x": event.x_root, "y": event.y_root, "moved": False}

    def do_drag(self, event, win, is_group_move):
        if "x" not in self.drag_data: return
        dx = event.x_root - self.drag_data["x"]
        dy = event.y_root - self.drag_data["y"]
        if abs(dx) > 2 or abs(dy) > 2: self.drag_data["moved"] = True
        self.drag_data["x"] = event.x_root
        self.drag_data["y"] = event.y_root

        if is_group_move:
            mx = self.root.winfo_x() + dx; my = self.root.winfo_y() + dy
            self.root.geometry(f"+{mx}+{my}")
            for cat in self.categories.values():
                if cat['win'] and tk.Toplevel.winfo_exists(cat['win']):
                    wx = cat['win'].winfo_x() + dx; wy = cat['win'].winfo_y() + dy
                    cat['win'].geometry(f"+{wx}+{wy}")
        else:
            wx = win.winfo_x() + dx; wy = win.winfo_y() + dy
            win.geometry(f"+{wx}+{wy}")

    def stop_drag(self, e, win, key):
        self.saved_positions[key] = {"x": win.winfo_x(),"y": win.winfo_y(),"w": win.winfo_width(),"h": win.winfo_height()}
        if key == "main":
            for cat_name, cat_data in self.categories.items():
                w = cat_data.get('win')
                if w and tk.Toplevel.winfo_exists(w):
                    cat_key = f"category:{cat_name}"
                    self.saved_positions[cat_key] = {"x": w.winfo_x(),"y": w.winfo_y(),"w": w.winfo_width(),"h": w.winfo_height()}
        self.save_settings()
    
    def make_draggable(self, trigger, win, key, is_group_move=False, right_click_only=False):
        def start(e): self.start_drag(e)
        def drag(e): self.do_drag(e, win, is_group_move)
        def stop(e): self.stop_drag(e, win, key)
        if right_click_only:
            trigger.bind("<ButtonPress-3>", start, add="+")
            trigger.bind("<B3-Motion>", drag, add="+")
            trigger.bind("<ButtonRelease-3>", stop, add="+")
        else:
            trigger.bind("<ButtonPress-1>", start, add="+")
            trigger.bind("<B1-Motion>", drag, add="+")
            trigger.bind("<ButtonRelease-1>", stop, add="+")
            trigger.bind("<ButtonPress-3>", start, add="+")
            trigger.bind("<B3-Motion>", drag, add="+")
            trigger.bind("<ButtonRelease-3>", stop, add="+")

    def create_scroll_area(self, parent, scroll=True):
        if not scroll:
            content_frame = tk.Frame(parent, bg="#121212")
            content_frame.pack(fill=tk.BOTH, expand=True)

            fixed = ttk.Frame(content_frame)
            fixed.pack(side=tk.TOP, fill=tk.X)

            sf = ttk.Frame(content_frame, padding=(0, 0, 5, 0))
            sf.pack(side=tk.TOP, fill=tk.BOTH, expand=True)

            return fixed, sf

        # ===============================
        # SCROLLABLE VERSION
        # ===============================
        style = ttk.Style()
        style.layout(
            'Minimal.Vertical.TScrollbar',
            [('Vertical.Scrollbar.trough', {
                'children': [('Vertical.Scrollbar.thumb', {'expand': '1', 'sticky': 'nswe'})],
                'sticky': 'ns'
            })]
        )
        style.configure(
            "Minimal.Vertical.TScrollbar",
            troughcolor="#2b2b2b",
            background="#666666",
            relief="flat",
            borderwidth=0,
            troughborderwidth=3
        )
        style.map(
            "Minimal.Vertical.TScrollbar",
            troughbordercolor=[('!disabled', '#121212')]
        )

        # Container
        content_frame = tk.Frame(parent, bg="#121212")
        content_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        # Fixed (non-scrolling header area)
        fixed = ttk.Frame(content_frame)
        fixed.pack(side=tk.TOP, fill=tk.X)

        # Canvas
        canvas = tk.Canvas(
            content_frame,
            highlightthickness=0,
            bg="#121212"
        )
        canvas.pack(side=tk.TOP, fill=tk.BOTH, expand=True)

        # Scrollbar (initially hidden)
        vs = ttk.Scrollbar(parent, orient="vertical", style="Minimal.Vertical.TScrollbar")

        def _update_scrollbar():
            canvas.update_idletasks()
            bbox = canvas.bbox("all")

            if not bbox:
                vs.pack_forget()
                return

            content_height = bbox[3] - bbox[1]
            view_height = canvas.winfo_height()

            if content_height <= view_height + 2:
                vs.pack_forget()
            else:
                if not vs.winfo_ismapped():
                    vs.pack(side=tk.RIGHT, fill=tk.Y)

        vs.config(command=canvas.yview)
        canvas.configure(
            yscrollcommand=lambda *args: (vs.set(*args), _update_scrollbar())
        )

        # Scrollable frame
        sf = ttk.Frame(canvas, padding=(0, 0, 5, 12))
        cw = canvas.create_window((0, 0), window=sf, anchor="nw")

        # Resize + scroll tracking
        sf.bind(
            "<Configure>",
            lambda e: (
                canvas.configure(scrollregion=canvas.bbox("all")),
                _update_scrollbar()
            )
        )

        canvas.bind(
            "<Configure>",
            lambda e: (
                canvas.itemconfig(cw, width=e.width),
                _update_scrollbar()
            )
        )

        # Mouse wheel
        def _on_mousewheel(event):
            try:
                if canvas.winfo_exists():
                    canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
            except Exception:
                pass
        
        content_frame.bind("<Enter>", lambda _: canvas.bind_all("<MouseWheel>", _on_mousewheel))
        content_frame.bind("<Leave>", lambda _: canvas.unbind_all("<MouseWheel>"))

        return fixed, sf


    def dark_entry(self, parent, var=None, width=15):
        e = tk.Entry(parent, width=width, **self.entry_conf)
        if var: e.config(textvariable=var)
        return e

    def create_checkbox(self, parent, text, variable=None, window_key=None, command=None):
        if variable is None: variable = tk.BooleanVar()
        if window_key:
            if window_key not in self.active_vars: self.active_vars[window_key] = []
            self.active_vars[window_key].append(variable)
        f = tk.Frame(parent, bg="#121212")
        f.pack(fill=tk.X, pady=2, padx=5)
        box = tk.Label(f, text="", width=3, bg="#2a2a2a", fg="#00ff00", font=("Arial", 9, "bold"), cursor="hand2")
        box.pack(side=tk.LEFT, padx=(0, 10))
        lbl = tk.Label(f, text=text, bg="#121212", fg="#dddddd", font=("Segoe UI", 9), cursor="hand2")
        lbl.pack(side=tk.LEFT)
        def toggle(event=None):
            variable.set(not variable.get())
            if command: command() 
        def update_visual(*args):
            box.config(text="✔" if variable.get() else "", fg="#00ff00" if variable.get() else "#000000")
        box.bind("<Button-1>", toggle); lbl.bind("<Button-1>", toggle)
        variable.trace_add("write", update_visual); update_visual() 
        return f

    # ===============================
    # LIVE ENTITIES UI (NEW)
    # ===============================
    def build_live_entities_ui(self, win):
        # 1. Header & Draggable
        h = tk.Label(win, text="Live Entities", bg="#333333", fg="white", font=("Segoe UI", 10, "bold"), pady=6)
        h.pack(fill=tk.X)
        if not self.allow_resize.get():
            self.make_draggable(h, win, "Live Entities", is_group_move=False)

        c_btn = tk.Label(h, text="x", bg="#333333", fg="#888", font=("Arial", 12), cursor="hand2")
        c_btn.pack(side=tk.RIGHT, padx=10)
        c_btn.bind("<Button-1>", lambda e: self.close_tool_window(win, "Live Entities"))

        # 2. Notebook (Tabs)
        notebook = ttk.Notebook(win)
        notebook.pack(fill=tk.BOTH, expand=True, padx=2, pady=2)

        tab_players = tk.Frame(notebook, bg="#121212")
        tab_npcs = tk.Frame(notebook, bg="#121212")
        tab_objects = tk.Frame(notebook, bg="#121212")

        notebook.add(tab_players, text='Players')
        notebook.add(tab_npcs, text='NPCs')
        notebook.add(tab_objects, text='Objects')

        if not hasattr(self, "live_ui_elements"):
            self.live_ui_elements = {}

        # 3. Build Each Tab Content
        self._build_live_tab(tab_players, "Players")
        self._build_live_tab(tab_npcs, "NPCs")
        self._build_live_tab(tab_objects, "Objects")

        # Set default tab
        self.current_live_category = "Players"

        # 4. Auto-Refresh on Tab Change
        def on_tab_change(event):
            try:
                current_idx = notebook.index(notebook.select())
                cats = ["Players", "NPCs", "Objects"]
                self.current_live_category = cats[current_idx]
                self.refresh_live_list(self.current_live_category)
            except: pass

        notebook.bind("<<NotebookTabChanged>>", on_tab_change)
        
        # Trigger initial load
        self.root.after(100, lambda: self.refresh_live_list("Players"))

        # --- NEW: MASTER LIVE POLLING LOOP ---
        def master_live_loop():
            # Berhenti jika window ditutup
            if not win.winfo_exists(): return
            
            # Tarik data live untuk tab yang sedang terbuka
            if hasattr(self, "current_live_category"):
                self.refresh_live_list(self.current_live_category)
                
            # Ulangi setiap 300ms (Cukup responsif, tidak membebani CPU)
            win.after(300, master_live_loop) 

        master_live_loop() # Jalankan loop

    def _build_live_tab(self, parent, category):
        fixed_top, scroll_frame = self.create_scroll_area(parent, scroll=True)

        search_var = tk.StringVar()
        attitude_var = tk.StringVar(value="All")
        sort_var = tk.StringVar(value="Distance")
        limit_var = tk.StringVar(value="30") 
        radius_var = tk.StringVar(value="150")

        # --- VARIABEL BARU (Arah Pengurutan & Gatherable) ---
        sort_dir_var = tk.StringVar(value="Asc")
        gather_var = tk.StringVar(value="All")

        # --- LOAD LAST STATE UNTUK SEARCH & EXCLUDE ---
        search_var = tk.StringVar(value=self.saved_inputs.get(f"live_src_{category}", ""))
        exclude_var = tk.StringVar(value=self.saved_inputs.get(f"live_exc_{category}", ""))
        
        attitude_var = tk.StringVar(value="All")
        sort_var = tk.StringVar(value="Distance")
        limit_var = tk.StringVar(value="30") 
        radius_var = tk.StringVar(value="150")
        sort_dir_var = tk.StringVar(value="Asc")
        gather_var = tk.StringVar(value="All")

        # --- KONTROL FILTER (RESPONSIF) ---
        ctrl_frame = tk.Frame(fixed_top, bg="#1e1e1e", pady=5)
        ctrl_frame.pack(fill=tk.X, padx=5)

        # Baris Atas: Include & Exclude
        top_ctrl = tk.Frame(ctrl_frame, bg="#1e1e1e")
        top_ctrl.pack(fill=tk.X, pady=(0, 2))
        
        tk.Label(top_ctrl, text="🔍 Inc:", bg="#1e1e1e", fg="#00ff00", font=("Segoe UI", 8)).pack(side=tk.LEFT, padx=(0, 2))
        ent_search = tk.Entry(top_ctrl, textvariable=search_var, bg="#333", fg="white", relief="flat", insertbackground="white", width=12)
        ent_search.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=2) 
        
        tk.Label(top_ctrl, text="Exc:", bg="#1e1e1e", fg="#ff4444", font=("Segoe UI", 8)).pack(side=tk.LEFT, padx=(2, 2))
        ent_exclude = tk.Entry(top_ctrl, textvariable=exclude_var, bg="#333", fg="white", relief="flat", insertbackground="white", width=12)
        ent_exclude.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=2) 

        btn_refresh = tk.Label(top_ctrl, text="⟳", bg="#1e1e1e", fg="#888", font=("Segoe UI", 12), cursor="hand2")
        btn_refresh.pack(side=tk.RIGHT, padx=(2, 0))

        # Baris Bawah: Dropdowns
        bot_ctrl = tk.Frame(ctrl_frame, bg="#1e1e1e")
        bot_ctrl.pack(fill=tk.X)

        att_opt = ttk.OptionMenu(bot_ctrl, attitude_var, "All", "All", "Hostile", "Neutral", "Friendly", "Indiff")
        att_opt.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=(0, 1))

        sort_opt = ttk.OptionMenu(bot_ctrl, sort_var, "Distance", "Distance", "Name", "HP")
        sort_opt.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=1)

        # --- TOMBOL ARAH SORTING (▲/▼) ---
        def toggle_sort_dir():
            if sort_dir_var.get() == "Asc":
                sort_dir_var.set("Desc")
                btn_sort_dir.config(text="▼")
            else:
                sort_dir_var.set("Asc")
                btn_sort_dir.config(text="▲")
            self.refresh_live_list(category)

        btn_sort_dir = tk.Button(bot_ctrl, text="▲", bg="#333", fg="white", relief="flat", width=2, font=("Arial", 8), command=toggle_sort_dir)
        btn_sort_dir.pack(side=tk.LEFT, padx=1)

        limit_opt = ttk.OptionMenu(bot_ctrl, limit_var, "30", "10", "30", "60", "All")
        limit_opt.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=1)

        rad_opt = ttk.OptionMenu(bot_ctrl, radius_var, "99999", "150", "300", "1000", "5000", "99999")
        rad_opt.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=(1, 0))

        # --- BARIS EKSTRA: FILTER GATHERABLE (HANYA UNTUK OBJECTS) ---
        if category == "Objects":
            obj_ctrl = tk.Frame(ctrl_frame, bg="#1e1e1e")
            obj_ctrl.pack(fill=tk.X, pady=(4, 0))
            tk.Label(obj_ctrl, text="Status:", bg="#1e1e1e", fg="#888", font=("Segoe UI", 8)).pack(side=tk.LEFT)
            gather_opt = ttk.OptionMenu(obj_ctrl, gather_var, "All", "All", "Gatherable", "Non Gatherable")
            gather_opt.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=(5, 0))
            gather_var.trace_add("write", lambda *_: self.refresh_live_list(category))

        self.live_ui_elements[category] = {
            "frame": scroll_frame,
            "search": search_var,
            "exclude": exclude_var, # <-- TAMBAHAN BARU
            "attitude": attitude_var,
            "sort": sort_var,
            "sort_dir": sort_dir_var,
            "limit": limit_var,
            "radius": radius_var,
            "gather": gather_var
        }

        def save_filter_state(*_):
            self.saved_inputs[f"live_src_{category}"] = search_var.get()
            self.saved_inputs[f"live_exc_{category}"] = exclude_var.get()
            self.save_settings()
            self.refresh_live_list(category)

        # Binds
        btn_refresh.bind("<Button-1>", lambda e: self.refresh_live_list(category))
        search_var.trace_add("write", save_filter_state)  # Gunakan fungsi save baru
        exclude_var.trace_add("write", save_filter_state) # Gunakan fungsi save baru
        attitude_var.trace_add("write", lambda *_: self.refresh_live_list(category))
    

    def refresh_live_list(self, category):
        ui_data = self.live_ui_elements.get(category)
        if not ui_data: return

        frame = ui_data["frame"]

        if not hasattr(self.logic, 'get_filtered_live_entities'):
            return

        # 1. TARIK DATA & TERAPKAN LIMIT
        try:
            limit_val = int(ui_data["limit"].get())
        except:
            limit_val = 9999

        try:
            rad_val = float(ui_data["radius"].get())
        except:
            rad_val = 99999.0

        # 1. TARIK DATA & BYPASS STRING FILTER DARI LOGIC
        entities = self.logic.get_filtered_live_entities(
            category=category,
            search_query="", # KITA MATIKAN FILTER DI SINI
            attitude=ui_data["attitude"].get(),
            sort_by=ui_data["sort"].get(),
            max_radius=rad_val
        )

        # =======================================================
        # INJEKSI FILTER STRING (REGEX SMART HYBRID)
        # =======================================================
        import re # Pastikan regex di-import
        
        search_text = ui_data["search"].get().lower()
        exclude_text = ui_data["exclude"].get().lower()
        
        inc_keywords = [k.strip() for k in search_text.split(',') if k.strip()]
        exc_keywords = [k.strip() for k in exclude_text.split(',') if k.strip()]
        
        # INCLUDE: Awalan kata (Bisa parsial. Misal: "Oric" cocok dengan "Orichalcum")
        inc_patterns = [re.compile(rf"\b{re.escape(k)}") for k in inc_keywords]
        
        # EXCLUDE: Kata utuh (Ketat. Misal: "Mini" tidak akan memotong "Minister")
        exc_patterns = [re.compile(rf"\b{re.escape(k)}\b") for k in exc_keywords]
        
        current_map_id = str(getattr(self.logic, "current_map_id", "0"))
        filtered_entities = []

        for ent in entities:
            raw_id = str(ent.get('id', '')).strip()
            species_id = str(ent.get('species_id', '')).strip()
            base_name = ent.get('name', 'Unknown')
            db_type = ent.get('db_type', '')

            # --- ISOLASI LOGIKA: PLAYER VS NPC/OBJ ---
            if category == "Players":
                lookup_id = raw_id
                true_name = base_name  # Pemain WAJIB memakai nama asli dari memori
                db_type = ""           # Pemain tidak memiliki tipe
            else:
                lookup_id = species_id if species_id and species_id != "None" else raw_id
                true_name = core.get_def_name(lookup_id, default_name=base_name)
    
            # Rangkai format lengkap: [Alias] Nama {Tipe}
            display_name = ent.get("name", "Unknown")
                
            ent['_cached_display_name'] = display_name 
            search_target = display_name.lower()

            # EXCLUDE LOGIC: Gunakan Regex Kata Utuh
            if exc_patterns and any(p.search(search_target) for p in exc_patterns):
                continue
                
            # INCLUDE LOGIC: Gunakan Regex Awalan Kata
            if inc_patterns and not any(p.search(search_target) for p in inc_patterns):
                continue
                
            filtered_entities.append(ent)
            
        # Timpa data mentah dengan data yang sudah terfilter murni
        entities = filtered_entities

        # =======================================================
        # INJEKSI 1: FILTER GATHERABLE (Hanya untuk Objects)
        # =======================================================
        if category == "Objects":
            gather_status = ui_data["gather"].get()
            if gather_status == "Gatherable":
                entities = [e for e in entities if e.get('is_gatherable') is True]
            elif gather_status == "Non Gatherable":
                entities = [e for e in entities if e.get('is_gatherable') is not True]

        # =======================================================
        # INJEKSI 2: PENGURUTAN DINAMIS UI LEVEL (Asc/Desc)
        # =======================================================
        sort_by = ui_data["sort"].get()
        is_desc = (ui_data["sort_dir"].get() == "Desc")

        # Re-kalkulasi jarak aman jika terlewat oleh logic backend
        current_pos = core.read_coords()
        cx, cy, cz = current_pos if current_pos else (0, 0, 0)
        import math
        for e in entities:
            if 'distance' not in e and all(k in e for k in ('x','y','z')):
                e['distance'] = math.sqrt((e['x'] - cx)**2 + (e['y'] - cy)**2 + (e['z'] - cz)**2)

        if sort_by == "Distance":
            entities.sort(key=lambda x: x.get('distance', 999999), reverse=is_desc)
        elif sort_by == "Name":
            entities.sort(key=lambda x: str(x.get('name', '')).lower(), reverse=is_desc)
        elif sort_by == "HP":
            entities.sort(key=lambda x: float(x.get('hp_cur', 0)), reverse=is_desc)
            
        # =======================================================

        # --- LOGIKA MULTI-PIN & CACHE CERDAS (Bypass Filter & Auto-Recovery) ---
        if not hasattr(self, 'pinned_entities'):
            self.pinned_entities = {}

        # 1. Ambil data dari Filtered Scanner (Data normal sesuai Tab & Radius saat ini)
        scanner_ids = {str(e.get('id', '')).strip(): e for e in entities}
        scanner_names = {e.get('name', 'Unknown'): e for e in entities if e.get('name') and not e.get('name').startswith("ID:")}

        # 2. Ambil data dari RAW Scanner (Bypass mutlak semua filter UI)
        raw_entities = self.logic.get_live_entities() if hasattr(self.logic, 'get_live_entities') else []
        raw_ids = {str(e.get('id', '')).strip(): e for e in raw_entities}
        raw_names = {e.get('real_name', 'Unknown').strip(): e for e in raw_entities if e.get('real_name') and e.get('real_name') != "Unknown"}

        # Posisi player saat ini untuk menghitung ulang jarak secara real-time
        import math
        current_pos = core.read_coords()
        cx, cy, cz = current_pos if current_pos else (0, 0, 0)

        pinned_list = []
        new_pinned_dict = {}
        processed_ids = set()

        for pid, p_ent in list(self.pinned_entities.items()):
            # --- FILTER TAB PRESISI ---
            p_cat = p_ent.get('pinned_category', category)
            if p_cat != category:
                # Beda tab: Simpan kembali ke memori agar tidak hilang, tapi lewati proses render
                new_pinned_dict[pid] = p_ent 
                continue

            p_name = p_ent.get('name', 'Unknown')
            real_name_fallback = p_ent.get('real_name', p_name) # Nama murni dari engine
            
            fresh_ent = None

            # PRIORITAS 1: Entitas ada di daftar UI normal
            if pid in scanner_ids:
                fresh_ent = scanner_ids[pid]
            elif p_name in scanner_names:
                fresh_ent = scanner_names[p_name]
                
            # PRIORITAS 2: Hak Istimewa Bypass (Tarik paksa dari Raw Data jika tersembunyi oleh filter)
            elif pid in raw_ids:
                fresh_ent = dict(raw_ids[pid]) # Clone dictionary agar aman
            elif real_name_fallback in raw_names:
                fresh_ent = dict(raw_names[real_name_fallback])

            if fresh_ent:
                # Pastikan atribut krusial ada jika data ditarik paksa dari memori RAW
                if all(k in fresh_ent for k in ('x','y','z')):
                    fresh_ent['distance'] = math.sqrt((fresh_ent['x'] - cx)**2 + (fresh_ent['y'] - cy)**2 + (fresh_ent['z'] - cz)**2)
                if 'name' not in fresh_ent:
                    fresh_ent['name'] = p_name
                if 'hp_cur' not in fresh_ent:
                    fresh_ent['hp_cur'] = fresh_ent.get('hp_cur', p_ent.get('hp_cur', 0))

                # Auto-Recovery Agent ID
                new_pid = str(fresh_ent.get('id', '')).strip()
                
                # Wariskan kembali tag kategori agar tidak hilang di frame berikutnya
                fresh_ent['pinned_category'] = p_cat 
                
                new_pinned_dict[new_pid] = fresh_ent 
                pinned_list.append(fresh_ent)
                processed_ids.add(new_pid)
                
            else:
                # PRIORITAS 3: GHOST DATA AKTUAL (Benar-benar lenyap dari server)
                # Hitung ulang jarak ke koordinat mati agar indikator "Dist(m)" UI tidak freeze
                if all(k in p_ent for k in ('x','y','z')):
                    ghost_dist = math.sqrt((p_ent['x'] - cx)**2 + (p_ent['y'] - cy)**2 + (p_ent['z'] - cz)**2)
                    p_ent['distance'] = ghost_dist
                
                new_pinned_dict[pid] = p_ent
                pinned_list.append(p_ent)

        # Update cache utama
        self.pinned_entities = new_pinned_dict
        
        # Bersihkan entitas duplikat di list normal
        entities = [e for e in entities if str(e.get('id', '')).strip() not in processed_ids]
        
        # Letakkan Pinned di tahta tertinggi (Index 0)
        entities = pinned_list + entities

        # Potong list berdasarkan limit setelah Pinned diamankan
        limit_str = ui_data["limit"].get()
        limit_val = int(limit_str) if limit_str.isdigit() else 9999
        entities = entities[:limit_val]

        # 2. INISIALISASI UI OBJECT POOL
        if "row_pool" not in ui_data:
            ui_data["row_pool"] = []
            ui_data["empty_lbl"] = tk.Label(frame, text="No entities found.", bg="#121212", fg="#888")

        pool = ui_data["row_pool"]

        # 3. UPDATE WIDGET YANG SUDAH ADA / BUAT BARU JIKA POOL KURANG
        pos = self.logic.read_live_coords()
        cx, cy, cz = pos if pos else (0,0,0)

        if not entities:
            ui_data["empty_lbl"].pack(pady=20)
        else:
            ui_data["empty_lbl"].pack_forget()

        for i, ent in enumerate(entities):
            # Jika jumlah entitas melebihi slot di pool, buat slot baru
            if i >= len(pool):
                row = tk.Frame(frame, bg="#1e1e1e", pady=2, cursor="hand2")
                
                # 1. KONTAINER TOMBOL (Di-pack ke Kanan PERTAMA agar tidak tertimpa)
                btn_frame = tk.Frame(row, bg="#1e1e1e", cursor="hand2")
                btn_frame.pack(side=tk.RIGHT, fill=tk.Y, padx=2)
                
                # 2. KONTAINER TEKS (Di-pack KEDUA ke Kiri memakan sisa ruang)
                text_frame = tk.Frame(row, bg="#1e1e1e", cursor="hand2")
                text_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5)

                name_lbl = tk.Label(text_frame, text="", bg="#1e1e1e", fg="white", font=("Segoe UI", 9, "bold"), anchor="w", cursor="hand2")
                name_lbl.pack(side=tk.TOP, fill=tk.X)
         
                info_lbl = tk.Label(text_frame, text="", bg="#1e1e1e", fg="#aaaaaa", font=("Segoe UI", 8), anchor="w", cursor="hand2")
                info_lbl.pack(side=tk.TOP, fill=tk.X)

                btn_style = {"bg": "#1e1e1e", "fg": "#aaaaaa", "activebackground": "#444444", "activeforeground": "white", "relief": "flat", "width": 3, "font": ("Segoe UI", 10), "cursor": "hand2", "bd": 0}
                
                btn_save = tk.Button(btn_frame, text="💾", **btn_style)
                btn_alias = tk.Button(btn_frame, text="🏷️", **btn_style)
                btn_type = tk.Button(btn_frame, text="📌", **btn_style)
                
                if category != "Players":
                    btn_save.pack(side=tk.RIGHT, padx=1)
                    btn_type.pack(side=tk.RIGHT, padx=1)
                    btn_alias.pack(side=tk.RIGHT, padx=1)
                
                btn_copy_name = tk.Button(btn_frame, text="📝", **btn_style)
                btn_copy_name.pack(side=tk.RIGHT, padx=1)

                btn_copy_coord = tk.Button(btn_frame, text="📍", **btn_style)
                btn_copy_coord.pack(side=tk.RIGHT, padx=1)

                pool.append({
                    "row": row,
                    "text_frame": text_frame,
                    "btn_frame": btn_frame,
                    "name_lbl": name_lbl,
                    "info_lbl": info_lbl,
                    "btn_save": btn_save,
                    "btn_type": btn_type,
                    "btn_alias": btn_alias,
                    "btn_copy_coord": btn_copy_coord,
                    "btn_copy_name": btn_copy_name,
                    "is_packed": False
                })
            w = pool[i]

            # Pastikan frame tampil
            if not w["is_packed"]:
                w["row"].pack(fill=tk.X, pady=1)
                w["is_packed"] = True

            # Kalkulasi Jarak
            ex = ent.get('x', 0)
            ey = ent.get('y', 0)
            ez = ent.get('z', 0)

            dx, dy, dz = ex - cx, ey - cy, ez - cz
            dist = math.sqrt(dx**2 + dy**2 + dz**2)
            
            # Format Text - MENGAMBIL att_str YANG SUDAH DIPROSES OLEH LOGIC
            att_str = ent.get('att_str', "Neutral")

            color = "#ffffff"
            if att_str == "Hostile": color = "#ff4d4d"
            elif att_str == "Friendly": color = "#4dff4d"
            elif att_str == "Neutral": color = "#e6e600" 

            # Ambil nama yang sudah di-cache dari blok filter di atas
            display_name = ent.get('_cached_display_name', ent.get('name', 'Unknown'))
            raw_id = str(ent.get('id', '')).strip()
                
            info_str = f"ID:{raw_id} | Dist: {dist:.1f}m | HP: {int(ent.get('hp_cur', 0))}/{int(ent.get('hp_max', 0))}"

            # --- CEK STATUS MULTI-PINNED ---
            is_pinned = (raw_id in getattr(self, 'pinned_entities', {}))
            
            if is_pinned:
                new_name = f"📌 {display_name}"
                base_bg = "#3a2a00" # Background Emas Gelap untuk entitas yang di-Pin
                hover_bg = "#553d00"
            else:
                new_name = display_name
                base_bg = "#1e1e1e" # Background Normal
                hover_bg = "#2a2a2a"

            # Eksekusi Update Text
            if w["name_lbl"].cget("text") != new_name:
                w["name_lbl"].config(text=new_name, fg=color)
            if w["info_lbl"].cget("text") != info_str:
                w["info_lbl"].config(text=info_str)

            # Eksekusi Update Warna Latar Belakang secara sinkron
            for widget in [w["row"], w["text_frame"], w["btn_frame"], w["name_lbl"], w["info_lbl"], w["btn_save"], w["btn_copy_coord"], w["btn_copy_name"]]:
                if widget.winfo_exists() and widget.cget("bg") != base_bg:
                    widget.config(bg=base_bg)

            # --- DYNAMIC HOVER BINDING ---
            def on_enter(e, r=w["row"], tf=w["text_frame"], bf=w["btn_frame"], nl=w["name_lbl"], il=w["info_lbl"], b1=w["btn_save"], b2=w["btn_copy_name"], b3=w["btn_copy_coord"], h_bg=hover_bg):
                for widget in [r, tf, bf, nl, il, b1, b2, b3]: 
                    if widget.winfo_exists(): widget.config(bg=h_bg)
            
            def on_leave(e, r=w["row"], tf=w["text_frame"], bf=w["btn_frame"], nl=w["name_lbl"], il=w["info_lbl"], b1=w["btn_save"], b2=w["btn_copy_name"], b3=w["btn_copy_coord"], b_bg=base_bg):
                for widget in [r, tf, bf, nl, il, b1, b2, b3]: 
                    if widget.winfo_exists(): widget.config(bg=b_bg)

            w["row"].bind("<Enter>", on_enter); w["row"].bind("<Leave>", on_leave)
            w["text_frame"].bind("<Enter>", on_enter); w["text_frame"].bind("<Leave>", on_leave)
            w["btn_frame"].bind("<Enter>", on_enter); w["btn_frame"].bind("<Leave>", on_leave)
            w["name_lbl"].bind("<Enter>", on_enter); w["name_lbl"].bind("<Leave>", on_leave)
            w["info_lbl"].bind("<Enter>", on_enter); w["info_lbl"].bind("<Leave>", on_leave)
            
            # --- BINDING KLIK KIRI (TELEPORT) & KLIK KANAN (TOGGLE PIN) ---
            def do_tp(e, cx=ent['x'], cy=ent['y'], cz=ent['z']):
                self.logic.teleport_to_exact_coords(cx, cy, cz)
                
            def do_pin(e, target_ent=ent, t_name=display_name, t_id=raw_id):
                if not hasattr(self, 'pinned_entities'): self.pinned_entities = {}
                if t_id in self.pinned_entities:
                    del self.pinned_entities[t_id]
                    self.show_center_notification(f"❌ UNPINNED:\n{t_name}", "#ffaa00")
                else:
                    # SIMPAN NAMA TAB SECARA PERMANEN KE DALAM ENTITAS
                    target_ent['pinned_category'] = category 
                    self.pinned_entities[t_id] = target_ent
                    self.show_center_notification(f"📌 PINNED:\n{t_name}", "#00aaff")
                self.refresh_live_list(category)

            # Pasang binding hit-box pada semua elemen kontainer baru
            for target in [w["row"], w["text_frame"], w["btn_frame"], w["name_lbl"], w["info_lbl"]]:
                if target.winfo_exists():
                    target.bind("<Button-1>", do_tp)
                    target.bind("<Button-3>", do_pin)
            
            # --- BINDING TOMBOL ICONS ---
            w["btn_copy_coord"].config(command=lambda cx=ent['x'], cy=ent['y'], cz=ent['z']: pyperclip.copy(f"{cx:.2f}, {cy:.2f}, {cz:.2f}"))
            w["btn_copy_name"].config(command=lambda n=display_name: pyperclip.copy(n))
            w["btn_type"].config(command=lambda ent_data=ent: self.set_type_prompt(ent_data))
            if category != "Players": 
                w["btn_save"].config(command=lambda ent_data=ent: self.save_to_def_db_prompt(ent_data))
                w["btn_alias"].config(command=lambda ent_data=ent: self.set_alias_prompt(ent_data))

        # 4. SEMBUNYIKAN SISA WIDGET YANG TIDAK TERPAKAI
        for i in range(len(entities), len(pool)):
            w = pool[i]
            if w["is_packed"]:
                w["row"].pack_forget()
                w["is_packed"] = False

    def save_to_def_db_prompt(self, ent):
        raw_id = str(ent.get('id', '')).strip()
        species_id = str(ent.get('species_id', '')).strip()
        lookup_id = species_id if species_id and species_id != "None" else raw_id

        current_name = core.get_def_name(lookup_id, ent.get('name', 'Unknown'))
        new_name = simpledialog.askstring("Save Name", f"Set permanent name for ID {lookup_id}:", initialvalue=current_name, parent=self.root)

        if new_name is not None and new_name.strip() != "":
            success, target_db = core.save_custom_data(ent, new_name=new_name.strip())
            if success:
                self.show_center_notification(f"{target_db} SAVED:\n{new_name}", "#00ff00")
                if hasattr(self, "current_live_category"):
                    self.refresh_live_list(self.current_live_category)

    def set_type_prompt(self, ent):
        raw_id = str(ent.get('id', '')).strip()
        species_id = str(ent.get('species_id', '')).strip()
        lookup_id = species_id if species_id and species_id != "None" else raw_id

        current_type = ent.get('db_type', '')
        new_type = simpledialog.askstring("Set Type", f"Set object/NPC type (e.g., Boss, Vendor, Ore):", initialvalue=current_type, parent=self.root)

        if new_type is not None:
            success, target_db = core.save_custom_data(ent, new_type=new_type.strip())
            if success:
                self.show_center_notification(f"TYPE SET:\n{new_type}", "#00aaff")
                if hasattr(self, "current_live_category"):
                    self.refresh_live_list(self.current_live_category)

    def set_alias_prompt(self, ent):
        import tkinter.simpledialog as simpledialog
        import gw2x_data as data

        current_map_id = self.logic.current_map_id

        # Determine lookup ID
        lookup_id = ent.get("species_id")
        if not lookup_id:
            lookup_id = ent.get("id")

        lookup_id = str(lookup_id)

        current_alias = data.get_alias(current_map_id, ent) or ""

        new_alias = simpledialog.askstring(
            "Set Alias",
            f"Set alias for ID {lookup_id} in Map {current_map_id}\n(Leave blank to remove):",
            initialvalue=current_alias,
            parent=self.root
        )

        if new_alias is not None:
            data.save_alias(current_map_id, ent, new_alias.strip())
            if new_alias.strip() == "":
                # 3. Hapus dengan Map ID
                if current_map_id in data.ALIASES and str(lookup_id) in data.ALIASES[current_map_id]:
                    del data.ALIASES[current_map_id][str(lookup_id)]
                    data.save_alias(current_map_id, lookup_id, "")
                    self.show_center_notification("ALIAS REMOVED", "#ffaa00")
            else:
                # 4. Simpan dengan Map ID
                data.save_alias(current_map_id, lookup_id, new_alias.strip())
                self.show_center_notification(f"ALIAS SET:\n[{new_alias}]", "#00aaff")

            if hasattr(self, "current_live_category"):
                self.refresh_live_list(self.current_live_category)
    # ===============================
    # INDIVIDUAL UI SECTIONS
    # ===============================    

    def init_combat_macro_files(self):
        import os
        import types
        import textwrap

        KEY_CONFIG_FILE = "gw2x_key_config.txt"

        # 1. Define Defaults (Updated with Fishing Keys)
        DEFAULT_KEY_CONFIG = textwrap.dedent("""\
# GW2X KEY SETTINGS (DIRECT INPUT SCAN CODES - HEX)

# --- COMBAT SKILLS ---
SKILL_1 = "02"
SKILL_2 = "03"
SKILL_3 = "04"
SKILL_4 = "05"
SKILL_5 = "06"
SKILL_6 = "07"
SKILL_7 = "08"
SKILL_8 = "09"
SKILL_9 = "0A"
SKILL_10 = "0B"

SPECIAL1 = "3B"
SPECIAL2 = "3C"
SPECIAL3 = "3D"
SPECIAL4 = "3E"
SPECIAL5 = "3F"
SPECIAL6 = "40"

SWAP_WEAPON = "29"
DODGE = "2F"
INTERACT = "21"
ESCAPE = "01"
MOVE_FORWARD = "11"
MOVE_BACK = "1F"

# --- FISHING CONFIG ---
# fishinghotkeyDirectInput: Tombol skill pancing (biasanya sama dengan SKILL_1 / "02")
fishinghotkeyDirectInput = "02"

# slow_fishinghotkey1: Tombol Geser Kiri (Skill 2 / "03")
slow_fishinghotkey1 = "03"

# slow_fishinghotkey2: Tombol Geser Kanan (Skill 3 / "04")
slow_fishinghotkey2 = "04"

# fishinghotkey: Tombol Fast Fishing (Opsional)
fishinghotkey = "00"

# --- FISHING SETTINGS ---
fishing_power = "0"
fishing_slowassist_rethrow = "1"
insta_fishing_delay = "0.02"
RethrowDelay = "1.0"
""")

        # 2. Create file if it doesn't exist
        if not os.path.exists(KEY_CONFIG_FILE):
            with open(KEY_CONFIG_FILE, "w", encoding="utf-8") as f:
                f.write(DEFAULT_KEY_CONFIG)

        # 3. Read current content
        with open(KEY_CONFIG_FILE, "r", encoding="utf-8") as f:
            content = f.read()

        # 4. AUTO-UPDATE: Append Missing Keys
        # List of critical keys required by gw2x_fishing.py
        required_keys = {
            "fishinghotkeyDirectInput": 'fishinghotkeyDirectInput = "02"',
            "slow_fishinghotkey1": 'slow_fishinghotkey1 = "03"',
            "slow_fishinghotkey2": 'slow_fishinghotkey2 = "04"',
            "fishinghotkey": 'fishinghotkey = "00"',
            "DODGE": 'DODGE = "2F"',
            "INTERACT": 'INTERACT = "21"',
            "RethrowDelay": 'RethrowDelay = "1.0"'
        }
        
        updates_made = False
        with open(KEY_CONFIG_FILE, "a", encoding="utf-8") as f:
            for key, default_line in required_keys.items():
                if f"{key} =" not in content and f"{key}=" not in content:
                    print(f"[UI] Adding missing config: {key}")
                    f.write(f"\n{default_line}\n")
                    updates_made = True

        # Refresh content if updates were made
        if updates_made:
            with open(KEY_CONFIG_FILE, "r", encoding="utf-8") as f:
                content = f.read()

        # 5. Legacy Check
        if 'SKILL_1 = "31"' in content:
            print("[UI] Detected legacy Virtual Keys. Resetting to Scan Codes...")
            with open(KEY_CONFIG_FILE, "w", encoding="utf-8") as f:
                f.write(DEFAULT_KEY_CONFIG)
            content = DEFAULT_KEY_CONFIG

        # 6. Load the config
        sanitized = "\n".join(
            line for line in content.splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )

        self.skill_key_hotkey = types.ModuleType("skill_key_config")
        try:
            exec(sanitized.lstrip("\ufeff \t\r\n"), self.skill_key_hotkey.__dict__)
            
            # Ensure attributes exist even if file load failed slightly
            defaults = {
                "INTERACT": "21",
                "ESCAPE": "01",
                "fishinghotkeyDirectInput": "02",
                "slow_fishinghotkey1": "03",
                "slow_fishinghotkey2": "04"
            }
            
            for k, v in defaults.items():
                if not hasattr(self.skill_key_hotkey, k):
                    setattr(self.skill_key_hotkey, k, v)

        except Exception as e:
            print(f"[UI] Error loading key config: {e}")

    def update_combat_key(self):
        try:
            with open("GW2X_SKILL_KEY_CONFIG.txt", "r", encoding="utf-8") as f:
                contents = f.read()
        except FileNotFoundError:
            messagebox.showerror("Error", "Skill key config not found")
            return

        updated = False

        for line in contents.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue

            name, val = line.split("=", 1)
            name = name.strip()
            val = val.strip().strip('"').strip("'")

            if not hasattr(self.skill_key_hotkey, name):
                continue

            old = getattr(self.skill_key_hotkey, name)
            if old != val:
                setattr(self.skill_key_hotkey, name, val)
                updated = True
                print(f"[CombatKey] {name}: {old} -> {val}")

        # --- ADD THIS BLOCK AT THE END OF THE FUNCTION ---
        # Sync the new key to logic immediately
        if not hasattr(self.logic, "skill9_scan"):
            self.logic.skill9_scan = getattr(self.skill_key_hotkey, "SKILL_9", "2F")
            updated = True
            
        if updated:
            messagebox.showinfo("Combat Macro", "Skill keys updated successfully")
        else:
            messagebox.showinfo("Combat Macro", "No changes detected")
    
    def _force_stop_macro(self, key):
        if self.macro_state[key]:
            self.combat_macro.stop(key)
            self.macro_state[key] = False
            self.macro_paused[key] = False
            print(f"[Macro {key}] FORCE STOP")
            # --- NOTIFICATION ---
            self.show_center_notification(f"MACRO {key} STOPPED", "#ff4444") # Merah

    def toggle_macro_a(self):
        # --- 1. SAFETY CHECK: APAKAH MACRO KOSONG? ---
        if not self.combat_macro.macros["A"]["actions"]:
            print("[Macro A] Failed to start: No actions loaded.")
            # Tampilkan notifikasi peringatan di tengah layar (Merah)
            self.show_center_notification("⚠ LOAD MACRO A FIRST!", "#ff4444")
            return

        # --- 2. STOP LOGIC ---
        if self.macro_state["A"]:
            self.combat_macro.stop("A")
            self.macro_state["A"] = False
            self.macro_paused["A"] = False
            print("[Macro A] STOP")
            self.show_center_notification("MACRO A: STOPPED", "#ff4444")
            return

        # --- 3. START LOGIC ---
        self._force_stop_macro("B") # Pastikan Macro B mati dulu

        self.combat_macro.start("A")
        self.macro_state["A"] = True
        self.macro_paused["A"] = False
        print("[Macro A] START")
        self.show_center_notification("MACRO A: STARTED", "#00ff00")

    def pause_macro_a(self):
        if not self.macro_state["A"]:
            return

        if self.macro_paused["A"]:
            self.combat_macro.resume("A")
            self.macro_paused["A"] = False
            print("[Macro A] RESUME")
            # --- NOTIFICATION ---
            self.show_center_notification("MACRO A: RESUMED", "#00ff00")
        else:
            self.combat_macro.pause("A")
            self.macro_paused["A"] = True
            print("[Macro A] PAUSE")
            # --- NOTIFICATION ---
            self.show_center_notification("MACRO A: PAUSED", "#ffcc00") # Kuning/Oranye

    def toggle_macro_b(self):
        # --- 1. SAFETY CHECK: APAKAH MACRO KOSONG? ---
        if not self.combat_macro.macros["B"]["actions"]:
            print("[Macro B] Failed to start: No actions loaded.")
            # Tampilkan notifikasi peringatan di tengah layar (Merah)
            self.show_center_notification("⚠ LOAD MACRO B FIRST!", "#ff4444")
            return

        # --- 2. STOP LOGIC ---
        if self.macro_state["B"]:
            self.combat_macro.stop("B")
            self.macro_state["B"] = False
            self.macro_paused["B"] = False
            print("[Macro B] STOP")
            self.show_center_notification("MACRO B: STOPPED", "#ff4444")
            return

        # --- 3. START LOGIC ---
        self._force_stop_macro("A") # Pastikan Macro A mati dulu

        self.combat_macro.start("B")
        self.macro_state["B"] = True
        self.macro_paused["B"] = False
        print("[Macro B] START")
        self.show_center_notification("MACRO B: STARTED", "#00ff00")

    def pause_macro_b(self):
        if not self.macro_state["B"]:
            return

        if self.macro_paused["B"]:
            self.combat_macro.resume("B")
            self.macro_paused["B"] = False
            print("[Macro B] RESUME")
            # --- NOTIFICATION ---
            self.show_center_notification("MACRO B: RESUMED", "#00ff00")
        else:
            self.combat_macro.pause("B")
            self.macro_paused["B"] = True
            print("[Macro B] PAUSE")
            # --- NOTIFICATION ---
            self.show_center_notification("MACRO B: PAUSED", "#ffcc00")
           
    def update_macro_ui_state(self, key, run_lbl, toggle_btn, pause_btn):
        is_running = self.macro_state[key]
        is_paused = self.macro_paused[key]
        
        # 1. Status Label
        if not is_running:
            run_lbl.config(text="Stopped", fg="#888")
        elif is_paused:
            run_lbl.config(text="Paused", fg="#ffaa00")
        else:
            run_lbl.config(text="Running", fg="#00ff00")
            
        # 2. Toggle Button (Start/Stop)
        if is_running:
            toggle_btn.config(text="■ Stop", bg="#550000", fg="#ffcccc")
        else:
            toggle_btn.config(text="▶ Start", bg="#004400", fg="#ccffcc")
            
        # 3. Pause Button
        if not is_running:
            pause_btn.config(state=tk.DISABLED, text="⏸ Pause", bg="#222")
        else:
            pause_btn.config(state=tk.NORMAL)
            if is_paused:
                pause_btn.config(text="▶ Resume", bg="#004488", fg="white")
            else:
                pause_btn.config(text="⏸ Pause", bg="#444400", fg="white")

    def prompt_macro_hotkey(self, action_key, display_name):
        """
        Opens a dialog to set a complex hotkey (e.g. Alt+Q) for a macro action.
        """
        dlg = tk.Toplevel(self.root)
        dlg.title(f"Set {display_name}")
        dlg.geometry(f"280x100+{self.root.winfo_x()+20}+{self.root.winfo_y()+20}")
        dlg.configure(bg="#121212")
        dlg.attributes("-topmost", True)
        dlg.grab_set()

        lbl = tk.Label(
            dlg, 
            text=f"Press keys for\n{display_name}...", 
            fg="#00aaff", bg="#121212", 
            font=("Segoe UI", 10, "bold")
        )
        lbl.pack(expand=True)

        user32 = ctypes.windll.user32
        self._hk_poll_active = True

        def poll():
            if not self._hk_poll_active or not dlg.winfo_exists(): return

            # 1. Check Modifiers
            mods = []
            mod_names = []
            if user32.GetAsyncKeyState(0x11) & 0x8000: mods.append(0x11); mod_names.append("Ctrl")
            if user32.GetAsyncKeyState(0x12) & 0x8000: mods.append(0x12); mod_names.append("Alt")
            if user32.GetAsyncKeyState(0x10) & 0x8000: mods.append(0x10); mod_names.append("Shift")

            # 2. Check Standard Keys
            detected_vk = None
            detected_name = ""
            
            # Scan common keys (0x08 to 0xFF)
            for vk in range(8, 255):
                # Skip modifier keys themselves to avoid binding just "Ctrl"
                if vk in (0x10, 0x11, 0x12, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5): continue
                
                if user32.GetAsyncKeyState(vk) & 0x8000:
                    if 0x30 <= vk <= 0x5A: detected_name = chr(vk)
                    elif 0x70 <= vk <= 0x87: detected_name = f"F{vk - 0x6F}"
                    else: detected_name = f"Key_{vk:02X}"
                    detected_vk = vk
                    break
            
            if detected_vk:
                self._hk_poll_active = False
                full_text = "+".join(mod_names + [detected_name])
                lbl.config(text=f"RELEASE: {full_text}", fg="#ffaa00")

                # 3. Wait for Release (Prevent instant trigger)
                def wait_release():
                    if user32.GetAsyncKeyState(detected_vk) & 0x8000:
                        dlg.after(10, wait_release)
                    else:
                        # Save Config
                        new_cfg = {"mods": mods, "key": detected_vk, "text": full_text}
                        self.macro_hotkeys[action_key] = new_cfg
                        self.save_settings() # Persist to disk
                        print(f"[UI] Macro Hotkey Saved: {action_key} -> {full_text}")
                        dlg.destroy()
                
                dlg.after(10, wait_release)
                return

            dlg.after(10, poll)

        dlg.after(100, poll)

    def _run_auto_combat_loops(self):
        """Loop background untuk Auto Attack & Tab"""
        def loop():
            while getattr(self, "live_running", True):
                # 1. Auto Tab Logic
                if getattr(self, "auto_tab_active", None) and self.auto_tab_active.get():
                    tab_key = getattr(self.skill_key_hotkey, "TAB", "0F")
                    try:
                        core.send_background_key("Guild Wars 2", hex(int(tab_key, 16)))
                    except: pass
                
                # 2. Auto Attack (Skill 1) Logic
                if getattr(self, "auto_attack_active", None) and self.auto_attack_active.get():
                    s1_key = getattr(self.skill_key_hotkey, "SKILL_1", "02")
                    try:
                        core.send_background_key("Guild Wars 2", hex(int(s1_key, 16)))
                    except: pass
                
                # Interval (sesuaikan jika terlalu cepat/lambat)
                time.sleep(0.25) 

        threading.Thread(target=loop, daemon=True).start()

    # ===============================
    # VISUAL NOTIFICATION HELPER
    # ===============================
    def show_center_notification(self, text, color="#00ff00", duration=1200):
        """Menampilkan teks overlay sementara di tengah layar."""
        # 1. Hapus overlay sebelumnya jika ada (agar tidak tumpang tindih)
        if hasattr(self, "_overlay_win") and self._overlay_win:
            try:
                self._overlay_win.destroy()
            except:
                pass
            self._overlay_win = None

        # 2. Buat Window Baru
        win = tk.Toplevel(self.root)
        self._overlay_win = win
        
        # Konfigurasi Window: Tanpa bingkai, selalu di atas, transparan
        win.overrideredirect(True)
        win.attributes("-topmost", True)
        win.attributes("-alpha", 0.85)  # Sedikit transparan
        win.configure(bg="black")

        # 3. Label Besar & Tebal
        lbl = tk.Label(
            win, 
            text=text, 
            font=("Segoe UI Black", 20), # Font tebal dan besar
            fg=color, 
            bg="black", 
            padx=20, 
            pady=10
        )
        lbl.pack()

        # 4. Posisi Tengah Layar
        win.update_idletasks() # Hitung ukuran dulu
        width = win.winfo_width()
        height = win.winfo_height()
        
        screen_width = win.winfo_screenwidth()
        screen_height = win.winfo_screenheight()
        
        # Posisi X/Y (Sedikit di atas tengah persis agar lebih enak dilihat)
        x = (screen_width // 2) - (width // 2)
        y = (screen_height // 2) - (height // 2) - 150 
        
        win.geometry(f"{width}x{height}+{x}+{y}")

        # 5. Mencegah Overlay Mengambil Fokus (Agar game tidak minimize)
        # Menggunakan atribut khusus platform windows jika memungkinkan
        try:
            # GWL_EXSTYLE = -20, WS_EX_NOACTIVATE = 0x08000000, WS_EX_TRANSPARENT = 0x20
            # Ini membuat klik tembus pandang dan tidak mencuri fokus
            hwnd = ctypes.windll.user32.GetParent(win.winfo_id())
            style = ctypes.windll.user32.GetWindowLongW(hwnd, -20)
            ctypes.windll.user32.SetWindowLongW(hwnd, -20, style | 0x08000000 | 0x20)
        except:
            pass

        # 6. Animasi Fade Out
        def _fade():
            if not win.winfo_exists(): return
            curr_alpha = win.attributes("-alpha")
            if curr_alpha > 0.05:
                win.attributes("-alpha", curr_alpha - 0.1) # Kurangi opacity
                win.after(40, _fade)
            else:
                win.destroy()
                self._overlay_win = None

        # Tunggu 'duration' ms, lalu mulai fade out
        win.after(duration, _fade)

    def build_combat_macro_ui(self, win):
        #
        # --- Init Variables ---
        if not hasattr(self, "macro_paused"):
            self.macro_paused = {"A": False, "B": False}
        
        # Init variable state
        if not hasattr(self, "auto_attack_active"):
            self.auto_attack_active = tk.BooleanVar(value=False)
        if not hasattr(self, "auto_tab_active"):
            self.auto_tab_active = tk.BooleanVar(value=False)

        # Start thread logic if not running
        if not hasattr(self, "_auto_combat_thread_started"):
            self._run_auto_combat_loops()
            self._auto_combat_thread_started = True

        # --- UI Construction ---
        fixed, frame = self.create_scroll_area(win, scroll=True)

        # Header
        h = tk.Label(fixed, text="Combat Macro", bg="#333333", fg="white", 
                     font=("Segoe UI", 10, "bold"), pady=6)
        h.pack(fill=tk.X)
        self.make_draggable(h, win, "Combat Macro", is_group_move=False)

        c = tk.Label(h, text="x", bg="#333333", fg="#888", font=("Arial", 12), cursor="hand2")
        c.pack(side=tk.RIGHT, padx=10)
        c.bind("<Button-1>", lambda e: self.close_tool_window(win, "Combat Macro"))
        
        # ==========================================================
        # NEW SECTION: 50:50 SPLIT GRID BUTTONS
        # ==========================================================
        assist_frame = tk.Frame(frame, bg="#121212")
        assist_frame.pack(fill=tk.X, padx=10, pady=(10, 5))
        
        # KONFIGURASI GRID AGAR 50:50
        # weight=1: agar expand
        # uniform="x": agar kedua kolom dipaksa sama lebar
        assist_frame.columnconfigure(0, weight=1, uniform="split_group")
        assist_frame.columnconfigure(1, weight=1, uniform="split_group")

        # Fungsi agar text wrap mengikuti lebar tombol secara dinamis
        def dynamic_wrap(event):
            widget = event.widget
            if not widget.winfo_exists(): return
            current_w = event.width
            # Update wraplength (padding 8px agar tidak menempel pinggir)
            if not hasattr(widget, "_last_w") or abs(widget._last_w - current_w) > 4:
                widget._last_w = current_w
                widget.config(wraplength=current_w - 8)

        # --- BUTTON 1: AUTO ATTACK (LEFT) ---
        btn_atk = tk.Button(
            assist_frame, text="▶ Auto Atk", 
            command=lambda: self.auto_attack_active.set(not self.auto_attack_active.get()),
            relief="flat", font=("Segoe UI", 9, "bold"),
            justify="center",
            wraplength=1 # Init kecil agar mau shrink
        )
        # Grid posisi kiri (col 0), sticky=ew (memenuhi lebar kolom)
        btn_atk.grid(row=0, column=0, sticky="ew", padx=(0, 2))
        btn_atk.bind("<Configure>", dynamic_wrap)

        # --- BUTTON 2: AUTO TAB (RIGHT) ---
        btn_tab = tk.Button(
            assist_frame, text="▶ Auto Tab", 
            command=lambda: self.auto_tab_active.set(not self.auto_tab_active.get()),
            relief="flat", font=("Segoe UI", 9, "bold"),
            justify="center",
            wraplength=1 # Init kecil agar mau shrink
        )
        # Grid posisi kanan (col 1)
        btn_tab.grid(row=0, column=1, sticky="ew", padx=(2, 0))
        btn_tab.bind("<Configure>", dynamic_wrap)

        # --- RIGHT CLICK BINDINGS (SET HOTKEY) ---
        btn_atk.bind("<Button-3>", lambda e: self.prompt_macro_hotkey("AUTO_ATK_TOGGLE", "Auto Attack"))
        btn_tab.bind("<Button-3>", lambda e: self.prompt_macro_hotkey("AUTO_TAB_TOGGLE", "Auto Tab"))

        # --- VISUAL UPDATE LOOP ---
        def update_assist_visuals():
            if not win.winfo_exists(): return

            def get_hk_txt(name):
                cfg = self.macro_hotkeys.get(name)
                # Tambah spasi agar teks rapi saat wrap
                if isinstance(cfg, dict): return f" [{cfg.get('text', '')}]"
                if isinstance(cfg, str): return f" [{cfg}]"
                return ""

            hk_atk = get_hk_txt("AUTO_ATK_TOGGLE")
            hk_tab = get_hk_txt("AUTO_TAB_TOGGLE")

            # Update ATK Button
            if self.auto_attack_active.get():
                btn_atk.config(text=f"■ Stop Atk{hk_atk}", bg="#004400", fg="#ccffcc")
            else:
                btn_atk.config(text=f"▶ Auto Atk{hk_atk}", bg="#222", fg="#888")

            # Update TAB Button
            if self.auto_tab_active.get():
                btn_tab.config(text=f"■ Stop Tab{hk_tab}", bg="#003366", fg="#99ccff")
            else:
                btn_tab.config(text=f"▶ Auto Tab{hk_tab}", bg="#222", fg="#888")

            win.after(300, update_assist_visuals)

        # Jalankan loop visual
        update_assist_visuals()

        # ==========================================================
        # MACRO SECTIONS
        # ==========================================================
        def build_macro_section(parent, key, load_cmd, toggle_cmd, pause_cmd):
            # Section Header
            ttk.Label(parent, text=f"Macro {key}", style="Section.TLabel").pack(fill=tk.X, pady=(10, 5))

            container = tk.Frame(parent, bg="#121212")
            container.pack(fill=tk.X, padx=10)
            
            # Row 1: File Name + Load Icon
            row1 = tk.Frame(container, bg="#121212")
            row1.pack(fill=tk.X, pady=(0, 5))

            file_frame = tk.Frame(row1, bg="#121212")
            file_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

            file_lbl = tk.Label(file_frame, text="No file loaded", bg="#121212", fg="#888", anchor="w", justify="left")
            file_lbl.pack(fill=tk.BOTH, expand=True)

            opener_lbl = tk.Label(container, text="", bg="#121212", fg="#00ffaa", font=("Segoe UI", 8, "italic"), anchor="w", justify="left")
            opener_lbl.pack(fill=tk.X, pady=(0, 5))

            # Boon Toggles
            boon_frame = tk.Frame(container, bg="#121212")
            boon_frame.pack(fill=tk.X, pady=(0, 5))

            quick_var = tk.BooleanVar(value=True)
            alac_var = tk.BooleanVar(value=True)

            tk.Checkbutton(boon_frame, text="Quickness", variable=quick_var, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212").pack(side=tk.LEFT)
            tk.Checkbutton(boon_frame, text="Alacrity", variable=alac_var, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212").pack(side=tk.LEFT, padx=(10, 0))

            self.combat_macro.macros[key]["quickness"] = quick_var
            self.combat_macro.macros[key]["alacrity"] = alac_var

            # Load Button
            tk.Button(row1, text="📂", command=lambda: load_and_update(file_lbl), bg="#222", fg="#ddd", relief="flat", width=3).pack(side=tk.RIGHT, padx=(5, 0))

            def update_wrap(event=None):
                wrap_width = file_frame.winfo_width()
                if wrap_width > 10: file_lbl.config(wraplength=wrap_width)
            row1.bind("<Configure>", update_wrap)
                    
            # Row 2: Status Label
            run_lbl = tk.Label(container, text="Stopped", bg="#121212", fg="#888", font=("Segoe UI", 8))
            run_lbl.pack(anchor="w", pady=(0, 5))
            
            # Row 3: Control Buttons
            row3 = tk.Frame(container, bg="#121212")
            row3.pack(fill=tk.X, pady=2)
            
            toggle_btn = tk.Button(row3, text="▶ Start", bg="#004400", fg="#ccffcc", relief="flat", font=("Segoe UI", 9, "bold"))
            toggle_btn.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 2))
            
            pause_btn = tk.Button(row3, text="⏸ Pause", bg="#222", fg="#888", relief="flat", state=tk.DISABLED)
            pause_btn.pack(side=tk.RIGHT, fill=tk.X, expand=True, padx=(2, 0))

            toggle_btn.bind("<Button-3>", lambda e: self.prompt_macro_hotkey(f"{key}_TOGGLE", f"Start/Stop Macro {key}"))
            pause_btn.bind("<Button-3>", lambda e: self.prompt_macro_hotkey(f"{key}_PAUSE", f"Pause/Resume Macro {key}"))

            def load_and_update(lbl):
                path = filedialog.askopenfilename(title=f"Load Combat Macro {key}", filetypes=[("Macro Files", "*.txt")], parent=win)
                if path:
                    load_cmd(path)
                    lbl.config(text=os.path.basename(path), fg="#00ff00")
                    macro_data = self.combat_macro.macros[key]
                    opener = macro_data.get("opener_text")
                    opener_lbl.config(text=opener if opener else "")

            def on_toggle():
                toggle_cmd()
                self.update_macro_ui_state(key, run_lbl, toggle_btn, pause_btn)

            def on_pause():
                pause_cmd()
                self.update_macro_ui_state(key, run_lbl, toggle_btn, pause_btn)

            toggle_btn.config(command=on_toggle)
            pause_btn.config(command=on_pause)
            
            def refresh_ui():
                if win.winfo_exists():
                    self.update_macro_ui_state(key, run_lbl, toggle_btn, pause_btn)
                    hk_toggle = self.macro_hotkeys.get(f"{key}_TOGGLE")
                    hk_pause = self.macro_hotkeys.get(f"{key}_PAUSE")
                    def get_hk_text(cfg):
                        if isinstance(cfg, dict): return cfg.get("text", "")
                        if isinstance(cfg, str): return cfg
                        return ""
                    txt_t = get_hk_text(hk_toggle)
                    txt_p = get_hk_text(hk_pause)
                    is_running = self.macro_state[key]
                    if not is_running:
                        base = "▶ Start"
                        if txt_t: base += f" [{txt_t}]"
                        toggle_btn.config(text=base)
                    if is_running:
                        is_paused = self.macro_paused[key]
                        base_p = "▶ Resume" if is_paused else "⏸ Pause"
                        if txt_p: base_p += f" [{txt_p}]"
                        pause_btn.config(text=base_p)
                    win.after(500, refresh_ui)
            refresh_ui()

        # Build A & B Sections
        build_macro_section(frame, "A", lambda path: self.combat_macro.load_macro_simple("A", path), self.toggle_macro_a, self.pause_macro_a)
        build_macro_section(frame, "B", lambda path: self.combat_macro.load_macro_simple("B", path), self.toggle_macro_b, self.pause_macro_b)
        
        ttk.Button(frame, text="Edit Key Config", command=self.update_combat_key).pack(fill=tk.X, padx=10, pady=20)
            
        def on_toggle_log():
            if self.combat_macro:
                self.combat_macro.combat_log_enabled = self.save_combat_log_var.get()
                self.combat_macro.combat_log_autosave = self.save_combat_log_var.get()

        tk.Checkbutton(frame, text="Save Combat Log", variable=self.save_combat_log_var, command=on_toggle_log, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212").pack(fill=tk.X, padx=10, pady=(0, 10))