    def _load_icons(self):
        """Load and resize all UI icons once."""
        self.icons = {}

        base = os.path.join(os.path.dirname(__file__), "icons")

        def load(name, size=(14, 14)):
            path = os.path.join(base, f"{name}.png")
            try:
                img = Image.open(path).convert("RGBA")
                img = img.resize(size, Image.LANCZOS)
                return ImageTk.PhotoImage(img)
            except Exception:
                return None

        # Map tab icons
        self.icons["edit"]    = load("edit")
        self.icons["refresh"] = load("refresh")
        self.icons["clear"]   = load("clear")
        self.icons["add"]     = load("add")
        
    def sync_all_windows(self, source_win):
        if self._sync_lock: return
        self._sync_lock = True
        try:
            sx = source_win.winfo_x(); sy = source_win.winfo_y()
            if source_win == self.root:
                for win, (dx, dy) in self.window_offsets.items():
                    if tk.Toplevel.winfo_exists(win): win.geometry(f"+{sx + dx}+{sy + dy}")
            else:
                dx, dy = self.window_offsets.get(source_win, (0, 0))
                main_x = sx - dx; main_y = sy - dy
                self.root.geometry(f"+{main_x}+{main_y}")
                for win, (odx, ody) in self.window_offsets.items():
                    if win != source_win and tk.Toplevel.winfo_exists(win):
                        win.geometry(f"+{main_x + odx}+{main_y + ody}")
        finally:
            self._sync_lock = False

    def apply_resize_mode(self, win, allow):
        if not win or not tk.Toplevel.winfo_exists(win):
            return

        win.update_idletasks()
        geo = win.geometry()

        if allow:
            win.overrideredirect(False)
            win.resizable(True, True)
        else:
            win.overrideredirect(True)

        win.geometry(geo)

    
    def validate_number(self, value_if_allowed):
        if value_if_allowed == "" or value_if_allowed == "-": return True
        try: float(value_if_allowed); return True
        except ValueError: return False

