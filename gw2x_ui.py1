        self.toggle_btn.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.toggle_btn.bind("<ButtonRelease-1>", self.toggle_menu)
        
        self.close_btn = tk.Label(self.top_frame, text="x", bg="#1a1a1a", fg="#666666", font=("Arial", 14), padx=10, cursor="hand2")
        self.close_btn.bind("<Button-1>", lambda e: self.on_app_close())
        self.close_btn.pack(side=tk.RIGHT, fill=tk.Y)
       
        self.menu_frame = tk.Frame(self.root, bg="#121212")
        
        # --- CORRECTED: BOTH WINDOWS IN ONE CATEGORY ---
        self.add_cat("Teleport Hub", [
            ("Main Teleporter", "🌏 ", self.build_teleport_hub_ui, "380x350"),
            ("Object Teleporter", "🗿", self.build_objects_teleport_ui, "380x350"),
            ("Live Entities", "📡", self.build_live_entities_ui, "420x450"),
        ])
        
        self.add_cat("Movement", [
            ("Player Enhancement", "🧍", self.build_player_enhancement_tab, "380x420"),
            ("Mount Enhancement", "🐎", self.build_mount_enhancement_tab, "380x300"),
        ])
        
        self.add_cat(
            "Fish & Skiff",
            [("Fishing Assist", "🎣", self.fishing_ui.build_ui, "300x220")]
        )

        self.add_cat("Visuals", [
            ("Clarity View", "👀 ", self.build_clarity_ui, "300x250"),
            ("GW2X ESP", "🎯", self.build_esp_ui, "300x400"),
        ])
        
        self.add_cat("Combat", [
            ("Combat Macro", "🗡", self.build_combat_macro_ui, "450x500"),
        ])
        
        cfg_frame = tk.Frame(self.menu_frame, bg="#121212")
        cfg_frame.pack(fill=tk.X, pady=(5, 8))
        
        tk.Checkbutton(cfg_frame, text="Allow Window Resize", variable=self.allow_resize, bg="#121212", fg="#dddddd", selectcolor="#121212", activebackground="#121212", activeforeground="#ffffff", command=self.toggle_resize).pack(anchor="w", padx=8)

        slider_frame = tk.Frame(self.menu_frame, bg="#121212", pady=5)
        slider_frame.pack(fill=tk.X, side=tk.BOTTOM)
        tk.Label(slider_frame, text="Opacity", bg="#121212", fg="#888", font=("Arial", 8)).pack(anchor="w", padx=5)
        self.alpha_scale = ttk.Scale(slider_frame, from_=0.2, to=1.0, value=self.transparency, command=self.set_global_alpha, style="Clean.Horizontal.TScale")
        self.alpha_scale.pack(fill=tk.X, padx=5)
        
        val_lbl = tk.Label(slider_frame, textvariable=tk.StringVar(value=f"{int(self.transparency * 100)}%"), bg="#121212", fg="#888", font=("Segoe UI", 8))
        val_lbl.pack(anchor="e", padx=5)

        def update_val(v):
            val_lbl.config(text=f"{int(float(v) * 100)}%")
            self.set_global_alpha(v)
        self.alpha_scale.config(command=update_val)

    def add_cat(self, name, items):
        if name not in self.categories: self.categories[name] = {}
        self.categories[name]["items"] = items
        self.categories[name]["win"] = None
        btn = ttk.Button(self.menu_frame, text=name, style="Cat.TButton", command=lambda: self.toggle_category_window(name, items))
        btn.pack(fill=tk.X, pady=1)
    
    def _create_collapsible_section(self, parent, title, start_open=True, unique_id=None):
        container = tk.Frame(parent, bg="#121212")

        header = tk.Frame(container, bg="#222")
        header.pack(fill=tk.X)

        # --- PERSISTENCE LOGIC ---
        # If a unique_id is provided, use saved state preference over 'start_open'
        if unique_id is not None:
            if hasattr(self, "_expanded_map_groups"):
                if unique_id in self._expanded_map_groups:
                    start_open = True
                # If specifically tracking this ID but it's not in set, force closed unless search is active
                elif not start_open: 
                    start_open = False
        # -------------------------

        state = {"open": start_open}

        icon = tk.Label(
            header,
            text="▼" if start_open else "▶",
            bg="#222",
            fg="#00aaff",
            width=2
        )
        icon.pack(side=tk.LEFT)

        label = tk.Label(
            header,
            text=title,
            bg="#222",
            fg="#00aaff",
            font=("Segoe UI", 9, "bold"),
            anchor="w"
        )
        label.pack(side=tk.LEFT, fill=tk.X, expand=True)

        content = tk.Frame(container, bg="#121212")

        if start_open:
            content.pack(fill=tk.X)

        def toggle(_=None):
            state["open"] = not state["open"]
            icon.config(text="▼" if state["open"] else "▶")
            if state["open"]:
                content.pack(fill=tk.X)
                # Save State
                if unique_id and hasattr(self, "_expanded_map_groups"):
                    self._expanded_map_groups.add(unique_id)
            else:
                content.pack_forget()
                # Save State
                if unique_id and hasattr(self, "_expanded_map_groups"):
                    self._expanded_map_groups.discard(unique_id)

        header.bind("<Button-1>", toggle)
        label.bind("<Button-1>", toggle)
        icon.bind("<Button-1>", toggle)

        return container, content

    def restore_windows(self):
        # 1. Restore Categories (The side-menus like Teleport Hub, Movement, etc.)
        for name in self.categories:
            if f"category:{name}" in self.open_windows:
                # This only opens the category side-bar, not the tools inside
                self.toggle_category_window(name, self.categories[name]["items"])

        # 2. Restore Tool Windows (Only if they were explicitly open)
        for cat_name, cat_data in self.categories.items():
            items = cat_data.get("items", [])
            for key, icon, builder, size in items:
                # CRITICAL CHECK: Only open if the key exists in open_windows 
                # and is NOT already active
                if key in self.open_windows:
                    # Double check to ensure we aren't opening Fishing Assist 
                    # unless it was actually saved as 'open'
                    self.toggle_tool_window(key, builder, size)

    def toggle_menu(self, event=None):
        self.drag_data.clear()
        
        if self.expanded:
            # ========================
            # ACTION: COLLAPSE
            # ========================
            self.menu_frame.pack_forget()
            self.root.geometry("140x40")
            self.toggle_btn.config(text="GW2X ▼")
            self.expanded = False
            
            # Hide active category windows so they don't float alone
            for cat_name, cat_data in self.categories.items():
                win = cat_data.get('win')
                if win and tk.Toplevel.winfo_exists(win):
                    # Hide the window
                    win.withdraw()
                    # Mark it so we know to restore it later
                    cat_data['hidden_by_collapse'] = True

        else:
            # ========================
            # ACTION: EXPAND
            # ========================
            self.menu_frame.pack(fill=tk.BOTH, expand=True, padx=2, pady=2)
            self.menu_frame.update_idletasks()
            needed_height = self.menu_frame.winfo_reqheight()
            self.root.geometry(f"140x{40 + needed_height + 4}")
            self.toggle_btn.config(text="GW2X ▲")
            self.expanded = True
            
            # Update pending geometry tasks to get accurate coordinates
            self.root.update_idletasks()
            
            # Calculate where the category window should snap to
            # (In case you moved the main window while it was collapsed)
            mx = self.root.winfo_x()
            my = self.root.winfo_y()
            mw = self.root.winfo_width()
            GAP = 5
            target_x = mx + mw + GAP
            target_y = my
            
            # Restore category windows
            for cat_name, cat_data in self.categories.items():
                # Only restore if it was hidden by our collapse action
                if cat_data.get('hidden_by_collapse', False):
                    win = cat_data.get('win')
                    if win and tk.Toplevel.winfo_exists(win):
                        # Move it to the new snap position
                        win.geometry(f"+{target_x}+{target_y}")
                        
                        # Show it again
                        win.deiconify()
                        win.lift()
                    
                    # Reset flag
                    cat_data['hidden_by_collapse'] = False
    
    # ===============================
    # NEW DRAG & DROP LOGIC (WITH CONFIRMATION)
    # ===============================
    def _start_tp_drag(self, event, tp, source_list, refresh_cb):
        """
        Memulai drag. Menyimpan referensi list asli dan callback refresh.
        """
        # Cek apakah sedang mode edit
        # Kita cek widget master untuk mengetahui apakah kita di window popup
        try:
            # Ambil window parent
            top = event.widget.winfo_toplevel()
            # Cek variabel edit mode yang tersimpan di window tersebut
            if hasattr(top, "popup_edit_mode") and not top.popup_edit_mode.get():
                return
        except:
            if not self.tp_edit_mode.get():
                return

        self._drag_tp = {
            "tp": tp,
            "start_y": event.y_root,
            "source_list": source_list, # List referensi (win.points)
            "refresh_cb": refresh_cb
        }

        self.root.config(cursor="fleur")

    def _do_tp_drag(self, event, refresh_cb):
        # DO NOTHING HERE. 
        # Previously, this swapped items instantly. 
        # We removed that so it waits until you release the mouse.
        pass

    def _end_tp_drag(self, event):
        self.root.config(cursor="")

        if not self._drag_tp:
            return

        drag_data = self._drag_tp
        self._drag_tp = None # Reset immediately

        tp = drag_data["tp"]
        source_list = drag_data["source_list"]
        refresh_cb = drag_data["refresh_cb"]
        start_y = drag_data["start_y"]

        # Calculate drag distance
        dy = event.y_root - start_y
        
        # Deadzone to prevent accidental swaps on simple clicks
        if abs(dy) < 10: 
            return

        if tp not in source_list:
            return

        old_idx = source_list.index(tp)

        # Standard height of a row (Button 36 + Pad 1 = 37)
        ROW_HEIGHT = 37 
        
        # Calculate slots moved
        # Rounding ensures we snap to the nearest slot
        slots_moved = int(round(dy / ROW_HEIGHT))

        new_idx = old_idx + slots_moved
        
        # Clamp bounds
        new_idx = max(0, min(len(source_list) - 1, new_idx))

        if new_idx == old_idx:
            return

        # --- PERFORM THE SWAP (Insert Logic) ---
        # Moving item from old_idx to new_idx
        # We pop it first, then insert it at new position
        item = source_list.pop(old_idx)
        source_list.insert(new_idx, item)

        # Update Current Auto-TP Index Logic
        # If we moved the currently active index, track it
        current_active = self.logic.current_auto_tp_index
        
        if current_active == old_idx:
            self.logic.current_auto_tp_index = new_idx
        elif current_active is not None:
            # If we moved something ELSE, but passed over the active index, adjust active index
            # Moving Down: old < active <= new -> shift active down (-1)
            # Moving Up: new <= active < old -> shift active up (+1)
            if old_idx < current_active <= new_idx:
                self.logic.current_auto_tp_index -= 1
            elif new_idx <= current_active < old_idx:
                self.logic.current_auto_tp_index += 1

        # Refresh UI
        # Use suppress_scroll=True to keep view stable
        # Use save_mode=True to write changes to disk immediately
        if refresh_cb:
            # We call it with arguments if supported (lambda wrapper handles this usually)
            try:
                refresh_cb(save_mode=True, s_scroll=True) # Matches the lambda signature in _open_map_file_window
            except TypeError:
                # Fallback for old signatures
                refresh_cb(save_mode=True)
    
    def toggle_resize(self):
        val = self.allow_resize.get()

        # main window (still frameless)
        self.root.overrideredirect(True)

        # CLOSE & REOPEN tool windows to apply resize properly
        open_tools = list(self.open_windows)

        for key in list(open_tools):
            if key in self.windows and self.windows[key].get("win"):
                self.close_tool_window(self.windows[key]["win"], key)

        # Reopen them cleanly
        for cat in self.categories.values():
            for key, icon, builder, size in cat.get("items", []):
                if key in open_tools:
                    self.toggle_tool_window(key, builder, size)

        self.save_settings()
        
        # Apply resize to TPS window if open (CORRECT)
        win = getattr(self, "active_tps_window", None)
        if win and win.winfo_exists():
            self.apply_resize_mode(win, self.allow_resize.get())


    def set_global_alpha(self, val):
        self.transparency = float(val)

        # main window
        self.root.attributes("-alpha", self.transparency)

        # category windows
        for cat in self.categories.values():
            w = cat.get("win")
            if w and tk.Toplevel.winfo_exists(w):
                w.attributes("-alpha", self.transparency)

        # tool windows (Teleport Hub included)
        for entry in self.windows.values():
            w = entry.get("win")
            if w and tk.Toplevel.winfo_exists(w):
                w.attributes("-alpha", self.transparency)
                
        # TPS popup window
        win = getattr(self, "active_tps_window", None)
        if win and win.winfo_exists():
            win.attributes("-alpha", self.transparency)

    def toggle_category_window(self, cat_name, items):
        # Check if window is already open
        was_open = False
        if cat_name in self.categories:
            current = self.categories[cat_name]
            if current['win'] and tk.Toplevel.winfo_exists(current['win']): 
                was_open = True

        # Close any other category windows to act like a toggle menu
        for c, d in self.categories.items():
            if d['win'] and tk.Toplevel.winfo_exists(d['win']): 
                self.close_category_window(c, d['win'])

        if was_open: return

        # --- FIX: ROBUST POSITION CALCULATION ---
        # 1. Force the OS to calculate the Main Window's real position
        self.root.update_idletasks()
        
        mx = self.root.winfo_rootx()
        my = self.root.winfo_rooty()
        mw = self.root.winfo_width()
        
        # 2. Safety Check: If width is invalid (1) or position is 0,0 (default), try to use saved settings or request width
        if mw <= 1: 
            mw = self.root.winfo_reqwidth()
        
        # If the OS still reports 0,0 (common on fresh launch), use the saved position from config
        if mx <= 0 and my <= 0:
            saved = self.saved_positions.get("main", {})
            mx = saved.get("x", 100) # Default to 100 if nothing saved
            my = saved.get("y", 100)
        
        GAP = 5 
        
        # Calculate snap position based on the corrected values
        target_x = mx + mw + GAP
        target_y = my

        # --- AUTO-ADJUST HEIGHT LOGIC ---
        auto_height = 25 + (len(items) * 51) + 5
        
        # --- CREATE WINDOW ---
        win = tk.Toplevel(self.root)
        win.title(cat_name)
        win.configure(bg="#1e1e1e")
        win.attributes("-topmost", True)
        win.attributes("-alpha", self.transparency)

        # Apply geometry immediately
        win.geometry(f"200x{auto_height}+{target_x}+{target_y}")

        # --- HEADER ---
        head = tk.Frame(win, bg="#333333", height=25); head.pack(fill=tk.X)
        lbl = tk.Label(head, text=cat_name, bg="#333333", fg="#aaaaaa", font=("Arial", 9)); lbl.pack(side=tk.LEFT, padx=5)
        cls = tk.Label(head, text="x", bg="#333333", fg="#aaaaaa", font=("Arial", 11), cursor="hand2"); cls.pack(side=tk.RIGHT, padx=5)
        cls.bind("<Button-1>", lambda e: self.close_category_window(cat_name, win))

        # Make draggable
        pos_key = f"category:{cat_name}"
        for w in (head, lbl, cls): 
            self.make_draggable(w, win, pos_key, is_group_move=True, right_click_only=True)

        self.categories[cat_name]['win'] = win
        self.open_windows.add(pos_key)

        # --- CREATE ITEMS ---
        for key, icon, builder, size in items: 
            self.create_list_item(win, key, icon, builder, size)

        win.update_idletasks()
        self.apply_resize_mode(win, self.allow_resize.get())

    def close_category_window(self, cat_name, win):
        key = f"category:{cat_name}"
        if win and tk.Toplevel.winfo_exists(win):
            self.saved_positions[key] = {
                "x": win.winfo_x(),"y": win.winfo_y(),"w": win.winfo_width(),"h": win.winfo_height()
            }
        if key in self.open_windows: self.open_windows.remove(key)
        self.save_settings()
        win.destroy()
        self.categories[cat_name]["win"] = None

    def create_list_item(self, parent, key, icon, builder, size):
        f = tk.Frame(parent, bg="#1e1e1e", height=50)
        f.pack(fill=tk.X, pady=1)
        f.pack_propagate(False)
        
        if key not in self.windows: 
            self.windows[key] = {'win': None, 'ind': None}
            
        # This command is what adds/removes the key from open_windows
        btn = ttk.Button(f, text=f" {icon}   {key}", style="List.TButton", 
                         command=lambda: self.toggle_tool_window(key, builder, size))
        btn.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # --- MODIFIED: Added cursor="hand2" to indicate it's clickable ---
        ind = tk.Label(f, text="⬜", bg="#1e1e1e", fg="#444444", font=("Arial", 12), cursor="hand2")
        ind.pack(side=tk.RIGHT, padx=10)
        
        # --- MODIFIED: Bind click event to trigger the master toggle ---
        ind.bind("<Button-1>", lambda e, k=key: self.toggle_category_features(k))
        
        self.windows[key]['ind'] = ind
        self._sync_tool_indicator(key)


    def toggle_category_features(self, key):
        """Master toggle for specific tool categories directly from the menu indicator."""
        
        if key == "Clarity View":
            current = self.saved_inputs.get("vis_fog", 0)
            new_val = 0 if current else 1
            
            # Update settings and logic
            self.saved_inputs["vis_fog"] = new_val
            if self.logic: 
                self.logic.toggle_clarity(new_val)
            
            # Visually update the UI checkbox if the window happens to be open
            if hasattr(self, "var_clarity_fog"):
                self.var_clarity_fog.set(new_val)
                
            self.save_settings()
            
            # Show on-screen notification
            state_str = "ENABLED" if new_val else "DISABLED"
            color = "#00ff00" if new_val else "#ff4444"
            self.show_center_notification(f"CLARITY VIEW: {state_str}", color)
            
        elif key == "GW2X ESP":
            keys = ["esp_player", "esp_npc", "esp_path", "esp_health"]
            
            # If ALL features are currently enabled, turn them off. Otherwise, turn EVERYTHING on.
            all_on = all(self.saved_inputs.get(k, 0) == 1 for k in keys)
            new_val = 0 if all_on else 1
            
            for k in keys:
                # Update settings and logic
                self.saved_inputs[k] = new_val
                if self.logic: 
                    self.logic.toggle_esp(k, new_val)
                
                # Visually update the UI checkboxes if the window happens to be open
                var_name = f"var_{k}"
                if hasattr(self, var_name):
                    var_obj = getattr(self, var_name)
                    if isinstance(var_obj, tk.IntVar):
                        var_obj.set(new_val)
                        
            self.save_settings()
            
            # Show on-screen notification
            state_str = "ALL ENABLED" if new_val else "ALL DISABLED"
            color = "#00ff00" if new_val else "#ff4444"
            self.show_center_notification(f"GW2X ESP: {state_str}", color)
            
        self._sync_tool_indicator(key)
