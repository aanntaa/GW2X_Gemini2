core.connect()

def get_window_title(pid):
    title = ""

    def callback(hwnd, _):
        nonlocal title
        _, found_pid = win32process.GetWindowThreadProcessId(hwnd)
        if found_pid == pid and win32gui.IsWindowVisible(hwnd):
            t = win32gui.GetWindowText(hwnd)
            if t:
                title = t
        return True

    win32gui.EnumWindows(callback, None)
    return title or "Unknown"


def show_process_selector(on_selected_callback):
    processes = core.connect()

    if not processes:
        print("No GW2 process found.")
        return

    win = tk.Toplevel()
    win.title("Select Process - KX Trainer V2")
    win.geometry("750x350")
    win.resizable(False, False)

    columns = ("pid", "title", "memory", "start")

    tree = ttk.Treeview(win, columns=columns, show="headings")

    tree.heading("pid", text="Proc Id")
    tree.heading("title", text="Window Title")
    tree.heading("memory", text="Memory")
    tree.heading("start", text="Start Time")

    tree.column("pid", width=90)
    tree.column("title", width=250)
    tree.column("memory", width=120)
    tree.column("start", width=180)

    for p in processes:
        pid = p["pid"]

        try:
            proc = psutil.Process(pid)
            mem_mb = proc.memory_info().rss / (1024 * 1024)
            memory_str = f"{mem_mb:.3f} MB"
            start_time = datetime.fromtimestamp(proc.create_time()).strftime("%m/%d/%Y %H:%M:%S")
        except:
            memory_str = "?"
            start_time = "?"

        title = get_window_title(pid)

        tree.insert("", "end", values=(pid, title, memory_str, start_time))

    tree.pack(fill="both", expand=True, padx=10, pady=10)

    def select():
        selected = tree.selection()
        if not selected:
            return

        values = tree.item(selected[0])["values"]
        pid = int(values[0])

        core.connect(pid)
        on_selected_callback(pid)
        win.destroy()

    tk.Button(win, text="Select", width=20, command=select).pack(pady=10)

