    def _find_map_folder(self, map_name):
        """
        Searches the ENTIRE app directory (and subfolders) for:
        1. A folder named exactly 'Map Name'
        2. A file named 'Map Name.tps' or 'Map Name.json'
        """
        # Start search from the folder containing the script
        app_dir = os.path.dirname(os.path.abspath(__file__))
        
        # Clean the map name (remove colons, lowercase)
        target_name = map_name.replace(":", "").strip().lower()
        
        # os.walk goes through every single folder in your app
        for root, dirs, files in os.walk(app_dir):
            
            # 1. Search for matching FOLDER
            for d in dirs:
                if d.lower() == target_name:
                    return os.path.join(root, d)
            
            # 2. Search for matching FILE
            # (If found, we return the folder containing that file)
            for f in files:
                if f.lower() == f"{target_name}.tps" or f.lower() == f"{target_name}.json":
                    return root
        
        return None
        
    def update_map_status_ui(self):
        try:
            logic_map_id = self.logic.current_map_id

            if logic_map_id <= 0:
                self.root.after(1000, self.update_map_status_ui)
                return

            # UI refresh must depend ONLY on logic map change
            if logic_map_id != self._ui_last_map_id:
                self._ui_last_map_id = logic_map_id

                self.refresh_map_label()
                self.refresh_map_tp_tab()

        except Exception:
            pass

        self.root.after(1000, self.update_map_status_ui)


    def refresh_map_label(self):
        # Placeholder if label needs explicit refresh logic outside of tab build
        pass

    def _smooth_canvas_scroll(self, canvas, direction, steps=6, delay=10):
        if not canvas.winfo_exists():
            return

        if getattr(canvas, "_scrolling", False):
            return

        canvas._scrolling = True

        def step(i):
            if not canvas.winfo_exists():
                canvas._scrolling = False
                return

            canvas.yview_scroll(direction, "units")

            if i < steps:
                canvas.after(delay, lambda: step(i + 1))
            else:
                canvas._scrolling = False

        step(0)

    # ===============================
    # STABILITY FIX: THREAD-SAFE UI HIGHLIGHT
    # ===============================
    def _highlight_tp_index(self, index):
        try:
            if self.logic:
                self.logic.current_auto_tp_index = index

            # reset previous
            last = self.highlight_state.get("last_btn")
            if last and last.winfo_exists():
                last.config(bg="#1e1e1e")

            btn = self.tp_row_widgets.get(index)
            if not btn or not btn.winfo_exists():
                return

            # 🔥 THIS IS THE FIX
            row = btn.master   # ← the visible container
            row.config(bg="#004488")

            self.highlight_state["last_btn"] = row

        except Exception as e:
            print("[HIGHLIGHT ERROR]", e)
            
 
    def on_speed_change(self, index, var_cb, var_val):
        self.logic.set_speed_config(index, var_cb.get(), var_val.get())
        
    def do_tp_combined(self):
        ok, msg = self.logic.teleport_manual_str(self.tp_combined.get())
        if not ok: messagebox.showerror("Error", msg)

    def do_global_tp(self, mode):
        def task():
            ok, msg = self.logic.teleport_global(
                self.global_coord.get() if mode == "wiki" else self.timer_input.get(), 
                self.global_h_tp.get(), 
                mode
            )
            if not ok: 
                self.root.after(0, lambda: messagebox.showerror("Error", msg))
        threading.Thread(target=task, daemon=True).start()
    
    def _save_cursor_pos(self):
        try:
            import pyautogui
            # Mengambil posisi kursor saat ini
            x, y = pyautogui.position()
            
            # Update variable UI agar terlihat oleh user
            self.chat_x_var.set(str(x))
            self.chat_y_var.set(str(y))
            
            # Simpan ke settings agar tidak hilang saat restart
            self.saved_inputs["chat_x"] = str(x)
            self.saved_inputs["chat_y"] = str(y)
            self.save_settings()
            
            messagebox.showinfo("Success", f"Chat Coords Saved!\nX: {x}, Y: {y}")
        except ImportError:
            messagebox.showerror("Error", "Library 'pyautogui' belum terinstall.\nJalankan: pip install pyautogui")
        except Exception as e:
            messagebox.showerror("Error", f"Gagal mengambil posisi kursor: {e}")
            
    def do_tp_relative(self, direction):
        self.logic.teleport_relative(
            self.dir_dist_var.get(), 
            self.dir_height_var.get(), 
            direction
        )

    def do_tp_vertical(self, val_str=None):
        val = val_str if val_str else self.dir_height_var.get()
        self.logic.teleport_vertical(val)
        
    def copy_live_to_clipboard(self):
        x = self.live_x.get()
        y = self.live_y.get()
        z = self.live_z.get()
        text = f"{x}, {y}, {z}"
        pyperclip.copy(text)
    
    def save_slot_ui(self, index, entry):
        """
        Saves current position to the slot index and updates the UI entry text.
        """
        # 1. Save to backend (gw2x_data via logic)
        self.logic.save_slot(index)
        
        # 2. Visual Feedback: Update the text box with the captured coordinates
        pos = self.logic.read_live_coords()
        if pos:
            entry.delete(0, tk.END)
            entry.insert(0, f"{pos[0]:.2f}, {pos[1]:.2f}, {pos[2]:.2f}")

    def load_slot_ui(self, index):
        """
        Teleports to the position saved in the slot index.
        """
        self.logic.load_slot(index)
    
    def refresh_slots(self):
        """
        Refresh quick teleport slots UI from saved data.
        Safe no-op if slots are not initialized yet.
        """
        slots = self.saved_inputs.get("quick_slots", [])
        names = self.saved_inputs.get("quick_slot_names", [])
        
        if hasattr(self, "slot_entries"):
            for i, entry in enumerate(self.slot_entries):
                try:
                    entry.delete(0, tk.END)
                    if i < len(slots):
                        entry.insert(0, slots[i])
                except Exception:
                    pass

        if hasattr(self, "slot_name_entries"):
            for i, entry in enumerate(self.slot_name_entries):
                try:
                    entry.delete(0, tk.END)
                    if i < len(names) and names[i]:
                        entry.insert(0, names[i])
                    else:
                        entry.insert(0, f"Slot {i+1}")
                except Exception:
                    pass

    def close_all_map_file_windows(self):
        for win in list(self.map_file_windows.values()):
            if win and win.winfo_exists():
                win.destroy()
        self.map_file_windows.clear()
    
    # ===============================
    # TPS FILE HANDLERS
    # ===============================
    def _parse_tps_line(self, line):
        """Parses a line formatted as: Name X Y Z"""
        parts = line.strip().split()
        if len(parts) < 4: return None
        
        try:
            # Assume last 3 are coordinates
            z = float(parts[-1])
            y = float(parts[-2])
            x = float(parts[-3])
            # Everything before is the name
            name = " ".join(parts[:-3])
            return {"name": name, "x": x, "y": y, "z": z}
        except ValueError:
            return None

    def _load_map_file(self, path):
        data = []

        if not path.lower().endswith(".tps"):
            return data     
        
        # Buat file jika belum ada
        if not os.path.exists(path):
            try:
                with open(path, "w", encoding="utf-8") as f:
                    f.write("")
            except: pass
            return []
            
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                for line_idx, line in enumerate(f):
                    line = line.strip()
                    if not line:
                        continue

                    # 1. Cari semua angka (float/int, positif/negatif)
                    # Regex ini menangkap: -100, 50.5, 0.001
                    nums = re.findall(r"-?\d+(?:\.\d+)?", line)
                    
                    # Syarat: Minimal ada 3 angka untuk X, Y, Z
                    if len(nums) < 3:
                        continue

                    # 2. Ambil 3 angka TERAKHIR sebagai koordinat
                    # Ini aman bahkan jika nama mengandung angka (misal "Spot 1 500 100 500")
                    try:
                        z = float(nums[-1])
                        y = float(nums[-2])
                        x = float(nums[-3])
                    except ValueError:
                        continue

                    # 3. Tentukan Nama
                    # Cari posisi dimulainya angka X (nums[-3]) di dalam baris
                    # Ambil semua teks SEBELUM angka tersebut
                    split_marker = nums[-3]
                    pos = line.rfind(split_marker) # Gunakan rfind agar lebih aman jika angka duplicate
                    
                    # Jika find gagal (sangat jarang karena regex dapat), fallback ke split biasa
                    if pos == -1:
                        pos = line.find(split_marker)

                    if pos != -1:
                        raw_name = line[:pos].strip()
                    else:
                        raw_name = ""

                    # Jika nama kosong, beri nama default "Spot <urutan>"
                    if not raw_name:
                        name = f"Spot {line_idx + 1}"
                    else:
                        name = raw_name

                    # 4. Simpan Data
                    data.append({
                        "name": name,
                        "x": x,
                        "y": y,
                        "z": z,
                        "map_id": 0,
                        "allow_cross_map": True
                    })

        except Exception as e:
            print(f"[UI] Error loading map file {path}: {e}")

        return data

    def _save_map_file(self, path, teleports):
        """Saves coordinates to .json or .tps based on extension"""
        if path.lower().endswith(".tps"):
            try:
                with open(path, "w", encoding="utf-8") as f:
                    for tp in teleports:
                        n = tp.get("name", "Unknown")
                        x = tp.get("x", 0)
                        y = tp.get("y", 0)
                        z = tp.get("z", 0)
                        f.write(f"{n} {x:.4f} {y:.4f} {z:.4f}\n")
            except Exception as e:
                messagebox.showerror("Save Error", str(e))
        
        elif path.lower().endswith(".json"):
            # Legacy JSON Save
            export = []
            for tp in teleports:
                export.append({
                    "Name": tp.get("name", "Unknown"),
                    "X": tp.get("x", 0),
                    "Y": tp.get("y", 0),
                    "Z": tp.get("z", 0)
                })
            final = {"Name": "Export", "Coordinates": export}
            try:
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(final, f, indent=2)
            except Exception as e:
                messagebox.showerror("Save Error", str(e))
    # ===============================
    # STANDARD UI CODE
    # ===============================
    def save_settings(self):       
        try:
            if not self.root or not self.root.winfo_exists():
                return
        except Exception:
            return
        
        try:
            # FORCE UPDATE to ensure winfo returns latest values
            self.root.update_idletasks()
        
            # 1. Save Main Window
            if self.root.winfo_exists():
                curr_x = self.root.winfo_x(); curr_y = self.root.winfo_y()
                # Check for 0,0 to prevent overwriting valid saved pos with a glitch
                if curr_x != 0 or curr_y != 0:
                    self.saved_positions["main"] = {"x": curr_x,"y": curr_y,"w": self.root.winfo_width(),"h": self.root.winfo_height()}

            # 2. Save Category Windows
            for cat_name, cat_data in self.categories.items():
                w = cat_data.get('win')
                if w and tk.Toplevel.winfo_exists(w) and w.winfo_viewable():
                    self.saved_positions[f"category:{cat_name}"] = {"x": w.winfo_x(),"y": w.winfo_y(),"w": w.winfo_width(),"h": w.winfo_height()}

            # 3. Save Tool Windows
            for key, entry in self.windows.items():
                w = entry.get('win')
                if w and tk.Toplevel.winfo_exists(w) and w.winfo_viewable():
                    self.saved_positions[key] = {"x": w.winfo_x(),"y": w.winfo_y(),"w": w.winfo_width(),"h": w.winfo_height()}

            # 4. Save Map/TPS File Windows
            for key, win in self.map_file_windows.items():
                # CRITICAL FIX: Check 'winfo_viewable()' so we don't save 0,0 while it's hidden/loading
                if win and tk.Toplevel.winfo_exists(win) and win.winfo_viewable():
                    self.saved_positions[key] = {
                        "x": win.winfo_x(), "y": win.winfo_y(),
                        "w": win.winfo_width(), "h": win.winfo_height()
                    }

        except Exception as e:
            print(f"Error saving positions: {e}")
        
        # 5. Capture Current UI State
        current_inputs = {
            "dir_dist": self.dir_dist_var.get(),
            "dir_height": self.dir_height_var.get(),
            "global_coord": self.global_coord.get(),
            "timer_input": self.timer_input.get(),
            "global_h_tp": self.global_h_tp.get(),
            "quick_slots": [
                self._safe_get_entry(e)
                for e in getattr(self, "slot_entries", [])
            ],
            "quick_slot_names": [
                self._safe_get_entry(e)
                for e in getattr(self, "slot_name_entries", [])
            ],
           
            # --- AUTO TELEPORT SETTINGS ---
            "auto_tp_delay": self.auto_tp_delay.get(),
            "auto_tp_loop": self.auto_tp_loop.get(),
            "auto_tp_loop_count": self.auto_tp_loop_count.get(),
            "auto_relog": self.auto_relog_var.get() if hasattr(self, "auto_relog_var") else False,
            "auto_relog_twice": self.auto_relog_twice_var.get() if hasattr(self, "auto_relog_twice_var") else False,
            "auto_relog_loop": self.auto_relog_loop_var.get() if hasattr(self, "auto_relog_loop_var") else False,
            "auto_interact_obj": self.auto_tp_interact_object_var.get() if hasattr(self, "auto_tp_interact_object_var") else False,
            "auto_interact_vista": self.auto_tp_interact_vista_var.get() if hasattr(self, "auto_tp_interact_vista_var") else False,
            "auto_quickness": self.auto_quickness_var.get() if hasattr(self, "auto_quickness_var") else False,
            "auto_start_mode": self.auto_tp_start_mode.get() if hasattr(self, "auto_tp_start_mode") else "start",
            
            # Check if map_canvas exists before reading
            "map_tab_scroll": (
                self.map_canvas.yview()[0] 
                if hasattr(self, "map_canvas") and self.map_canvas.winfo_exists() 
                else 0
            ),
            
            # --- VISUALS ---
            "vis_fog": self.saved_inputs.get("vis_fog", 0),
            "esp_player": self.saved_inputs.get("esp_player", 0),
            "esp_npc": self.saved_inputs.get("esp_npc", 0),
            "esp_path": self.saved_inputs.get("esp_path", 0),
            "esp_health": self.saved_inputs.get("esp_health", 0),
        }

        # 6. CRITICAL: Merge with non-widget data
        for k, v in self.saved_inputs.items():
            if k not in current_inputs:
                current_inputs[k] = v

        # 7. Update Logic State
        if self.logic:
            current_inputs["last_auto_tp_index"] = getattr(
                self.logic, "current_auto_tp_index", 0
            )

        data.save_ui_settings(
            self.transparency,
            self.always_on_top.get(),
            self.saved_positions,
            allow_resize=self.allow_resize.get(),
            open_windows=list(self.open_windows),
            inputs=current_inputs,
            expanded=self.expanded,
            macro_hotkeys=self.macro_hotkeys,
        )

    def save_log(self, key):
        """
        Opens a dialog to save the currently loaded rotation into a simple format.
        """
        # 1. Ask user where to save
        file_path, _ = QFileDialog.getSaveFileName(
            self, 
            f"Save Cleaned Macro {key}", 
            "", 
            "Text Files (*.txt);;All Files (*)"
        )
        
        if file_path:
            # 2. Ensure .txt extension
            if not file_path.endswith(".txt"):
                file_path += ".txt"
            
            # 3. Call the engine to perform the save
            # Note: Make sure you added save_rotation_to_file to gw2x_combat.py!
            success = self.combat_macro.save_rotation_to_file(key, file_path)
            
            if success:
                self.log_to_ui(f"✅ Macro {key} saved to: {os.path.basename(file_path)}")
            else:
                self.log_to_ui(f"❌ Failed to save Macro {key}. Is a log loaded?")

    def _select_group_dialog(self, title, exclude_group=None, parent=None):
        groups = list(data.CUSTOM_TP_DB["groups"].keys())
        if exclude_group and exclude_group in groups:
            groups.remove(exclude_group)

        if not groups:
            messagebox.showinfo(title, "No other groups available.")
            return None, None

        dlg = tk.Toplevel(parent or self.root)
        dlg.title(title)
        dlg.configure(bg="#121212")
        dlg.transient(parent or self.root)
        dlg.grab_set()

        tk.Label(dlg, text="Target Group", bg="#121212", fg="white").pack(padx=10, pady=(10, 5))

        var = tk.StringVar(value=groups[0])
        opt = ttk.OptionMenu(dlg, var, groups[0], *groups)
        opt.pack(fill=tk.X, padx=10)

        action = {"mode": None}

        btn_frame = tk.Frame(dlg, bg="#121212")
        btn_frame.pack(pady=10)

        def set_action(m):
            action["mode"] = m
            dlg.destroy()

        ttk.Button(btn_frame, text="Move", command=lambda: set_action("move")).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="Copy", command=lambda: set_action("copy")).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="Cancel", command=dlg.destroy).pack(side=tk.LEFT, padx=5)

        dlg.wait_window()
        return action["mode"], var.get() if action["mode"] else (None, None)

    
    def on_app_close(self):
        try:
            if self.logic and self.logic.auto_tp_running:
                self.logic.stop_auto_teleport()
        except:
            pass
        self.save_settings()
        self.root.destroy()

